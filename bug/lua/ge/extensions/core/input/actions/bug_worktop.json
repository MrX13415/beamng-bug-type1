{
// Bug mod: work mode at the engine bay (GE extension bug_worktop). The action map BugWorktop is only pushed while
// the work mode is active. The game may read this file before the mod is mounted: bug_worktop then makes it read
// the action files again (ensureInputActions). Bound in settings/inputmaps/mouse_bugWorktop.json and keyboard_bugWorktop.json.
"bugWorktopWheel" :{"cat":"gameplay", "order": 140, "ctx": "tlua", "onChange":"if bug_worktop then bug_worktop.onWheel(VALUE) end", "actionMap": "BugWorktop", "isCentered": true, "title": "ui.bug.worktop.action.wheel.title", "desc": "ui.bug.worktop.action.wheel.desc", "simplemenu":false },
"bugWorktopGrab"  :{"cat":"gameplay", "order": 140.2, "ctx": "tlua", "onChange":"if bug_worktop then bug_worktop.onGrab(VALUE) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.grab.title", "desc": "ui.bug.worktop.action.grab.desc", "simplemenu":false },
"bugWorktopOrbit" :{"cat":"gameplay", "order": 140.5, "ctx": "tlua", "onChange":"if bug_worktop then bug_worktop.onOrbitButton(VALUE) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.orbit.title", "desc": "ui.bug.worktop.action.orbit.desc", "simplemenu":false },
"bugWorktopPan"   :{"cat":"gameplay", "order": 140.6, "ctx": "tlua", "onChange":"if bug_worktop then bug_worktop.onPanButton(VALUE) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.pan.title", "desc": "ui.bug.worktop.action.pan.desc", "simplemenu":false },
"bugWorktopCamLeft" :{"cat":"gameplay", "order": 140.70, "ctx": "tlua", "onChange":"if bug_worktop then bug_worktop.onCameraKey('yawLeft', VALUE) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.camLeft.title", "desc": "ui.bug.worktop.action.camKeys.desc", "simplemenu":false },
"bugWorktopCamRight":{"cat":"gameplay", "order": 140.71, "ctx": "tlua", "onChange":"if bug_worktop then bug_worktop.onCameraKey('yawRight', VALUE) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.camRight.title", "desc": "ui.bug.worktop.action.camKeys.desc", "simplemenu":false },
"bugWorktopCamUp"   :{"cat":"gameplay", "order": 140.72, "ctx": "tlua", "onChange":"if bug_worktop then bug_worktop.onCameraKey('pitchUp', VALUE) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.camUp.title", "desc": "ui.bug.worktop.action.camKeys.desc", "simplemenu":false },
"bugWorktopCamDown" :{"cat":"gameplay", "order": 140.73, "ctx": "tlua", "onChange":"if bug_worktop then bug_worktop.onCameraKey('pitchDown', VALUE) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.camDown.title", "desc": "ui.bug.worktop.action.camKeys.desc", "simplemenu":false },
"bugWorktopCamRaise":{"cat":"gameplay", "order": 140.74, "ctx": "tlua", "onChange":"if bug_worktop then bug_worktop.onCameraKey('liftUp', VALUE) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.camRaise.title", "desc": "ui.bug.worktop.action.camKeys.desc", "simplemenu":false },
"bugWorktopCamLower":{"cat":"gameplay", "order": 140.75, "ctx": "tlua", "onChange":"if bug_worktop then bug_worktop.onCameraKey('liftDown', VALUE) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.camLower.title", "desc": "ui.bug.worktop.action.camKeys.desc", "simplemenu":false },
"bugWorktopZoomIn"  :{"cat":"gameplay", "order": 140.76, "ctx": "tlua", "onDown":"if bug_worktop then bug_worktop.onZoomKey(1) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.zoomIn.title", "desc": "ui.bug.worktop.action.camKeys.desc", "simplemenu":false },
"bugWorktopZoomOut" :{"cat":"gameplay", "order": 140.77, "ctx": "tlua", "onDown":"if bug_worktop then bug_worktop.onZoomKey(-1) end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.zoomOut.title", "desc": "ui.bug.worktop.action.camKeys.desc", "simplemenu":false },
"bugWorktopCamCenter":{"cat":"gameplay", "order": 140.78, "ctx": "tlua", "onDown":"if bug_worktop then bug_worktop.onCenterKey() end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.camCenter.title", "desc": "ui.bug.worktop.action.camKeys.desc", "simplemenu":false },
"bugWorktopExit"  :{"cat":"gameplay", "order": 141, "ctx": "tlua", "onDown":"if bug_worktop then bug_worktop.onExitKey() end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.exit.title", "desc": "ui.bug.worktop.action.exit.desc", "simplemenu":false },
"bugWorktopReload":{"cat":"gameplay", "order": 141.5, "ctx": "tlua", "onDown":"if bug_worktop then bug_worktop.onReloadKey() end", "actionMap": "BugWorktop", "title": "ui.bug.worktop.action.reload.title", "desc": "ui.bug.worktop.action.reload.desc", "simplemenu":false }

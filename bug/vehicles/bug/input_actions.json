// this file holds all the actions that only this specific vehicle can perform
// ===========================================================================
// the non self-descriptive fields are:
// "onChange":   code to run when the controller position changes     (applies to: buttons, keys, pov hat, axes)
// "onDown":     code to run when the controller becomes pressed down (applies to: buttons, keys, pov hat)
// "onUp":       code to run when the controller is lifted up         (applies to: buttons, keys, pov hat)
// "onRelative": code to run when the controller position changes     (applies to: mouse axis when holding right mouse button)
// "ctx" (defaults to 'vlua'): where the code above ^ must be run. it can be:
//    - vlua for vehicle lua async
//    - elua for engine  lua async
//    - tlua for engine  lua  sync
//    - ui for javascript    async
//    - ts for torquescript   sync
// "isBasic" (defaults to true): whether the binding must show always (true), or only when 'advanced bindings' checkbox is marked (false)
// "isCentered" (defaults to false): whether the axis values will be reported from -1 to +1 (true) or from 0 to +1 (false)
// "order":      helps set the display order in the Controls menu
{
    // radio
    "radio":               {"order": 1, "onUp":"radio.toggle()", "title":"Radio On/Off", "desc":"Toggles the radio on or off."},
    "radioinfo":           {"order": 2, "onUp":"radio.info()", "title":"Display Radio Station", "desc":"Displays the currently tuned radio station."},
    "radiotunedown":       {"order": 3, "onChange":"radio.tuneDown(VALUE)", "title":"Decrease Radio Frequency", "desc":"Decreases the radio frequency"},
    "radiotuneup":         {"order": 4, "onChange":"radio.tuneUp(VALUE)", "title":"Increase Radio Frequency", "desc":"Increases the radio frequency"},
    "radiotuneprev":       {"order": 5, "onUp":"radio.tuneDown()", "title":"Previous Radio Station", "desc":"Tunes to the previous radio station"},
    "radiotunenext":       {"order": 6, "onUp":"radio.tuneUp()", "title":"Next Radio Station", "desc":"Tunes to the next radio station"},
    "radiovolumedown":     {"order": 7, "onChange":"radio.volumeDown(VALUE)", "title":"Decrease Radio Volume", "desc":"Decrease the radio volume"},
    "radiovolumeup":       {"order": 8, "onChange":"radio.volumeUp(VALUE)", "title":"Increase Radio Volume", "desc":"Increases the radio volume"},
    "radiotrackprev":      {"order": 9, "onUp":"radio.prevTrack()", "title":"Previous Radio Track", "desc":"Skips to the previous track on the current station."},
    "radiotracknext":      {"order":10, "onUp":"radio.nextTrack()", "title":"Next Radio Track", "desc":"Skips to the next track on the current station."},

    // interior
    "wiperstoggle":        {"order":21, "onUp":"vehicle.toggleWipers()", "title":"Toggle Wiper Speed", "desc":"Toggles between the speed of the windshield wipers or switches them off."},
    "wipersdown":          {"order":22, "onUp":"vehicle.wipersDown()", "title":"Decrease Wiper Speed", "desc":"Decreases the speed of the windshield wipers or turns them off."},
    "wipersup":            {"order":23, "onUp":"vehicle.wipersUp()", "title":"Increase Wiper Speed", "desc":"Increase the speed of the windshield wipers or switches them on."},

    // sunvisor
    "sunvisorLtoggle":     {"order":24, "onUp":"vehicle.toggle('sunvisorL')", "title":"Left Sunvisor", "desc":"Lowers the left sunvisor."},
    "sunvisorRtoggle":     {"order":25, "onUp":"vehicle.toggle('sunvisorR')", "title":"Right Sunvisor", "desc":"Lowers the right sunvisor."},
    "interiorlighttoggle": {"order":26, "onUp":"vehicle.toggleInteriorLight()", "title":"Interior Light", "desc":"Toggles the interior light between always on and open door only."},   

    // windows
    "windowFLopen":        {"order":31, "onChange":"controller.getControllerSafe('windowFL').open(VALUE)", "title":"Window Left Open", "desc":"Opens the front left window."},
    "windowFLclose":       {"order":32, "onChange":"controller.getControllerSafe('windowFL').close(VALUE)", "title":"Window Left Close", "desc":"Closes the front left window."},
    "windowFRopen":        {"order":33, "onChange":"controller.getControllerSafe('windowFR').open(VALUE)", "title":"Window Right Open", "desc":"Opens the front right window."},
    "windowFRclose":       {"order":34, "onChange":"controller.getControllerSafe('windowFR').close(VALUE)", "title":"Window Right Close", "desc":"Closes the front right window."},

    // ragtop
    "ragtopopen":          {"order":35, "onChange":"controller.getControllerSafe('ragtop').open(VALUE)", "title":"Racktop Open", "desc":"Opens the racktop."},
    "ragtopclose":         {"order":36, "onChange":"controller.getControllerSafe('ragtop').close(VALUE)", "title":"Racktop Close", "desc":"Closes the racktop."},

    // herbie
    "herbiereset":         {"order": 51, "onUp":"herbie.resetTrust()", "title":"Herbie trust reset", "desc":"Resets Herbie's trust in the player to the default value."},
    "herbiehappy":         {"order": 52, "onUp":"herbie.setHappy()", "title":"Herbie trust maximum", "desc":"Sets Herbie's trust in the player to the max value."},
    "herbiewheelie":       {"order": 53, "onChange":"herbie.wheelie(VALUE)", "title": "Wheelie", "desc": "Herbie performs a wheelie. (Hold to continue the wheelie.)" },

    // waterthrust (No longer needed; WIP)
   // "tfoward":  {"order": 25, "ctx":"vlua", "isBasic":true, "isCentered":false, "onChange":"electrics.values.tforward = VALUE", "title":"Swim Forward", "desc":"Swim Forward"},
   // "treverse": {"order": 26, "ctx":"vlua", "isBasic":true, "isCentered":false, "onChange":"electrics.values.treverse = VALUE", "title":"Swim Backwards", "desc":"Swim Backwards"},
   // "tleft":    {"order": 27, "ctx":"vlua", "isBasic":true, "isCentered":false, "onChange":"electrics.values.tleft = VALUE", "title":"Swim Left", "desc":"Swim Left"},
   // "tright":   {"order": 28, "ctx":"vlua", "isBasic":true, "isCentered":false, "onChange":"electrics.values.tright = VALUE", "title":"Swim Right", "desc":"Swim Right"},

   // Misc:
   "doorLtoggle":          {"order":71, "onUp":"controller.getControllerSafe('doorLCoupler').toggleGroup()", "title":"Left Door", "desc":"Opens the left door."},
   "doorRtoggle":          {"order":72, "onUp":"controller.getControllerSafe('doorRCoupler').toggleGroup()", "title":"Right Door", "desc":"Opens the right door."},
   "hoodtoggle":           {"order":73, "onUp":"controller.getControllerSafe('hoodCatchCoupler').toggleGroup(); controller.getControllerSafe('hoodLatchCoupler').toggleGroup()", "title":"Hood", "desc":"Opens the hood."},
   "trunktoggle":          {"order":74, "onUp":"controller.getControllerSafe('trunkCoupler').toggleGroup()", "title":"Trunk", "desc":"Opens the trunk."},

   "ashtraytoggle":        {"order":76, "onUp":"vehicle.toggleAshTray()", "title":"Ashtray", "desc":"Opens the ashtray."},
   "gloveboxtoggle":       {"order":77, "onUp":"controller.getControllerSafe('gloveboxCoupler').toggleGroup()", "title":"Glovebox", "desc":"Opens the glovebox."}
}

        "setRearDiffModeAxis": {"order": 50.4, "onChange":"controller.getControllerSafe('rearLockControl').setDriveMode(VALUE > 0.5 and 'locked' or 'unlocked')",       "title": "vehicle.interaction.powertrain.rearDiff.set.title",          "desc": "vehicle.interaction.powertrain.rearDiff.set.desc" },
        

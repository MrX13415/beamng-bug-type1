        // Diff Lock:
        "toggleRearDiff":      {"order": 50.1, "onDown":  "controller.getControllerSafe('rearLockControl').nextDriveMode()",                                            "title": "vehicle.interaction.powertrain.rearDiff.toggle.title",       "desc": "vehicle.interaction.powertrain.rearDiff.toggle.desc" },

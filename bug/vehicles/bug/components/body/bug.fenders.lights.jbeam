// animated headlights
"bug_headlight_lid_L_animated": {
    "information":{
        "authors":"BeamNG",
        "name":"Headlight Lid (Animated)",
        "value":30,
    },
    "slotType" : "bug_headlight_addition_L",
    "actionsEnabled": [
        ["id"],
        ["hrb_lid_L_up"],
        ["hrb_lid_L_down"],
    ],
    "controller": [
        ["fileName"],
        ["bug/eyelids", {"name": "lidAnimator", "lidAnimationSpeed": 5.0}]
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],

		// Animated lid - uses headlight nodes for proper positioning
        // idRef: pivot point, idX: defines X axis direction, idY: defines Y axis direction
        // The lid rotates around X axis (left-right axis of the headlight)
        ["lid_L_animated", "bug_headlight_L_lid_animated", "he1l", "he2l", "he4l",
            {"x":195, "y":0, "z":0},   // baseRotation
            {"x":70, "y":0, "z":0},   // rotation
            {"x":0, "y":0, "z":0},     // translation
            0, 1, 0, 1],               // min, max, offset, multiplier

        {
            "lightInnerAngle":0,
            "lightOuterAngle":80,
            "lightColor":{"r":255, "g":193, "b":141, "a":255},  // 3000K
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":true,
            "flareName":"vehicleHeadLightFlare",
            "cookieName":"art/special/BNG_light_cookie_headlight.png",
            "texSize":512,
            "shadowSoftness":0.5,
        },
	]
},
"bug_headlight_lid_R_animated": {
    "information":{
        "authors":"BeamNG",
        "name":"Headlight Lid (Animated)",
        "value":30,
    },
    "slotType" : "bug_headlight_addition_R",

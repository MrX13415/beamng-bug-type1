    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],

		// Animated lid - uses headlight nodes for proper positioning
        ["lid_R_animated", "bug_headlight_R_lid_animated", "he1r", "he2r", "he4r",
            {"x":20, "y":-180, "z":0}, // baseRotation
            {"x":70, "y":0, "z":0},     // rotation
            {"x":0, "y":0, "z":0},      // translation
            0, 1, 0, 1],                // min, max, offset, multiplier

        {
            "lightInnerAngle":0,
            "lightOuterAngle":80,
            "lightColor":{"r":255, "g":193, "b":141, "a":255},  // 3000K
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":true,
            "flareName":"vehicleHeadLightFlare",
            "cookieName":"art/special/BNG_light_cookie_headlight.dds",
            "texSize":512,
            "shadowSoftness":0.5,
        },
    ]
},


// indicators (front)
"bug_indicator_FR": {
    "information":{
        "authors":"BeamNG",
        "name":"EU Right Signal",
        "value":90,
    },
    "electricPower":[
        ["power"],
        [18, {"trigger": "electrics.values.signal_R"}],
    ],
    "slotType" : "bug_indicator_FR",
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],
        ["bug_turnsignal_FR_bulb", ["incandescent_amber_21W"], [], "incandescent_amber_21W", "Front Right Turn Signal",
        {
        "coreSlot":true,
        "variables":{
          "$electric":"power__signal_FR",
          "$nodeRef":"feFR4l", "$nodeX":"feFR4m", "$nodeY":"feFR5l",
          "$deformGroup":"indicator_FR_break",
          "$posX":-0.5, "$posY":-1.428, "$posZ":0.80,
          "$rotX":0, "$rotY":0, "$rotZ":180,
          //"$flareScale":0.02
        }
        }]
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["bug_signal_FR_frame", ["bug_fender_FR"]],
        {"deformGroup":"indicator_FR_break", "deformMaterialBase":"bug_signal_glass_FR", "deformMaterialDamaged":"bug_lights_glass_dmg"},
        {"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound1", "deformVolume":0.2},
        ["bug_signal_FR_case", ["bug_fender_FR"]],
        ["bug_signal_FR_glass", ["bug_fender_FR"]],
        {"deformGroup":""}
    ],
    "glowMap":{
        "bug_signal_FR":       {"simpleFunction":{"power__signal_FR":0.49},  "off":"bug_lights", "on":"bug_lights_on", "on_intense":"bug_lights_on_intense", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_signal_glass_FR": {"simpleFunction":{"power__signal_FR":0.49},  "off":"bug_lights_glass", "on":"bug_lights_glass_on", "on_intense":"bug_lights_glass_on_intense", "materialEmissiveScaling":{"on_max":1.0}},
    },
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        //--SIGNAL--
        {"selfCollision":false},
        {"collision":true},
        {"nodeMaterial":"|NM_GLASS"},
        {"frictionCoef":0.5},
        {"nodeWeight":0.5},
        ["ic1r", -0.5, -1.44313, 0.82234],
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //--SIGNAL--
        {"beamSpring":501000,"beamDamp":20},
        {"beamDeform":1000,"beamStrength":"FLT_MAX"},
        {"deformGroup":"indicator_FR_break", "deformationTriggerRatio":0.01},
        ["ic1r","feFR4m", {"breakGroup": "indicator_FR"}],
        ["ic1r","feFR4l"],
        ["ic1r","feFR5m"],
        ["ic1r","feFR5l"],
        {"deformGroup":""},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},

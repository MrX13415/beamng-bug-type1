// inidactors (front)
"bug_indicator_FR": {
    "information":{
        "authors":"BeamNG",
        "name":"EU Right Indicator",
        "value":90,
    },
    "slotType" : "bug_indicator_FR",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["signal_FR_frame", ["bug_fender_FR"]],
        {"deformGroup":"indicator_FR_break", "deformMaterialBase":"bug_signal_glass_FR", "deformMaterialDamaged":"bug_lights_glass_dmg"},
        {"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound1", "deformVolume":0.2},
        ["signal_FR_case", ["bug_fender_FR"]],
        ["signal_FR_glass", ["bug_fender_FR"]],
        {"deformGroup":""}
    ],
    "glowMap":{
        "bug_signal_FR":       {"simpleFunction":{"signal_R":0.49},  "off":"bug_lights", "on":"bug_lights_on", "on_intense":"bug_lights_on_intense"},
        "bug_signal_glass_FR": {"simpleFunction":{"signal_R":0.49},  "off":"bug_lights_glass", "on":"bug_lights_glass_on", "on_intense":"bug_lights_glass_on_intense"},
    },
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],

        //fender signals
        {
        "lightInnerAngle":80,
        "lightOuterAngle":170,
        "lightBrightness":0.3,
        "lightRange":2,
        "lightColor":{"r":255, "g":113, "b":0, "a":255},
        "lightAttenuation":{"x":0, "y":1, "z":1},
        "lightCastShadows":false,
        "flareName":"vehicleBrakeLightFlare",
        "cookieName":"",
        "texSize":512,
        "flareScale":0.1,
        "shadowSoftness":0.5,
        },
        ["signal_R" ,   "SPOTLIGHT"   , "feFR4l", "feFR4m", "feFR5l", {"x":-90, "y":0, "z":180} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.35, "y":0.05, "z":0.05},"deformGroup":"indicator_FR_break"}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        //--SIGNAL--
        {"selfCollision":false},
        {"collision":true},
        {"nodeMaterial":"|NM_GLASS"},
        {"frictionCoef":0.5},
        {"nodeWeight":0.5},
        ["ic1r", -0.5, -1.44313, 0.82234],
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //--SIGNAL--
        {"beamSpring":501000,"beamDamp":20},
        {"beamDeform":1000,"beamStrength":"FLT_MAX"},
        {"deformGroup":"indicator_FR_break", "deformationTriggerRatio":0.01},
        ["ic1r","feFR4m", {"breakGroup": "indicator_FR"}],
        ["ic1r","feFR4l"],
        ["ic1r","feFR5m"],
        ["ic1r","feFR5l"],
        {"deformGroup":""},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},

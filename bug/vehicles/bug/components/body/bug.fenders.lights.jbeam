{

// headlights
"bug_headlight_L": {
    "information":{
        "authors":"BeamNG",
        "name":"Left Headlight",
        "value":90,
    },
    "electricPower":[
        ["power"],
        [55, {"trigger": "electrics.values.lowbeam"}],
        [60, {"trigger": "electrics.values.highbeam"}]
    ],
    "slotType" : "bug_headlight_L",
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],

        ["bug_headlight_addition_L", ["bug_headlight_addition_L"], [], "", "Headlight Addition"],

        ["bug_headlight_L_low_bulb", ["headlightBulb_halogen_55W_combined"], [], "headlightBulb_halogen_55W_combined", "Low Beam",
        {
        "coreSlot":true,
        "variables":{
          "$electric": "power__lowbeam",
          "$lightPattern": "LHD",
          "$nodeRef":"he1l", "$nodeX":"he2l", "$nodeY":"he4l",
          "$deformGroup":"headlightglass_L_break",
          "$posX":0.5, "$posY":-1.598, "$posZ":0.62
          "$rotX":-0.57, "$rotY":0, "$rotZ":180,
        }
        }],
        ["bug_headlight_L_high_bulb", ["headlightBulb_halogen_60W_combined"], [], "headlightBulb_halogen_60W_combined", "High Beam",
        {
        "coreSlot":true,
        "variables":{
          "$electric": "power__highbeam",
          "$lightPattern": "LHD",
          "$nodeRef":"he1l", "$nodeX":"he2l", "$nodeY":"he4l",
          "$deformGroup":"headlightglass_L_break",
          "$posX":0.5, "$posY":-1.598, "$posZ":0.62,
          "$rotX":0, "$rotY":0, "$rotZ":180
        }
        }]
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["bug_headlight_L_frame",  ["bug_headlight_L"]],
        {"deformGroup":"headlightglass_L_break", "deformMaterialBase":"bug_headlight_glass", "deformMaterialDamaged":"bug_lights_glass_dmg"},
        {"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound2", "deformVolume":0.2},
        ["bug_headlight_L_glass", ["bug_headlight_L"]],
        ["bug_headlight_L_glass_cover", ["bug_headlight_L"]],
        {"deformMaterialBase":"bug_headlight", "deformMaterialDamaged":"bug_lights"},
        ["bug_headlight_L_socket", ["bug_headlight_L"]],
        {"deformGroup":""},
    ],
    "glowMap":{
        "bug_headlight":       {"simpleFunction":{"power__lowbeam":0.49, "power__highbeam":1}, "off":"bug_lights", "on":"bug_lights_on", "on_intense":"bug_lights_on_intense", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_headlight_glass": {"simpleFunction":{"power__lowbeam":0.49, "power__highbeam":1}, "off":"bug_lights_glass", "on":"bug_lights_glass_on", "on_intense":"bug_lights_glass_on_intense", "materialEmissiveScaling":{"on_max":1.0}},
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--HEADLIGHT--
         //left
         {"selfCollision":false},
         {"collision":true},
         {"nodeMaterial":"|NM_GLASS"},
         {"frictionCoef":0.5},
         {"nodeWeight":0.4},
         {"group":"bug_headlight_L"},
         ["he1l", 0.39163, -1.64313, 0.73234],
         ["he2l", 0.60441, -1.64286, 0.73293],
         ["he3l", 0.60520, -1.73918, 0.52636],
         ["he4l", 0.39240, -1.73928, 0.52615],
         ["he5l", 0.49841, -1.50824, 0.54417],
         {"group":""}
    ],
    "beams": [
          ["id1:", "id2:"],

          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          //--HEADLIGHT--
          {"beamSpring":201000,"beamDamp":20},
          {"beamDeform":15000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"headlightglass_L_break", "deformationTriggerRatio":0.01},
          //headlight main shape
          ["he1l","he2l"],
          ["he2l","he3l"],
          ["he3l","he4l"],
          ["he4l","he1l"],
          ["he1l","he5l"],
          ["he2l","he5l"],
          ["he3l","he5l"],
          ["he4l","he5l"],
          {"beamDeform":1000},
          ["he1l","he3l", {"breakGroup": "headlight_L"}],
          ["he2l","he4l"],
          {"deformGroup":""},
          {"beamDeform":8000, "beamStrength":25000},
          {"breakGroup": "headlight_L"},
          ["he1l","feFL3r"],
          ["he1l","feFL3m"],
          ["he1l","feFL4l"],
          ["he1l","feFL4m"],
          ["he2l","feFL3m"],
          ["he2l","feFL2m"],
          ["he2l","feFL3l"],
          ["he2l","feFL2l"],
          ["he3l","feFL2m"],
          ["he3l","feFL2r"],
          ["he3l","feFL7m"],
          ["he3l","feFL7r"],
          ["he4l","feFL2r"],
          ["he4l","feFL3r"],
          ["he4l","feFL1r"],
          ["he4l","feFL4r"],
          ["he5l","feFL8"],
          {"breakGroup": ""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},

    ],
    "triangles": [
          ["id1:","id2:","id3:"],

          {"groundModel":"metal"},
          {"dragCoef":1},
          {"triangleType":"NONCOLLIDABLE"},
          ["he4l", "he2l", "he1l"],
          ["he4l", "he3l", "he2l"],
          {"triangleType":"NORMALTYPE"},
    ],
},

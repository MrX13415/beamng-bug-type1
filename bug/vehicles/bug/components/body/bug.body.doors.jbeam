        ["d3r",  -0.700539,  0.294437, 0.328229],
        ["d4r",  -0.648047, -0.605883, 0.603074],
        ["d5r",  -0.678370, -0.26389,  0.60235, {"nodeWeight":1.5, "selfCollision":false}],
        ["d6r",  -0.722429,  0.294437, 0.60157],
        ["d8r",  -0.652307, -0.24872,  0.94392, {"nodeWeight":0.8, "selfCollision":false}],
        ["d9r",  -0.691250,  0.294437, 0.95028, {"nodeWeight":0.8}],
        ["d10r", -0.568596, -0.405212, 1.24026],
        ["d11r", -0.566714, -0.243084, 1.32514],
        ["d12r", -0.595103,  0.304437, 1.34054],
        ["d13r", -0.650399,  0.294437, 1.1518],
        {"selfCollision":false},
        {"collision":false},
        {"nodeWeight":1.5},
        // hinge
        ["dh1r", -0.642601, -0.616547, 0.92798], 
        ["dh2r", -0.642799, -0.613628, 0.328229],
        //rigidifier
        ["d14r", -0.39500, -0.17000, 0.95000, {"nodeWeight":1.0}],
        {"group":""},
        {"nodeWeight":0.6},
        // vent window hinge
        ["dvh1r", -0.557100, -0.377531, 1.20948],
        ["dvh2r", -0.581476, -0.416249, 1.00879],
        ["d15r",  -0.500000, -0.00000, 1.00000, {"nodeWeight":0.9}],
        {"selfCollision":true},
        {"collision":true},
        {"group":""},

        //latch node
        {"nodeWeight":1.4},
        ["d14rr", -0.55, 0.29, 0.8, {"couplerTag":"doorLatch_R","couplerLock":true,"couplerStrength":35000,"couplerRadius":1.35,"couplerStartRadius":0.1,"couplerLockRadius":0.001,"couplerLatchSpeed":0.8, "breakGroup":"doorLatch_R"}],
    ],
    "beams": [
        ["id1:","id2:"],

        {"disableMeshBreaking":true},
        {"beamPrecompression":1, "beamType":"|NORMAL","beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":501000,"beamDamp":110},
        {"beamDeform":3000,"beamStrength":"FLT_MAX"},
        //front door main shape
        ["dh2r","d2r"],
        ["d2r","d3r"],
        ["d4r","d5r"],
        ["d5r","d6r"],
        ["dh1r","d8r"],

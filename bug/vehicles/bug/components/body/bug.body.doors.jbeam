        //["mi2r", "bc3r"],
        //["mi2r", "bc4r"],
        //["mi2r", "bf5r"],
        //["mi3r", "bc3r"],
        //["mi3r", "bc4r"],
        //["mi3r", "bf5r"],

        //["mi4r", "bc3r"],
        //["mi4r", "bc4r"],
        //["mi4r", "bf5r"],
        //["mi4r", "bf8"],

        ////dampers
        //{"beamSpring":0,"beamDamp":250},
        //["mi1r", "bc3r"],
        //["mi1r", "bf5r"],
        //["mi2r", "bc3r"],
        //["mi2r", "bf5r"],

        //{"breakGroup":""},
        //{"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //{"deformLimitExpansion":1.2},
        //],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false}, // contact with the door is handled by the contact beam below, not by node-triangle collision
        {"collision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},

        //mirror head
        {"nodeWeight":0.25},
        {"group":"door_mirror_R"},
        ["mi1r", -0.7535, -0.5093, 1.0732],  // y = L + 0.069772
        ["mi2r", -0.7531, -0.5001, 1.0000],
        ["mi3r", -0.6565, -0.5318, 1.0360],
        //swivel axis: vertical through the mount on top of the upper door hinge (body-fixed)
        ["mp1r", -0.6450, -0.6160, 0.9400, {"nodeWeight":0.3}],
        ["mp2r", -0.6450, -0.6160, 0.8000, {"nodeWeight":0.3}],
        {"group":""},

        //door contact point (rides with the door, pushes the mirror head once the door reaches it)
        {"collision":false},
        ["mdcr", -0.5585, -0.4802, 0.9999, {"nodeWeight":0.2}],
    ],
    "beams": [
        ["id1:", "id2:"],
        {"disableMeshBreaking":false},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

        //mirror head (rigid)
        {"beamSpring":201000,"beamDamp":30},
        {"beamDeform":12000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":1.1},
        ["mi1r", "mi2r"],
        ["mi2r", "mi3r"],
        ["mi3r", "mi1r"],
        {"deformLimitExpansion":""},

        //swivel: every head node is tied to both axis nodes, so the head can only rotate about the vertical mount axis
        {"beamSpring":201000,"beamDamp":30},
        {"beamDeform":12000,"beamStrength":8000},
        {"breakGroup":"mirror_R"},
        ["mi1r", "mp1r"],
        ["mi2r", "mp1r"],
        ["mi3r", "mp1r"],
        ["mi1r", "mp2r"],
        ["mi2r", "mp2r"],
        ["mi3r", "mp2r"],

        //mount: axis nodes fixed to the body (A-pillar / cowl), so the foot never moves
        {"beamSpring":501000,"beamDamp":40},
        {"beamDeform":20000,"beamStrength":8000},
        ["mp1r", "bc3r"],
        ["mp1r", "bc4r"],
        ["mp1r", "bf5r"],
        ["mp1r", "bf8"],
        ["mp2r", "bc3r"],
        ["mp2r", "bc4r"],
        ["mp2r", "bf5r"],
        ["mp2r", "bf8"],
        ["mp1r", "mp2r"],

        //swivel friction: holds the head in place, yields (plastically) when pushed, so the mirror stays where it was turned to
        {"beamSpring":101000,"beamDamp":30},
        {"beamDeform":300,"beamStrength":"FLT_MAX"},
        ["mi1r", "bc3r"],
        ["mi1r", "bf5r"],
        ["mi2r", "bc3r"],
        ["mi2r", "bf5r"],

        //dampers
        {"beamSpring":0,"beamDamp":250},
        ["mi1r", "bc3r"],
        ["mi1r", "bf5r"],
        ["mi2r", "bc3r"],
        ["mi2r", "bf5r"],
        {"breakGroup":""},

        //contact point attached rigidly to the door
        {"beamSpring":501000,"beamDamp":40},
        {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
        ["mdcr", "dh1r"],
        ["mdcr", "d4r"],
        ["mdcr", "d8r"],
        ["mdcr", "d10r"],

        //door -> mirror contact: compression-only beam, 4 cm long once the door mesh reaches the mirror head
        {"beamType":"|SUPPORT", "beamLongBound":100},
        {"beamPrecompression":0.2045},
        {"beamSpring":150000,"beamDamp":60},
        ["mdcr", "mi2r"],

        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"deformLimitExpansion":1.2},
    ],
    "triangles": [
        ["id1:","id2:","id3:"],

        //mirror
        {"group":"door_mirror_R"},
        ["mi1r",  "mi2r", "mi3r"],
        {"group":""},
        {"dragCoef":4},
    ],
},

}

        ["d6l",  0.722429,  0.294437, 0.60157],
        ["d8l",  0.652307, -0.24872,  0.94392, {"nodeWeight":0.8, "selfCollision":false}],
        ["d9l",  0.691250,  0.294437, 0.95028, {"nodeWeight":0.8}],
        ["d10l", 0.568596, -0.405212, 1.24026],
        ["d11l", 0.566714, -0.243084, 1.32514],
        ["d12l", 0.595103,  0.304437, 1.34054],
        ["d13l", 0.650399,  0.294437, 1.1518],
        {"selfCollision":false},
        {"collision":false},
        {"nodeWeight":1.5},
        // hinge
        ["dh1l",  0.642601, -0.616547, 0.92798],
        ["dh2l",  0.642799, -0.613628, 0.328229],
        //rigidifier
        ["d14l", 0.39500, -0.19000, 0.95000, {"nodeWeight":1.0}],
        {"group":""},
        {"nodeWeight":0.6},
        // vent window hinge
        ["dvh1l", 0.557100, -0.377531, 1.20948],
        ["dvh2l", 0.581476, -0.416249, 1.00879],
        ["d15l",  0.500000, -0.00000, 1.00000, {"nodeWeight":0.9}],
        {"selfCollision":true},
        {"collision":true},

        //latch node
        {"nodeWeight":1.4},
        ["d14ll", 0.55, 0.29, 0.8, {"couplerTag":"doorLatch_L","couplerLock":true,"couplerStrength":35000,"couplerRadius":1.35,"couplerStartRadius":0.1,"couplerLockRadius":0.001,"couplerLatchSpeed":0.8, "breakGroup":"doorLatch_L"}],
    ],
    "beams": [
        ["id1:","id2:"],

        {"disableMeshBreaking":true},
        {"beamPrecompression":1, "beamType":"|NORMAL","beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":501000,"beamDamp":110},
        {"beamDeform":3000,"beamStrength":"FLT_MAX"},
        //front door main shape
        ["dh2l","d2l"],
        ["d2l","d3l"],
        ["d4l","d5l"],
        ["d5l","d6l"],
        ["dh1l","d8l"],
        ["dh1l","d10l"],
        ["d10l","d11l"],
        {"deformGroup":"doorglass_FL_break","deformationTriggerRatio":0.01},
        ["d8l","d9l"],
        ["d13l","d9l"],
        ["d11l","d12l"],
        ["d12l","d13l"],
        {"deformGroup":""},
        ["dh2l","d4l"],
        ["d2l","d5l"],
        ["d3l","d6l"],
        ["d4l","dh1l"],
        ["d5l","d8l"],
        ["d6l","d9l"],
        //surficial crossing
        ["dh2l","d5l"],
        ["d2l","d4l"],
        ["d2l","d6l"],
        ["d3l","d5l"],
        ["d4l","d8l"],
        ["d5l","dh1l"],
        ["d5l","d9l"],
        ["d6l","d8l"],
        //corner rigids
        ["d12l","d10l"],
        ["d13l","d6l"],
        ["d12l","d3l"],
        ["d5l","d13l"],
        ["d4l","d10l"],
        ["dh1l","d9l"],
        ["d2l","d8l"],
        ["d3l","d9l"],
        ["dh1l","d3l"],
        ["dh2l","d9l"],
        ["dh2l","dh1l"],
        //lengthwise
        ["d4l","d6l"],
        ["dh2l","d3l"],
        ["dh1l","d6l"],
        ["d4l","d9l"],
        ["dh2l","d6l"],
        ["d4l","d3l"],
        //window frame
        ["d12l","d9l"],
        ["d11l","d5l"],
        ["d10l","d5l"],

        //vent window hinge
        ["dvh1l","dvh2l"],
        ["dvh1l","d11l"],
        ["dvh1l","d10l"],
        ["dvh1l","d8l"],
        ["dvh2l","d4l"],
        ["dvh2l","d8l"],
        ["dvh2l","d11l"],
        ["dvh1l","d14l"],
        ["dvh2l","d14l"],
        // vent hinge anchor
        ["d5l","d15l"],
        ["d6l","d15l"],
        ["d8l","d15l"],
        ["d9l","d15l"],
        ["d11l","d15l"],
        ["d12l","d15l"],
        ["dvh1l","d15l"],
        ["dvh2l","d15l"],

        //rigidify
        ["dh1l","d14l"],
        ["dh2l","d14l"],
        ["d2l","d14l"],
        ["d3l","d14l"],
        ["d4l","d14l"],
        ["d5l","d14l"],
        ["d6l","d14l"],
        ["d8l","d14l"],
        ["d9l","d14l"],
        ["d8l","d10l"],
        ["d10l","d14l"],
        ["d11l","dh1l"],
        {"deformGroup":"doorglass_FL_break","deformationTriggerRatio":0.01},
        ["d2l","d12l"],
        ["d3l","d11l"],
        ["d8l","d13l"],
        ["d13l","d11l"],
        ["d13l","d14l"],
        ["d11l","d14l"],
        ["d12l","d14l"],
        {"deformGroup":""},

        //latch node
        {"beamDeform":2500,"beamStrength":"FLT_MAX"},
        ["d9l","d14ll",{"deformLimitExpansion":0.01}],
        ["d8l","d14ll"],
        ["d6l","d14ll",{"deformLimitExpansion":0.01}],
        ["d5l","d14ll"],
        ["d12l","d14ll"],
        ["d13l","d14ll"],
        {"disableMeshBreaking":false},

        //light hinge friction (keeps a rebound from swinging the door shut)
        {"beamDeform":77280,"beamStrength":448560},
        //{"beamSpring":0,"beamDamp":42.77}, // old: strong damping, slow second opening phase
        {"beamSpring":0,"beamDamp":8},
        {"breakGroup":"door_FL_hinge_b"},
        ["d3l","f5ml"],
        {"breakGroup":"door_FL_hinge_a"},
        ["d9l","f5ml"],
        {"breakGroup":""},

        // support beams
        {"beamType":"|SUPPORT","beamLongBound":5},
        {"beamSpring":501000,"beamDamp":10},
        {"beamDeform":5000,"beamStrength":200000},
        {"disableTriangleBreaking":true},
        {"beamPrecompression":1},
        ["dh2l","bq2l"],
        //-
        ["d2l","bq2l", {"beamLongBound":13}],
        //-
        ["d9l","brf4lll"],
        //["d12l","bq9l"],
        ["d13l","brf4lll"],
        //["d13l","bq9l", {"beamLongBound":6}], // old: shortens by up to 1.9 mm while the door opens (0-3.1 deg) -> pushed the leaned door shut, then shoved it open
        ["d13l","bq9l", {"beamLongBound":6, "beamPrecompression":0.985}], // rest just below the shortest length while opening: only acts when the door is pushed in
        //-
        //["d9l","bq5l"], // old: shortens by 0.34 mm while the door opens (0-1.8 deg)
        ["d9l","bq5l", {"beamPrecompression":0.998}],
        ["d6l","bq9l"],
        ["d6l","bq3l"],
        //["d3l","bq5l"], // old: shortens by 0.04 mm while the door opens (0-0.6 deg)
        ["d3l","bq5l", {"beamPrecompression":0.9995}],
        ["d3l","bq3l", {"beamLongBound":17}],

        // hinge limiter = check strap: stop at ~83°, so the door just clears the default (teardrop) mirror at ~84°.
        // The stop load is split over two rear-edge nodes (d9 top, d6 middle) so a hard swing doesn't dent the door (damage indicator).
        //{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":16.0, "beamShortBound":1.0}, // old: stop at ~68°
        //{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":19.3, "beamShortBound":1.0}, // old: stop at ~85°, door hit the teardrop mirror
        //{"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":18.49, "beamShortBound":1.0}, // old: was meant as 83°, actually ~81°
        {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":18.89, "beamShortBound":1.0},
        {"beamSpring":0,"beamDamp":0,"beamDeform":136500,"beamStrength":12000},
        //{"beamLimitSpring":1401000,"beamLimitDamp":200}, // old: damped stop, no bounce
        //{"beamLimitSpring":1401000,"beamLimitDamp":25}, // old: rigid stop, bounced too much
        //{"beamLimitSpring":150000,"beamLimitDamp":800}, // old: rebound strong enough to swing the door shut
        //{"beamLimitSpring":150000,"beamLimitDamp":2000}, // old: door could be forced well past the stop too easily
        //{"beamLimitSpring":600000,"beamLimitDamp":2000}, // old: all of the stop load on d9, hard swings dented the door
        {"beamLimitSpring":150000,"beamLimitDamp":250}, // per beam (x2 beams = 300000 / 500)
        {"breakGroupType":0},
        {"breakGroup":"door_FL_latch"},
        //["d9l", "bq9l"], // old: default boundZone = 1 m, so the stop's spring/damping faded in over a whole meter and barely acted
        //["d9l", "bq9l", {"boundZone":0.01}], // old
        //["d9l", "bq9l", {"boundZone":0.02}], // old
        ["d9l", "bq9l", {"boundZone":0.05}],
        ["d6l", "bq5l", {"beamLongBound":19.35, "boundZone":0.05}], // same stop angle on the middle of the rear edge

        // check strap brake: from ~77° the strap drags (damping only, ramps in up to the stop at ~83°), like the door brushing the mirror
        //{"beamType":"|BOUNDED", "beamLongBound":17.3, "beamShortBound":1.0}, // old: was meant as 77°, actually ~75°
        {"beamType":"|BOUNDED", "beamLongBound":17.71, "beamShortBound":1.0},
        {"beamSpring":0,"beamDamp":0},
        {"beamLimitSpring":0,"beamLimitDamp":90},
        ["d9l", "bq9l", {"boundZone":0.074}],
        {"beamLimitSpring":1,"beamLimitDamp":1},

        //pop open
        {"breakGroupType":1},
        //{"beamType":"|SUPPORT", "beamLongBound":5}, // old: stiff 2 mm pop spring + seal drag zone (replaced by the door seal below)
        //{"beamSpring":55000,"beamDamp":320},
        {"beamDeform":40000,"beamStrength":10000},
        //{"beamPrecompression":1.04}, // old: strong pop-open kick
        //{"beamPrecompression":1.025}, // old: with the latch push it popped the door far open
        //{"beamPrecompression":1.02}, // old
        //["q14l", "d9l", {"breakGroup":"door_FL_hinge_a"}],
        // old: seal as a jbeam beam. Its contact point never matched the Lua air model exactly, so the door crept and then
        // jumped further open when the air gap opened. The seal now lives in lua/lib/cabinair.lua (same opening measure as the air model).
        //{"beamType":"|BOUNDED", "beamLongBound":100, "beamShortBound":0},
        //{"beamPrecompression":1.18},
        //{"beamSpring":0,"beamDamp":0},
        //{"beamLimitSpring":1300,"beamLimitDamp":22,"beamLimitDampRebound":324},
        //["q14l", "d9l", {"boundZone":0.003, "breakGroup":"door_FL_hinge_a"}],
        //{"beamLimitSpring":1,"beamLimitDamp":1,"beamLimitDampRebound":1},
        {"beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamPrecompression":1},
        {"breakGroupType":0},
        {"breakGroup":""},

        //gas strut (disabled: the Bug has none; its spring stored ~14 J and slammed the door into the stop)
        {"beamType":"|SUPPORT", "beamLongBound":4},
        //{"beamSpring":70,"beamDamp":200}, // old: damped gas strut
        //{"beamSpring":70,"beamDamp":0}, // old: undamped spring, too violent
        {"beamSpring":0,"beamDamp":0},
        {"beamDeform":4000,"beamStrength":10000},
        {"beamPrecompression":2.2},
        ["d2l", "bq3l", {"breakGroup":"door_FL_hinge_a"}],
        {"beamPrecompression":1},
        {"breakGroupType":0},
        {"breakGroup":""},

        // hinges
        {"beamType":"|NORMAL","beamLongBound":1, "beamShortBound":1},
        {"beamSpring":1600800,"beamDamp":100},
        {"beamDeform":21840,"beamStrength":26000},
        {"breakGroup":"door_FL_hinge_a"},
        ["dh1l", "bc3l"],
        ["dh1l", "bc4l"],
        ["dh1l", "bf5l"],
        ["dh1l", "bf8"],
        ["dh1l", "f3tm"],
        ["dh1l", "f4tm"],
        {"breakGroup":"door_FL_hinge_b"},
        ["dh2l", "bq1l"],
        ["dh2l", "bc4l"],
        ["dh2l", "f2l"],
        ["dh2l", "f3tm"],
        ["dh2l", "f4tm"],
        {"breakGroup":""},
    ],
    "triangles": [
        ["id1:","id2:","id3:"],
        //front left door
        {"groundModel":"metal"},
        {"group":"bug_door_FL"},
        {"dragCoef":20},
        ["d4l","dh2l","d2l"],
        ["d4l","d2l","d5l"],
        ["d5l","d2l","d3l"],
        ["d5l","d3l","d6l"],
        ["dh1l","d4l","d5l"],
        ["dh1l","d5l","d8l"],
        ["d8l","d5l","d6l"],
        ["d8l","d6l","d9l"],
        ["d10l","d8l","d11l"],
        ["d8l","d10l","dh1l"],
        {"group":""}
    ]
},


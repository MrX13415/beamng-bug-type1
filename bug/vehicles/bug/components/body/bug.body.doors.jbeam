        ["anim__windowFR_state",    "bug_door_FR_window_handle",  "d14r","d8r","d11r",   {"x":-3, "y":7, "z":168},                  {"x":-2200, "y":0, "z":0},    {"x":0, "y":0, "z":0},           0,       1,   0,  1],
        //["anim__doorFR_handle",    "bug_door_FR_handle"      ,  "d14r","d8r","d11r",   {"x":14, "y":-90 , "z":-19.23},   {"x":0, "y":0, "z":-30},    {"x":0, "y":0, "z":0},           0,       1,   0,  1], // old: no lock position
        ["anim__doorFR_handle_lock", "bug_door_FR_handle"    ,  "d14r","d8r","d11r",   {"x":14, "y":-90 , "z":-19.23},   {"x":0, "y":0, "z":-30},    {"x":0, "y":0, "z":0},       -1.67,       1,   0,  1], // open pull (0..1) and lock (-1.67 = 50 deg the other way), set by vehicle.lua
    ],
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        //["door_R", "d9r","d8r","d6r", "box", {"x":0.13, "y":-0.04, "z":0.04}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.03, "y":0.07, "z":0.04},{"color":[1,0.3,0,0], "alphaOnUsed":0}], // old: one box over grip + button; replaced by the button/grip triggers in the door handle parts
        ["door_R_int", "dh1r","d8r","d4r", "box", {"x":0.04, "y":0.04, "z":0.12}, {"x":5, "y":-18, "z":3}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.287, "y":0.07, "z":0.06},{"mesh":["bug_door_FR_handle","bug_door_FR_handle_ring"]}],
    ],
    "actionsEnabled": [

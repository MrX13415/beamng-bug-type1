        //"openForceMagnitude": 30, "openForceDuration": 0.5, // old: pushed the door all the way open
        //"openForceMagnitude": 8, "openForceDuration": 0.3, // old: door popped ~1 m open
        "openForceMagnitude": 0,
        "openForceDuration": 0,
        //"closeForceMagnitude": 130, // old: closed too violently
        "closeForceMagnitude": 91,

"bug_mirror_circular_L": {
    "information":{
        "authors":"53_herbie_53",
        "name":"Left Circular Shaped Mirror",
        "value":150,
    },
    "slotType" : "bug_mirror_L",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["bug_door_L_mirror_circle", ["door_mirror_L"]],
    ],
    "mirrors": [
        ["mesh", "idRef:", "id1:", "id2:"],
        ["bug_door_L_mirror_circle","mi3l","mi2l","mi1l",{"refBaseTranslation":{"x":0.050,"y":0.007,"z":-0.004},"baseRotationGlobal":{"x":-7.5,"y":0,"z":-14}}],
    ],
    // old (before swivel mount): fixed mirror, bent when hit
        //"nodes": [
        //["id", "posX", "posY", "posZ"],
        //{"selfCollision":false}, // door sweeps through here when opening; self-collision would shove the mirror off its hinge-top mount

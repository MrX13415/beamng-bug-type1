        ["dw2fr","dw4fr"],
        // rigdi
        ["dw1fr","dw5fr"],
        ["dw2fr","dw5fr"],
        ["dw3fr","dw5fr"],
        ["dw4fr","dw5fr"],
        {"deformGroup":""},
        {"disableMeshBreaking":false}
    ],
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],

        ["dw1fr", "doorglass_R_1", true, true, 0.0, 800100, 4000, "FLT_MAX"],
        ["dw2fr", "doorglass_R_2", true, true, 0.0, 800100, 4000, "FLT_MAX"],
        ["dw3fr", "doorglass_R_1", true, true, 0.0, 800100, 4000, "FLT_MAX"],

"bug_doorglass_FR": {
    "information":{
        "authors":"BeamNG",
        "name":"Window",
        "value":230,
    },
    "slotType" : "bug_doorglass_FR",
    "controller": [
        ["fileName"],
        ["window", {"name": "windowFR", "node": "d8r"}]
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["door_window_R", ["bug_door_FR"]],
        ["door_vent_R", ["bug_door_FR"]],

        {"deformGroup":"ventglass_FR_break","deformMaterialBase":"glass_invisible","deformMaterialDamaged":"window_glass_dmg"},
        {"deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound3","deformVolume":0.7},
        ["door_vent_R_glass", ["bug_door_FR"]],
        {"deformGroup":""},

        {"deformGroup":"doorglass_FR_break","deformMaterialBase":"glass_invisible","deformMaterialDamaged":"window_glass_dmg"},
        {"deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound7","deformVolume":0.3},
        ["door_window_R_glass", ["doorwindow_FR"]],
        {"deformGroup":""}
    ],
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["window_FR", "", "dh1r","d8r","d4r", "box", {"x":0.06, "y":0.05, "z":0.06}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.16, "y":0.05, "z":0.06}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["window_FR", "action0", "window_FR_down"],   // default: left mouse btn
        ["window_FR", "action1", "window_FR_up"],     // default: SHIFT + left mouse btn
        ["window_FR", "action2", "window_FR_up"],     // default: middle mouse btn
    ],
    "events":[
        ["id", "title", "desc"],
        // TODO: texts
        ["window_FR_down", "ui.inputActions.bug.doorWindow_R_down.title", "ui.inputActions.bug.doorWindow_R_down.description", {"onChange":"controller.getControllerSafe('windowFR').open(VALUE)"}],
        ["window_FR_up",   "ui.inputActions.bug.doorWindow_R_up.title", "ui.inputActions.bug.doorWindow_R_up.description", {"onChange":"controller.getControllerSafe('windowFR').close(VALUE)"}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        {"group":"doorwindow_FR"},
        {"selfCollision":false},
        {"collision" :false},
        {"nodeMaterial":"|NM_GLASS"},
        {"frictionCoef":0.7},
        {"nodeWeight":0.5},
        ["dw1fr", -0.572998, -0.243692, 1.28446],
        ["dw2fr", -0.602269,  0.294437, 1.298905],
        ["dw3fr", -0.619834, -0.248225, 0.981273],
        ["dw4fr", -0.655679,  0.294437, 0.988975],
        //-
        ["dw5fr", -0.487890,  0.032178, 1.11795],
        {"group":""},
    ],
    "beams": [
        ["id1:", "id2:"],

        {"disableMeshBreaking":true},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":401000,"beamDamp":140},
        {"beamDeform":4000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":1.1},
        {"deformGroup":"doorglass_FR_break","deformationTriggerRatio":0.01},
        // main
        {"breakGroup":"doorglass_FR"},
        ["dw1fr","dw2fr"],
        {"breakGroup":""},
        ["dw2fr","dw3fr"],
        ["dw3fr","dw4fr"],
        ["dw4fr","dw1fr"],
        // cross
        ["dw1fr","dw3fr"],
        ["dw2fr","dw4fr"],
        // rigdi
        ["dw1fr","dw5fr"],
        ["dw2fr","dw5fr"],
        ["dw3fr","dw5fr"],
        ["dw4fr","dw5fr"],
        {"deformGroup":""},
    ],
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],

        ["dw1fr", "doorglass_R_1", true, true, 0.0, 800100, "FLT_MAX", "FLT_MAX"],
        ["dw2fr", "doorglass_R_2", true, true, 0.0, 800100, "FLT_MAX", "FLT_MAX"],
        ["dw3fr", "doorglass_R_1", true, true, 0.0, 800100, "FLT_MAX", "FLT_MAX"],
        ["dw4fr", "doorglass_R_2", true, true, 0.0, 800100, "FLT_MAX", "FLT_MAX"],
    ],
    "rails": {
        "doorglass_R_1":{"links:":["d11r", "d5r"], "broken:":[], "looped":false, "capped":true},
        "doorglass_R_2":{"links:":["d12r", "d6r"], "broken:":[], "looped":false, "capped":true},
    },
    "hydros": [
        ["id1:","id2:"],

        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":8000,"beamDamp":50,"beamDeform":"FLT_MAX","beamStrength":12500},
        ["d11r","dw1fr", {"inputSource":"windowFR_state", "inLimit":1.0, "outLimit":8.5, "inRate":10, "outRate":10, "inputFactor":1.0}],
        ["d12r","dw2fr", {"inputSource":"windowFR_state", "inLimit":1.0, "outLimit":8.5, "inRate":10, "outRate":10, "inputFactor":1.0}],
    ],
    "triangles": [
        ["id1:","id2:","id3:"],
        {"group":"doorwindow_FL"},
        {"groundModel":"metal"},
        {"dragCoef":7},
        ["dw4fr", "dw3fr", "dw1fr"],
        ["dw4fr", "dw1fr", "dw2fr"],
        {"group":""},

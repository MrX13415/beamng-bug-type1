{
"bug_windshield": {
    "information":{
        "authors":"BeamNG",
        "name":"Windshield",
        "value":1300,
    },
    "slotType" : "bug_windshield",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["body_window_F",      ["bug_body","bug_windshield"]],

        {"deformGroup":"windshield_break", "deformMaterialBase":"glass_invisible", "deformMaterialDamaged":"window_glass_dmg"},
        ["body_window_F_glass",   ["bug_body","bug_windshield"]],
        {"deformGroup":"windshield_break", "deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound9", "deformVolume":0.8, "deformMaterialBase":"glass_invisible", "deformMaterialDamaged":"glass_mirror"},
        //["windshield_glass_dmg",  ["bug_body","bug_windshield"]],
        {"deformGroup":""},

        // exterior : details : fixtures
    //    ["wiper_L", ["bug_body","bug_windshield", "bug_roof"]],   // Converted to props
    //    ["wiper_R", ["bug_body","bug_windshield", "bug_roof"]],   // Converted to props
        ["wiper_mounts", ["bug_body","bug_windshield", "bug_roof"]],
        ["wiper_jet", ["bug_body","bug_windshield", "bug_roof"]],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_GLASS"},
         {"nodeWeight":1.0},
         {"group":""},
         ["wi1", 0.00000, -0.30000, 1.15000, {"group":["bug_windshield","gps"]}],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamSpring":901000,"beamDamp":50},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          //weak windshield beams
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"beamDeform":4000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"windshield_break","deformationTriggerRatio":0.025},
          ["bd1ll", "brf1l"],
          ["bd1rr", "brf1r"],
          ["bd1r", "brf1r"],
          ["bd1r", "brf1"],
          ["bd1r", "brf1rr"],
          ["bd1l", "brf1l"],
          ["bd1l", "brf1"],
          ["bd1l", "brf1ll"],
          ["bd1", "brf1"],
          ["bd1", "brf1l"],
          ["bd1", "brf1ll"],
          ["bd1", "brf1r"],
          ["bd1", "brf1rr"],

          ["wi1", "brf1rr"],
          ["wi1", "brf1r"],
          ["wi1", "brf1", {"breakGroup": "windshield"}],
          ["wi1", "brf1l"],
          ["wi1", "brf1ll"],

          ["wi1", "bc1r"],
          ["wi1", "bc1l"],

          ["wi1", "bd1r"],
          ["wi1", "bd1"],
          ["wi1", "bd1l"],
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},
          {"deformGroup":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
        ["id1:","id2:","id3:"],

        {"group":"windshield"},
        {"groundModel":"GLASS"},
        {"dragCoef":4},
        ["bc1r", "bd1r", "brf1rr"],
        ["brf1rr", "bd1r", "brf1r"],
        ["bd1r", "bd1", "brf1r"],
        ["brf1r", "bd1", "brf1"],
        ["bd1", "bd1l", "brf1"],
        ["brf1", "bd1l", "brf1l"],
        ["bd1l", "bc1l", "brf1l"],
        ["brf1l", "bc1l", "brf1ll"],
        {"group":""},
    ],

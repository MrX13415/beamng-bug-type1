    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        {"group":"doorwindow_FR"},
        {"selfCollision":false},
        {"collision" :false},
        {"nodeMaterial":"|NM_GLASS"},
        {"frictionCoef":0.7},
        {"nodeWeight":0.5},
        ["dw1fr", -0.572998, -0.243692, 1.28446],
        ["dw2fr", -0.602269,  0.294437, 1.298905],
        ["dw3fr", -0.619834, -0.248225, 0.981273],
        ["dw4fr", -0.655679,  0.294437, 0.988975],

{

// --- roofs
"bug_roof_hardtop": {
    "information":{
        "authors":"Vertex Style",
        "name":"Hardtop Roof",
    },
    "slotType" : "bug_roof",
	"slots": [
        ["type", "default", "description"],

		["bug_headliner_hardtop", "bug_headliner_hardtop", "Headliner"],
		["bug_roof_rack", "", "Roof Rack"],
	],
    "sounds": {
        "$+cabinFilterCoef": 0.2
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        //    exterior
        ["body_roof_hardtop",              ["bug_body", "bug_body_roof", "bug_body_cowl"]],
        ["body_roof_gutter",               ["bug_body", "bug_body_roof"]],

        //    interior
        ["body_interior_roof_hardtop",     ["bug_body", "bug_body_roof"]],
	],
    "triangles": [
        ["id1:","id2:","id3:"],

        {"groundModel":"metal"},
        {"dragCoef":10},
        ["brf2rr", "brf2r", "brf3rr"],    // roof opening triangle
        ["brf3rr", "brf2r", "brf3r"],     // roof opening triangle
        ["brf2r", "brf2", "brf3r"],       // roof opening triangle
        ["brf3r", "brf2", "brf3"],        // roof opening triangle
        ["brf2", "brf2l", "brf3"],        // roof opening triangle
        ["brf3", "brf2l", "brf3l"],       // roof opening triangle
        ["brf2l", "brf2ll", "brf3l"],     // roof opening triangle
        ["brf3l", "brf2ll", "brf3ll"],    // roof opening triangle
        //-
        ["brf3rr", "brf3r", "brf4rr"],    // roof opening triangle
        ["brf4rr", "brf3r", "brf4r"],     // roof opening triangle
        ["brf3r", "brf3", "brf4r"],       // roof opening triangle
        ["brf4r", "brf3", "brf4"],        // roof opening triangle
        ["brf3", "brf3l", "brf4"],        // roof opening triangle
        ["brf4", "brf3l", "brf4l"],       // roof opening triangle
        ["brf3l", "brf3ll", "brf4l"],     // roof opening triangle
        ["brf4l", "brf3ll", "brf4ll"],    // roof opening triangle
        //-
        ["brf4rr", "brf4r", "brf5rr"],    // roof opening triangle
        ["brf5rr", "brf4r", "brf5r"],     // roof opening triangle
        ["brf4r", "brf4", "brf5r"],       // roof opening triangle
        ["brf5r", "brf4", "brf5"],        // roof opening triangle
        ["brf4", "brf4l", "brf5"],        // roof opening triangle
        ["brf5", "brf4l", "brf5l"],       // roof opening triangle
        ["brf4l", "brf4ll", "brf5l"],     // roof opening triangle
        ["brf5l", "brf4ll", "brf5ll"],    // roof opening triangle
    ]
},
"bug_roof_ragtop": {
    "information":{
        "authors":"Vertex Style",
        "name":"Ragtop Roof",
    },
    "slotType" : "bug_roof",
	"slots": [
        ["type", "default", "description"],

		["bug_headliner_ragtop", "bug_headliner_ragtop", "Headliner"],
		["bug_ragtop_cover", "bug_ragtop_cover", "Ragtop Cover"],
		["bug_roof_rack", "", "Roof Rack"],
	],
    "sounds": {
        "$+cabinFilterCoef": 0.05
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        //    exterior
        ["body_roof_racktop_rails",        ["bug_body", "bug_body_roof"]],
        ["body_roof_ragtop",               ["bug_body", "bug_body_roof", "bug_body_cowl"]],
        ["body_roof_gutter",               ["bug_body", "bug_body_roof"]],

        //    interior
        ["body_interior_roof_ragtop",      ["bug_body", "bug_body_roof"]],
	],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        {"group":"bug_body"},
        {"collision":false},
        {"selfCollision":false},

        // overriding nodes defined in body
        {"nodeWeight":1.0},
       // {"group":"bug_body_roof"},
        // roof
        ["brf3",  0.00000,  0.03775,  1.48149],
        ["brf3r", -0.22850,  0.03775,  1.47198],
        ["brf3l",  0.22850,  0.03775,  1.47198],
        ["brf4",  0.00000,  0.33135,  1.49006],
        ["brf4r", -0.23020,  0.33135,  1.47941],
        ["brf4l",  0.23020,  0.33135,  1.47941],

        {"collision":true},
        {"selfCollision":false},
        {"group":""},
    ],
},

"bug_ragtop_cover": {
    "information":{
        "authors":"MrX13415",
        "name":"Ragtop Cover",
    },
    "slotType" : "bug_ragtop_cover",
    "slots": [
        ["type", "default", "description"],

		["skin_ragtop", "bug_skin_ragtop_white", "Color", {"coreSlot":true}]
	],
    "sounds": {
        "$+cabinFilterCoef": 0.1
    },
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$ragtopInitState", "range", "", "Body", 0, 0, 1.0, "Ragtop Open", "Inital open position of the Ragtop roof.", {"minDis":0, "maxDis":100}],
	],
    "controller": [
        ["fileName"],
        ["ragtop", {"node": "brf4", "state": "$=$ragtopInitState"}]
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        
        // Exterior:
        //  complete, fully closed mesh
        ["body_roof_ragtop_fabric",        ["bug_racktop_fabric"]],
        //  sliced, fully closed mesh
        ["body_roof_ragtop_fabric.a",      ["bug_racktop_fabric2", "bug_body_racktop_mount"]],
        ["body_roof_ragtop_fabric.b",      ["bug_body_racktop_mount"]],
        //  sliced mesh with fold for 1st and 2nd bar
        ["body_roof_ragtop_fabric.1",      ["bug_racktop_fabric1"]],
        ["body_roof_ragtop_fabric.2",      ["bug_racktop_fabric2"]],

        // Details
        ["body_roof_ragtop_handle",        ["bug_racktop_bar1", "bug_racktop_fabric1"]],
        ["body_roof_ragtop_hook",          ["bug_racktop_bar1", "bug_racktop_fabric1"]],
        // Bar mesh
        ["body_roof_ragtop_bar1",          ["bug_racktop_bar1"]],
        ["body_roof_ragtop_bar2",          ["bug_racktop_bar2"]],
	],
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["ragtop", "", "rta1r","rta1l","rtb1r", "box", {"x":0.1, "y":0.05, "z":0.04}, {"x":3, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.35, "y":0.07, "z":-0.03}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["ragtop", "action0", "ragtop_open"],   // default: left mouse btn
        ["ragtop", "action1", "ragtop_close"],  // default: SHIFT + left mouse btn
        ["ragtop", "action2", "ragtop_close"],  // default: middle mouse btn
    ],
    "events":[
        ["id", "title", "desc"],
        // TODO: texts
        ["ragtop_open",  "ui.inputActions.bug.ragtop_open.title", "ui.inputActions.bug.ragtop_open.description", {"onChange":"controller.getControllerSafe('ragtop').open(VALUE)"}],
        ["ragtop_close", "ui.inputActions.bug.ragtop_close.title", "ui.inputActions.bug.ragtop_close.description", {"onChange":"controller.getControllerSafe('ragtop').close(VALUE)"}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        // Override body nodes ...
        {"group":""},
        {"selfCollision": false},
        ["brf5",  0.00000,  0.71409,  1.47405],
        ["brf5r", -0.22944,  0.71449,  1.46385],
        ["brf5l",  0.22944,  0.71449,  1.46385],

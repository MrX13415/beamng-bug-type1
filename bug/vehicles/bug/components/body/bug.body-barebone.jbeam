"bug_dashboard_barebone": {
    "information":{
        "authors": "MrX13415",
        "name": "Dashboard",
        "value": 300,
    },
    "slotType" : "bug_dashboard_barebone",
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],

        ["bug_shifter",           ["bug_shifter"], [],           "bug_shifter_4M",        "Shifter"],
        ["skin_speedometer",      ["skin_speedometer"], [],      "bug_speedo_km_140",     "Speedometer",   {"coreSlot":true}],
        ["skin_interior_theme",   ["skin_interior_theme"], [],   "bug_inputs_white",      "Controls"],
                
        ["bug_ignition_barebone", ["bug_ignition_barebone"], [], "bug_ignition_barebone", "Ignition Lock", {"coreSlot":true, "nodeMove": {"x":0.102671,"y":0.006238,"z":0.034791}}],
    ],
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],

        ["parkingbreak", "f4mr","f4ml","refup", "box", {"x":0.02, "y":0.09, "z":0.07}, {"x":-11, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":0.074, "y":0.202, "z":-0.16},{"color":[1,0.3,0,0], "alphaOnUsed":0}]
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],        

        ["parkingbreak", "action0", "common:parkingbrake"],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
	
        ["bug_dashboard_barebone",        ["bug_dashboard"]],
        ["bug_dashboard_barebone_cables", ["bug_dashboard"]],

        ["bug_controls_shifter_M_mount",  ["bug_frame", "bug_body"]],
        ["bug_controls_handbreak_case",   ["bug_frame", "bug_body"]],
    ],
    "glowMap":{
        // dashboard gauges
        "bug_gauges":               {"simpleFunction":"power__gauges",  "off":"bug_gauges",         "on":"bug_gauges_light",         "on_intense":"bug_gauges_light", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_gauges_needle":        {"simpleFunction":"power__gauges",  "off":"bug_gauges_needle",  "on":"bug_gauges_needle_light",  "on_intense":"bug_gauges_needle_light", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_speedometer":          {"simpleFunction":"power__gauges",  "off":"bug_speedometer",    "on":"bug_speedometer_light",    "on_intense":"bug_speedometer_light", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_tachometer":           {"simpleFunction":"power__gauges",  "off":"bug_tachometer",     "on":"bug_tachometer_light",     "on_intense":"bug_tachometer_light", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_oil_ammeter":          {"simpleFunction":"power__gauges",  "off":"bug_oil_ammeter",    "on":"bug_oil_ammeter_light",    "on_intense":"bug_oil_ammeter_light", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_speedo_needle":        {"simpleFunction":"power__gauges",  "off":"bug_speedo_needle",  "on":"bug_speedo_needle_light",  "on_intense":"bug_speedo_needle_light", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_tacho_needle":         {"simpleFunction":"power__gauges",  "off":"bug_tacho_needle",   "on":"bug_speedo_needle_light",  "on_intense":"bug_speedo_needle_light", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_clock_back":           {"simpleFunction":"power__gauges",  "off":"bug_clock_back",     "on":"bug_clock_light",          "on_intense":"bug_clock_light", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_clock_needle":         {"simpleFunction":"power__gauges",  "off":"bug_clock_needle",   "on":"bug_clock_needle_light",   "on_intense":"bug_clock_needle_light", "materialEmissiveScaling":{"on_max":1.0}},

        // dashboard lights
        "bug_dash_light_signal":    {"simpleFunction":"power__signal_dash",               "off":"bug_dash_light_signal",   "on":"bug_dash_light_signal_on",  "on_intense":"bug_dash_light_signal_on", "materialEmissiveScaling":{"on_max":1.0}},
        "bug_dash_light_highbeam":  {"simpleFunction":"power__highbeam",                                 "off":"bug_dash_light_highbeam", "on":"bug_dash_light_on",         "on_intense":"bug_dash_light_on", "materialEmissiveScaling":{"on_max":1.0}},
        // use the "oil" LED to indicate regeneration beeing active (blinking).
        "bug_dash_light_oil":       {"simpleFunction":{"power__oilpressure_low": 0.3, "power__oil":0.3, "power__regeneration":0.3},            "off":"bug_dash_light_oil",      "on":"bug_dash_light_on",         "on_intense":"bug_dash_light_on", "materialEmissiveScaling":{"on_max":0.3}},
        "bug_dash_light_engine":    {"simpleFunction":{"power__generatorPower_low": 0.3, "power__checkengine":0.3},             "off":"bug_dash_light_engine",   "on":"bug_dash_light_on",         "on_intense":"bug_dash_light_on", "materialEmissiveScaling":{"on_max":0.3}},
    },
    "props": [
        ["func",         "mesh",      "idRef:", "idX:", "idY:", 		"baseRotation",           "rotation",                 "translation",        		"min", "max", "offset", "multiplier"],

        ["anim__turnsignal",   "bug_indicatorlever",    "steer2","steer3","steer1",   {"x":0, "y":0, "z":180},   {"x":0, "y":0, "z":7},    {"x":0, "y":0, "z":0},          -1,       1,      0, -1],
        ["anim__parkingbrake", "bug_controls_handbreak",  "f4mr","f4ml","refup",   {"x":0, "y":0, "z":0},   {"x":10, "y":0, "z":0},    {"x":0, "y":0, "z":0},          -1,       1,      0, -1],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        
        {"collision":true},
        {"selfCollision":false},
        
        {"nodeWeight":1.3},
        {"group": "bug_dashboard"},

        // dashboard
        ["bd0",  0.265, -0.750,  0.940, {"collision":false}],

        ["bd1",  0.200, -0.555,  1.030, {"nodeWeight":2.0}],
        ["bd1l", 0.320, -0.560,  1.030],
        
        //dash nodes
        {"nodeWeight": 1.1},
        ["dshl", 0.400, -0.552, 0.830],
        ["dsh",  0.120, -0.545, 0.830, {"nodeWeight": 2.0}],
        ["dsh2", 0.000, -0.570, 0.400, {"collision":false}],
        {"group": ""},
    ],
    "beams": [
        ["id1:", "id2:"],

        {"disableMeshBreaking":true},
        {"deformLimitExpansion":1.1},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":701000,"beamDamp":75, "beamStrength":"FLT_MAX"},

        // dashboard
        {"beamDeform":3000},
        ["bd1l", "bd1"],
        ["dsh", "dshl"],
        ["dsh", "bd1"],
        ["dsh", "bd1l"],
        ["bd1", "dshl"],
        ["bd1l", "dshl"],
        // dashboard: rigidify
        ["dsh", "bd0"],
        ["dshl", "bd0"],
        ["dsh2", "bd0"],
        ["bd1", "bd0"],
        ["bd1l", "bd0"],

        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1.0},
        {"beamSpring":1001000,"beamDamp":50},
        {"beamDeform":15000,"beamStrength":"FLT_MAX"},

        //dashboard
        {"deformGroup":"dashboard_break","deformationTriggerRatio":0.025},
        ["dsh", "dsh2"],
        ["dsh", "dshl"],
        ["dsh2", "dshl"],

        ["dshl", "bd1l"],
        ["dsh", "bd1l"],

        // dashboard <> frame
        {"beamStrength":50000, "breakGroup": "body"},
        ["dsh", "f2tm"],
        ["dsh", "f3tm"],
        ["dsh", "f4tm"],
        ["dshl", "f2l"],
        ["dshl", "f3l"],
        ["dshl", "f3r"],
        ["dshl", "f4l"],
        ["dsh2", "f3l"],
        ["dsh2", "f3r"],
        ["dsh2", "f3tm"],
        {"beamStrength":"FLT_MAX", "breakGroup": ""},
        {"deformGroup":""},

        {"deformLimitExpansion":1.1},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},

        {"optional":true},
        {"beamSpring":300000,"beamDamp":50},
        {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
        ["ikey", "bd1l"],
        ["ikey", "dshl"],
        {"optional":false},

        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

        {"deformLimitExpansion":1.1},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1.0},
        {"disableMeshBreaking":false}
    ],
    "triangles": [
        ["id1:","id2:","id3:"],
        //front left door
        {"groundModel":"metal"},
        {"group":"bug_dashboard"},
        {"dragCoef":0},
        //L
        ["bd1l", "dsh", "bd1"],
        ["bd1l", "dshl", "dsh"],
        {"group":""}
    ]
},



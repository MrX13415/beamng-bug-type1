        ["$= ($seatID == 'FL' and ('is'..$seatID..'3o') or ('is'..$seatID..'1o'))", "$= ($seatID == 'FL' and ('is'..$seatID..'1o') or ('is'..$seatID..'3o'))", "$= ($seatID == 'FL' and ('is'..$seatID..'3i') or ('is'..$seatID..'3i'))"],
        ["$= ($seatID == 'FL' and ('is'..$seatID..'1o') or ('is'..$seatID..'1i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'1i') or ('is'..$seatID..'1o'))", "$= ($seatID == 'FL' and ('is'..$seatID..'3i') or ('is'..$seatID..'3i'))"],
        ["$= ($seatID == 'FL' and ('is'..$seatID..'3i') or ('is'..$seatID..'1i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'1i') or ('is'..$seatID..'3i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'4i') or ('is'..$seatID..'4i'))"],
        ["$= ($seatID == 'FL' and ('is'..$seatID..'1i') or ('is'..$seatID..'2i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'2i') or ('is'..$seatID..'1i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'4i') or ('is'..$seatID..'4i'))"],
        ["$= ($seatID == 'FL' and ('is'..$seatID..'4o') or ('is'..$seatID..'2o'))", "$= ($seatID == 'FL' and ('is'..$seatID..'2o') or ('is'..$seatID..'4o'))", "$= ($seatID == 'FL' and ('is'..$seatID..'3o') or ('is'..$seatID..'3o'))"],
        ["$= ($seatID == 'FL' and ('is'..$seatID..'2o') or ('is'..$seatID..'1o'))", "$= ($seatID == 'FL' and ('is'..$seatID..'1o') or ('is'..$seatID..'2o'))", "$= ($seatID == 'FL' and ('is'..$seatID..'3o') or ('is'..$seatID..'3o'))"],
        ["$= ($seatID == 'FL' and ('is'..$seatID..'4i') or ('is'..$seatID..'2i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'2i') or ('is'..$seatID..'4i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'4o') or ('is'..$seatID..'4o'))"],
        ["$= ($seatID == 'FL' and ('is'..$seatID..'2i') or ('is'..$seatID..'2o'))", "$= ($seatID == 'FL' and ('is'..$seatID..'2o') or ('is'..$seatID..'2i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'4o') or ('is'..$seatID..'4o'))"],
        ["$= ($seatID == 'FL' and ('is'..$seatID..'6i') or ('is'..$seatID..'6i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'5i') or ('is'..$seatID..'5o'))", "$= ($seatID == 'FL' and ('is'..$seatID..'6o') or ('is'..$seatID..'6o'))"],
        ["$= ($seatID == 'FL' and ('is'..$seatID..'5i') or ('is'..$seatID..'5i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'5o') or ('is'..$seatID..'5i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'6o') or ('is'..$seatID..'6o'))"]
    ]
  }



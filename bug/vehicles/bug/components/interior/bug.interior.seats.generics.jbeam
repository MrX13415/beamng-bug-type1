        ["$= ($seatID == 'FL' and ('is'..$seatID..'2o') or ('is'..$seatID..'2i'))", "$= ($seatID == 'FL' and ('is'..$seatID..'2i') or ('is'..$seatID..'2o'))", "$= ($seatID == 'FL' and ('is'..$seatID..'1i') or ('is'..$seatID..'1i'))"],

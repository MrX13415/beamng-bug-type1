        ["$='is'..$seatID..'8i'", "$= ($side == 1 and ('f5ml') or ('f5mr'))"],
        // Rigidfing connections for seat rails
        ["$='is'..$seatID..'7o'", "$= ($side == 1 and ('f8l') or ('f8r'))"],
        ["$='is'..$seatID..'7i'", "$= ($side == 1 and ('f8l') or ('f8r'))"],
        ["$='is'..$seatID..'8o'", "$= ($side == 1 and ('f8l') or ('f8r'))"],
        ["$='is'..$seatID..'8i'", "$= ($side == 1 and ('f8l') or ('f8r'))"],
        
        // damp help
        {"beamSpring":0,"beamDamp":300},
        ["$='is'..$seatID..'1i'", "$='is'..$seatID..'5o'"],
        ["$='is'..$seatID..'1o'", "$='is'..$seatID..'5i'"],

        {"beamSpring":400000,"beamDamp":150},
        {"beamDeform":20000,"beamStrength":"FLT_MAX"},
        ["$='is'..$seatID..'9'", "$='is'..$seatID..'2i'"],
        ["$='is'..$seatID..'9'", "$='is'..$seatID..'2o'"],
        ["$='is'..$seatID..'9'", "$='is'..$seatID..'5o'"],
        ["$='is'..$seatID..'9'", "$='is'..$seatID..'5i'"],


{

// -- Rear seat luggage:
"cargo_load_box_M_rear_luggage": {
   "information":{
       "authors":"BeamNG",
       "name":"1x Cargo Load Box M",
       "value":50,
   },
   "slotType" : "bug_decoration2",
   "cargoStorage":[
      ["groupId","name","cargoTypes", "capacity"],
      ["luggageBoxA","Cargo Box A",["parcel"], 4],
   ],
   "flexbodies": [
      ["mesh", "[group]:", "nonFlexMaterials"],
      ["cargo_load_box_m", ["rear_luggage"],[],{"pos":{"x":0.005, "y":1.18, "z":0.61}, "rot":{"x":0, "y":0, "z":0}, "scale":{"x":1.0, "y":1.0, "z":1.0}}],
      ["woodplanks_straps_boxutility_small", ["rear_luggage"],[],{"pos":{"x":0, "y":1.18, "z":0.61}, "rot":{"x":0, "y":0, "z":90}, "scale":{"x":0.246, "y":0.45, "z":0.261}}],
   ],
   "variables": [
      ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
      ["$rear_luggage_box_weight", "range", "Kg", "Cargo", 0.0, 0.0, 25.0, "Luggage Box Mass", "Adjust the weight of the box", {"stepDis":1}],
   ],
   "nodes": [
       ["id", "posX", "posY", "posZ"],
       {"frictionCoef":0.5},
       {"nodeMaterial":"|NM_PLASTIC"},
       {"collision":false},
       {"selfCollision":false},
       {"group":"rear_luggage"},
       ["rear_luggage_box_l",  0.15, 1.10, 0.70],
       ["rear_luggage_box_r", -0.15, 1.10, 0.70],
       ["rear_luggage_box", 0.0, 1.17, 0.79, {"nodeWeight":"$=12+$rear_luggage_box_weight","nodeWeightFunction":"=12+($volume)","cargoGroup":"luggageBoxA"}],
       {"group":""},
   ],
   "beams": [
        ["id1:", "id2:"],

        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"deformLimitExpansion":0},

        //cargo load box
        {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":500001,"beamDamp":250},
        {"beamDeform":510000,"beamStrength":"FLT_MAX"},
        {"optional":true},
        ["rear_luggage_box_l", "rear_luggage_box_r"],
        ["rear_luggage_box_l", "rear_luggage_box"],
        ["rear_luggage_box_r", "rear_luggage_box"],

        ["rear_luggage_box_l", "bi2"],
        ["rear_luggage_box_l", "bi3"],
        ["rear_luggage_box_l", "bi2l"],
        ["rear_luggage_box_l", "bi3l"],

        ["rear_luggage_box_r", "bi2"],
        ["rear_luggage_box_r", "bi3"],
        ["rear_luggage_box_r", "bi2r"],
        ["rear_luggage_box_r", "bi3r"],

        ["rear_luggage_box", "bi2l"],
        ["rear_luggage_box", "bi2r"],
        ["rear_luggage_box", "bi3l"],
        ["rear_luggage_box", "bi3r"],
        ["rear_luggage_box", "bi4l"],
        ["rear_luggage_box", "bi4r"],
        {"optional":false},
        
        {"breakGroup":""},
        {"deformLimitExpansion":1.0},
    ],
},



{

// --- Console cage

"bug_radio": {
    "information":{
        "authors":"MrX13415",
        "name":"Radio",
        "value":300
    },
    "slotType": "bug_console_cage",
    "slots": [
        ["type", "default", "description"],

        ["skin_console", "skin_console_silver", "Color", {"coreSlot": true}],

        ["bug_radio_mode", "bug_radio_mode_interior", "Mode", {"coreSlot": true}],
        ["bug_radio_output", "bug_radio_output_2D", "Output", {"coreSlot": true}],
        // No longer used["bug_radio_station", "radio_station_piano", "Radio Station"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$state", "range", " ", "Radio", 0, 0, 1, "Inital On/Off State", "Inital On/Off state of the radio", {"stepDis":1}],
        ["$volume", "range", "", "Radio", 0.3, 0.05, 1.0, "Inital Volume", "Inital volume of the radio", {"minDis":5, "maxDis":100}],
	],
    "electricPower":[
        ["power"],
        [2, {"trigger": "electrics.values.radio_state"}],
        [90, {"trigger": "electrics.values.radio_state", "ratio": "electrics.values.radio_volume * POWER"}],
    ],
    "controller": [
        ["fileName"],
        ["radio"]
    ],
    "radio": {
        "state": "$state",
        "volume": "$volume",
        "nodeOutput": "speaker",
        "nodeSFX": "dsh",
        "sfxPresetUse": "event:>Vehicle>Interior>Light>AU3_On",
        "sfxPresetSet": "event:>Vehicle>Interior>Light>AU3_Off",
        "sfxRadioOn": "event:>Vehicle>Interior>Light>AU5_AC_Dial_On",
        "sfxRadioOff": "event:>Vehicle>Interior>Light>AU5_AC_Dial_On",  // AU5_AC_Dial_Off no sound?
        "slotTypeStations": "bug_radio_station"
    },
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],

        ["volDown",      "dsh","dshl","dsh2", "box", {"x":0.01, "y":0.01, "z":0.014}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":0.0686, "y":-0.1240, "z":-0.0635},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
        ["volUp",        "dsh","dshl","dsh2", "box", {"x":0.01, "y":0.01, "z":0.014}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":0.0580, "y":-0.1240, "z":-0.0635},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
        
        ["tunePreset1",  "dsh","dshl","dsh2", "box", {"x":0.012, "y":0.02, "z":0.006}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.02779, "y":-0.1095, "z":-0.05},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
        ["tunePreset2",  "dsh","dshl","dsh2", "box", {"x":0.012, "y":0.02, "z":0.006}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.01079, "y":-0.1095, "z":-0.05},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
        ["tunePreset3",  "dsh","dshl","dsh2", "box", {"x":0.012, "y":0.02, "z":0.006}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.00621, "y":-0.1095, "z":-0.05},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
        ["tunePreset4",  "dsh","dshl","dsh2", "box", {"x":0.012, "y":0.02, "z":0.006}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.02321, "y":-0.1095, "z":-0.05},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
        ["tunePreset5",  "dsh","dshl","dsh2", "box", {"x":0.012, "y":0.02, "z":0.006}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.04021, "y":-0.1095, "z":-0.05},{"color":[1,0.3,0,0], "alphaOnUsed":0}],

        ["tuneDown",     "dsh","dshl","dsh2", "box", {"x":0.01, "y":0.01, "z":0.014}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.0680, "y":-0.1240, "z":-0.0635},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
        ["tuneUp",       "dsh","dshl","dsh2", "box", {"x":0.01, "y":0.01, "z":0.014}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.0786, "y":-0.1240, "z":-0.0635},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
    ],
    "actionsEnabled": [
        ["id"],
        ["radio_Toggle"],
        ["radio_VolumeDown"],
        ["radio_VolumeUp"],
        ["radio_TuneRev"],
        ["radio_TuneNext"],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],

        ["volDown", "action0", "radio_On_VolumeDown"],
        ["volDown", "action1", "radio_Off"],
        ["volDown", "action2", "radio_Off"],
        ["volUp", "action0", "radio_On_VolumeUp"],
        ["volUp", "action1", "radio_Off"],
        ["volUp", "action2", "radio_Off"],

        ["tunePreset1", "action0", "radio_TunePreset1"],
        ["tunePreset2", "action0", "radio_TunePreset2"],
        ["tunePreset3", "action0", "radio_TunePreset3"],
        ["tunePreset4", "action0", "radio_TunePreset4"],
        ["tunePreset5", "action0", "radio_TunePreset5"],

        ["tunePreset1", "action1", "radio_SetPreset1"],
        ["tunePreset2", "action1", "radio_SetPreset2"],
        ["tunePreset3", "action1", "radio_SetPreset3"],
        ["tunePreset4", "action1", "radio_SetPreset4"],
        ["tunePreset5", "action1", "radio_SetPreset5"],

        ["tunePreset1", "action2", "radio_SetPreset1"],
        ["tunePreset2", "action2", "radio_SetPreset2"],
        ["tunePreset3", "action2", "radio_SetPreset3"],
        ["tunePreset4", "action2", "radio_SetPreset4"],
        ["tunePreset5", "action2", "radio_SetPreset5"],
        
        ["tuneDown", "action0", "radio_TuneDown"],
        ["tuneDown", "action1", "radio_TuneRev"],
        ["tuneDown", "action2", "radio_TuneRev"],
        ["tuneUp", "action0", "radio_TuneUp"],
        ["tuneUp", "action1", "radio_TuneNext"],
        ["tuneUp", "action2", "radio_TuneNext"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
	
         //old: ["radio", ["bug_dashboard"]],
         //     ["radio_buttons",      ["bug_dashboard"]],
         //     ["radio_knobs",        ["bug_dashboard"]],
         ["radio_frame",        ["bug_dashboard"]],
         ["radio_knobs_socket", ["bug_dashboard"]],
         ["radio_scale",        ["bug_dashboard"]],

         ["radio_speaker",      ["bug_dashboard"]],
    ],
    "props": [
        ["func",           "mesh",               "idRef:", "idX:", "idY:", "baseRotation",          "rotation",             "translation",          "min", "max", "offset", "multiplier"],

        ["radio_needle",   "radio_needle",       "dsh","dshl","bd1",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":-0.163, "y":0, "z":0}, 0, 1, -0.515, 1],
     
        ["radio_buttons1", "radio_buttons.1",    "dsh","dshl","bd1",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],
        ["radio_buttons2", "radio_buttons.2",    "dsh","dshl","bd1",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],
        ["radio_buttons3", "radio_buttons.3",    "dsh","dshl","bd1",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],
        ["radio_buttons4", "radio_buttons.4",    "dsh","dshl","bd1",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],
        ["radio_buttons5", "radio_buttons.5",    "dsh","dshl","bd1",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],


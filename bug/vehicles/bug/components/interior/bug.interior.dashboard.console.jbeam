{

// --- Console cage

"bug_radio": {
    "information":{
        "authors":"MrX13415",
        "name":"Radio",
        "value":300,
    },
    "slotType" : "bug_console_cage",
    "slots": [
        ["type", "default", "description"],

        ["skin_console", "skin_console_silver", "Color", {"coreSlot": true}],

        ["bug_radio_mode", "bug_radio_mode_interior", "Mode", {"coreSlot": true}],
        ["bug_radio_output", "bug_radio_output_2D", "Output", {"coreSlot": true}],
        // No longer used["bug_radio_station", "radio_station_piano", "Radio Station"],
    ],
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],

        ["volDown",        "",   "dsh","dshl","dsh2", "box", {"x":0.01, "y":0.02, "z":0.02}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":0.0683, "y":-0.1270, "z":-0.0635}],
        ["volUp",      "",   "dsh","dshl","dsh2", "box", {"x":0.01, "y":0.02, "z":0.02}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":0.0583, "y":-0.1270, "z":-0.0635}],
        
        ["tunePreset1",  "",   "dsh","dshl","dsh2", "box", {"x":0.012, "y":0.02, "z":0.006}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.02779, "y":-0.1095, "z":-0.05}],
        ["tunePreset2",  "",   "dsh","dshl","dsh2", "box", {"x":0.012, "y":0.02, "z":0.006}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x": 0.01079, "y":-0.1095, "z":-0.05}],
        ["tunePreset3",  "",   "dsh","dshl","dsh2", "box", {"x":0.012, "y":0.02, "z":0.006}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.00621, "y":-0.1095, "z":-0.05}],
        ["tunePreset4",  "",   "dsh","dshl","dsh2", "box", {"x":0.012, "y":0.02, "z":0.006}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.02321, "y":-0.1095, "z":-0.05}],
        ["tunePreset5",  "",   "dsh","dshl","dsh2", "box", {"x":0.012, "y":0.02, "z":0.006}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.04021, "y":-0.1095, "z":-0.05}],

        ["tuneDown",  "",   "dsh","dshl","dsh2", "box", {"x":0.01, "y":0.02, "z":0.02}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.0683, "y":-0.1270, "z":-0.0635}],
        ["tuneUp",    "",   "dsh","dshl","dsh2", "box", {"x":0.01, "y":0.02, "z":0.02}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.0783, "y":-0.1270, "z":-0.0635}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],        

        ["volDown", "action0", "volDown"],
        ["volDown", "action1", "radioOff"],
        ["volDown", "action2", "radioOff"],
        ["volUp", "action0", "volUp"],
        ["volUp", "action1", "radioOff"],
        ["volUp", "action2", "radioOff"],

        ["tunePreset1", "action0", "tunePreset1"],
        ["tunePreset2", "action0", "tunePreset2"],
        ["tunePreset3", "action0", "tunePreset3"],
        ["tunePreset4", "action0", "tunePreset4"],
        ["tunePreset5", "action0", "tunePreset5"],

        ["tunePreset1", "action1", "setPreset1"],
        ["tunePreset2", "action1", "setPreset2"],
        ["tunePreset3", "action1", "setPreset3"],
        ["tunePreset4", "action1", "setPreset4"],
        ["tunePreset5", "action1", "setPreset5"],

        ["tunePreset1", "action2", "setPreset1"],
        ["tunePreset2", "action2", "setPreset2"],
        ["tunePreset3", "action2", "setPreset3"],
        ["tunePreset4", "action2", "setPreset4"],
        ["tunePreset5", "action2", "setPreset5"],
        
        ["tuneDown", "action0", "tuneDown"],
        ["tuneDown", "action1", "tunePrev"],
        ["tuneDown", "action2", "tunePrev"],
        ["tuneUp", "action0", "tuneUp"],
        ["tuneUp", "action1", "tuneNext"],
        ["tuneUp", "action2", "tuneNext"],
    ],
    "events":[
        ["id", "title", "desc"],
        // TODO: texts
        ["radioOff",  "ui.inputActions.bug.volDown.title", "ui.inputActions.bug.volDown.description", {"onDown":"radio.setState(false)"}],

        ["volDown",  "ui.inputActions.bug.volDown.title", "ui.inputActions.bug.volDown.description", {"onDown":"radio.volumeDown()"}],
        ["volUp",  "ui.inputActions.bug.volUp.title", "ui.inputActions.bug.volUp.description", {"onDown":"radio.volumeUp()"}],

        ["tunePreset1",  "ui.inputActions.bug.tunepreset1.title", "ui.inputActions.bug.tunepreset1.description", {"onDown":"radio.tunePreset(1)"}],
        ["tunePreset2",  "ui.inputActions.bug.tunepreset2.title", "ui.inputActions.bug.tunepreset2.description", {"onDown":"radio.tunePreset(2)"}],
        ["tunePreset3",  "ui.inputActions.bug.tunepreset3.title", "ui.inputActions.bug.tunepreset3.description", {"onDown":"radio.tunePreset(3)"}],
        ["tunePreset4",  "ui.inputActions.bug.tunepreset4.title", "ui.inputActions.bug.tunepreset4.description", {"onDown":"radio.tunePreset(4)"}],
        ["tunePreset5",  "ui.inputActions.bug.tunepreset5.title", "ui.inputActions.bug.tunepreset5.description", {"onDown":"radio.tunePreset(5)"}],

        ["setPreset1",  "ui.inputActions.bug.tunepreset1.title", "ui.inputActions.bug.tunepreset1.description", {"onDown":"radio.setPreset(1)"}],
        ["setPreset2",  "ui.inputActions.bug.tunepreset2.title", "ui.inputActions.bug.tunepreset2.description", {"onDown":"radio.setPreset(2)"}],
        ["setPreset3",  "ui.inputActions.bug.tunepreset3.title", "ui.inputActions.bug.tunepreset3.description", {"onDown":"radio.setPreset(3)"}],
        ["setPreset4",  "ui.inputActions.bug.tunepreset4.title", "ui.inputActions.bug.tunepreset4.description", {"onDown":"radio.setPreset(4)"}],
        ["setPreset5",  "ui.inputActions.bug.tunepreset5.title", "ui.inputActions.bug.tunepreset5.description", {"onDown":"radio.setPreset(5)"}],

        ["tuneDown",  "ui.inputActions.bug.tuneDown.title", "ui.inputActions.bug.tuneDown.description", {"onChange":"radio.tuneDown(VALUE)"}],
        ["tuneUp",  "ui.inputActions.bug.tuneUp.title", "ui.inputActions.bug.tuneUp.description", {"onChange":"radio.tuneUp(VALUE)"}],

        ["tunePrev",  "ui.inputActions.bug.tunePrev.title", "ui.inputActions.bug.tunePrev.description", {"onDown":"radio.tuneDown()"}],
        ["tuneNext",  "ui.inputActions.bug.tuneNext.title", "ui.inputActions.bug.tuneNext.description", {"onDown":"radio.tuneUp()"}],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
	
         //old: ["radio", ["bug_dashboard"]],
         ["radio_frame",        ["bug_dashboard"]],
         //["radio_buttons",      ["bug_dashboard"]],
        // ["radio_knobs",        ["bug_dashboard"]],
         ["radio_knobs_socket", ["bug_dashboard"]],
         ["radio_text",         ["bug_dashboard"]],

         ["radio_speaker",      ["bug_dashboard"]],
    ],
    "props": [
        ["func",           "mesh",               "idRef:", "idX:", "idY:", "baseRotation",          "rotation",             "translation",          "min", "max", "offset", "multiplier"],

        ["radio_needle",   "radio_needle",       "f4m","f4l","f4tm",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":-0.14, "y":0, "z":0}, 0, 1, -0.5, 1],
     
        ["radio_buttons1", "radio_buttons.1",    "f4m","f4l","f4tm",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],
        ["radio_buttons2", "radio_buttons.2",    "f4m","f4l","f4tm",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],
        ["radio_buttons3", "radio_buttons.3",    "f4m","f4l","f4tm",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],
        ["radio_buttons4", "radio_buttons.4",    "f4m","f4l","f4tm",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],
        ["radio_buttons5", "radio_buttons.5",    "f4m","f4l","f4tm",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],

        ["radio_needle",   "radio_knobs_tune",   "f4m","f4l","f4tm",       {"x":0, "y":0, "z":0},  {"x":0, "y":-1, "z":0},  {"x":0, "y":0, "z":0}, 0, 1440, 0, 1440],
        ["radio_volume",   "radio_knobs_volume", "f4m","f4l","f4tm",       {"x":0, "y":0, "z":0},  {"x":0, "y":-1, "z":0},  {"x":0, "y":0, "z":0}, 0, 360, 90, 300],
    ]
},



// --- Other

"bug_glovebox": {
    "information":{
        "authors":"MrX13415",
        "name":"Glovebox",
        "value":300,
    },
    "slotType" : "bug_glovebox",
    "controller": [
        ["fileName"],
        ["advancedCouplerControl", {"name":"gloveboxCoupler"}],
    ],
    "gloveboxCoupler":{
        "groupType": "autoCoupling",
        "couplerNodes":[
            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpeed"],
            ["dgb5",    "dgb4",    2000,                  0.01,                   0.005,                      0.2]
        ],
        "attachSoundVolume":1,
        "detachSoundVolume":1,
        "soundNode:":["dgb4"],
        "attachSoundEvent": "glovebox_close",
        "detachSoundEvent": "glovebox_open",
        "breakSoundEvent":"",
        "openForceMagnitude": 10,
        "openForceDuration": 0.1,
        "closeForceMagnitude": 50,
        "closeForceDuration": 0.8
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["dashboard_glovebox_hatch", ["bug_glovebox"]],
         ["dashboard_glovebox_case", ["bug_body", "bug_dashboard"]],
    ],
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["gloveboxLatch", "", "dgb1l","dgb1r","dgb2l", "box", {"x":0.02, "y":0.015, "z":0.02}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.1547, "y":0.103, "z":-0.013}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],
        ["gloveboxLatch", "action0", "gloveboxLatch"],   // default: left mouse btn
    ],
    "events":[
        ["id", "title", "desc"],
        // TODO: Where are these texts shown?
        ["gloveboxLatch", "ui.inputActions.bug.gloveboxLatch.title", "ui.inputActions.bug.gloveboxLatch.description", {"onUp":"controller.getControllerSafe('gloveboxCoupler').toggleGroup()"}],
    ],
    "nodes": [
        //dash anti-deform nodes
        {"selfCollision":true},
        {"group": "bug_glovebox"},

        //dash nodes
        {"nodeWeight": 0.5},
        ["dgb1l", -0.12132, -0.53654, 0.88347],
        ["dgb1r", -0.45869, -0.55879, 0.87663],
        ["dgb2l", -0.12132, -0.54466, 1.01010],
        ["dgb2r", -0.45869, -0.56279, 0.98610],
        ["dgb3",  -0.28617, -0.58279, 0.97],


        {"group": ""},
        {"collision":false},
        {"selfCollision":false},
        ["dgb4",  -0.28617, -0.50279, 1.01610, {"couplerTag":"gloveboxLatch","couplerLock":true,"couplerStrength":2000,"couplerRadius":1.35,"couplerStartRadius":0.2,"couplerLockRadius":0.05,"couplerLatchSpeed":0.8, "breakGroup":"gloveboxLatch"}],
        ["dgb5",  -0.28617, -0.50279, 1.01610, {"tag":"gloveboxLatch"}],
    ],
    "beams": [
        {"beamPrecompression":1.0},

        {"disableMeshBreaking":false},
        {"beamSpring":501000,"beamDamp":100},
        {"beamDeform":15000,"beamStrength":"FLT_MAX"},
        {"group": "bug_glovebox"},
        ["dgb1l", "dgb1r"],
        ["dgb2l", "dgb2r"],
        ["dgb1l", "dgb2l"],
        ["dgb1r", "dgb2r"],
        ["dgb1l", "dgb2r"],
        ["dgb1r", "dgb2l"],

        ["dgb1l", "dgb3"],
        ["dgb1r", "dgb3"],
        ["dgb2l", "dgb3"],
        ["dgb2r", "dgb3"],
        ["dgb4",  "dgb3"],


        {"group": ""},
        {"beamSpring":201000,"beamDamp":100},
        {"beamDeform":30000,"beamStrength":"FLT_MAX"},
        ["dgb1l", "dgb4"],
        ["dgb1r", "dgb4"],
        ["dgb2l", "dgb4"],
        ["dgb2r", "dgb4"],
        ["dgb5", "bd1rr"],
        ["dgb5", "bd1r"],
        ["dgb5", "bd1"],
        ["dgb5", "dsh"],
        ["dgb5", "dshr"],

        {"breakGroup":"glovebox"},
        {"beamDeform":15000,"beamStrength":6000},
        ["dgb1l", "dsh"],
        ["dgb1l", "dshr"],
        ["dgb1l", "bd1"],
        ["dgb1l", "bf8r"],
        ["dgb1r", "dsh"],
        ["dgb1r", "dshr"],
        ["dgb1r", "bf8r"],
        ["dgb1r", "bd1rr"],

        //gas struts
        {"breakGroupType":1},
        {"breakGroup":"glovebox"},
        {"beamType":"|SUPPORT", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":500,"beamDamp":100},
        {"beamDeform":4000,"beamStrength":6000},
        {"beamPrecompression":0.8},
        ["dgb2l", "f4tm"],
        ["dgb2l", "f4r"],
        {"beamPrecompression":1},

        {"beamPrecompression":1, "beamType":"|BOUNDED", "beamShortBound":1},
        {"beamSpring":0,"beamDamp":100},
        {"beamLimitSpring":601000,"beamLimitDamp":150},
        {"beamDeform":2000,"beamStrength":6000},
        ["dgb2l", "bd1r", {"beamLongBound":0.7}],
        ["dgb2r", "bd1r", {"beamLongBound":0.4}],

        // limiter
        {"beamType":"|SUPPORT", "beamLongBound":4},
        {"beamSpring":601000,"beamDamp":120},
        {"beamDeform":14000,"beamStrength":6000},
        {"beamPrecompression":1.001},
        ["dgb2l", "bc2r"],
        ["dgb2r", "bc2r"],
        {"beamPrecompression":1.0},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"breakGroup":""},
        {"breakGroupType":0},
        {"group": ""},
    ]
},

        ["radio_buttons3", "radio_buttons.3",    "dsh","dshl","bd1",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],
        ["radio_buttons4", "radio_buttons.4",    "dsh","dshl","bd1",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],
        ["radio_buttons5", "radio_buttons.5",    "dsh","dshl","bd1",       {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":0},  {"x":0, "y":0, "z":-0.01}, -1, 1, 0, 1],


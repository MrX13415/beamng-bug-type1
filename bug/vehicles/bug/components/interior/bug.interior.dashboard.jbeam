        ["wipers", "action1", "wipersdown"],
        ["wipers", "action2", "wipersdown"],

        ["parkingbreak", "action0", "common:parkingbrake"],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
	
        ["bug_dashboard_cables", ["bug_dashboard"]],

        // old: ["bug_dashboard_ashtray",     ["bug_body", "bug_dashboard"]],  // Converted to prop
        ["bug_dashboard_ashtray_box",     ["bug_body", "bug_dashboard"]],        

        ["bug_controls_dashboard_knobs",  ["bug_body", "bug_dashboard"]],
        ["bug_controls_hood_release",     ["bug_body", "bug_dashboard"]],

        ["bug_controls_heating_valve",    ["bug_frame", "bug_body"]],
        ["bug_controls_shifter_M_mount",  ["bug_frame", "bug_body"]],
        ["bug_controls_handbreak_case",   ["bug_frame", "bug_body"]],
    ],
    "glowMap":{
        // dashboard gauges
        "bug_gauges":               {"simpleFunction":"power__gauges",  "off":"bug_gauges",         "on":"bug_gauges_light",         "on_intense":"bug_gauges_light", "materialEmissiveScaling":{"on_max":0.49}},
        "bug_speedometer":          {"simpleFunction":"power__gauges",  "off":"bug_speedometer",    "on":"bug_speedometer_light",    "on_intense":"bug_speedometer_light", "materialEmissiveScaling":{"on_max":0.49}},
        "bug_tachometer":           {"simpleFunction":"power__gauges",  "off":"bug_tachometer",     "on":"bug_tachometer_light",     "on_intense":"bug_tachometer_light", "materialEmissiveScaling":{"on_max":0.49}},
        "bug_oil_ammeter":          {"simpleFunction":"power__gauges",  "off":"bug_oil_ammeter",    "on":"bug_oil_ammeter_light",    "on_intense":"bug_oil_ammeter_light", "materialEmissiveScaling":{"on_max":0.49}},
        "bug_speedo_needle":        {"simpleFunction":"power__gauges",  "off":"bug_speedo_needle",  "on":"bug_speedo_needle_light",  "on_intense":"bug_speedo_needle_light", "materialEmissiveScaling":{"on_max":0.49}},
        "bug_tacho_needle":         {"simpleFunction":"power__gauges",  "off":"bug_tacho_needle",   "on":"bug_speedo_needle_light",  "on_intense":"bug_speedo_needle_light", "materialEmissiveScaling":{"on_max":0.49}},
        "bug_clock_back":           {"simpleFunction":"power__gauges",  "off":"bug_clock_back",     "on":"bug_clock_light",          "on_intense":"bug_clock_light", "materialEmissiveScaling":{"on_max":0.49}},
        "bug_clock_needle":         {"simpleFunction":"power__gauges",  "off":"bug_clock_needle",   "on":"bug_clock_needle_light",   "on_intense":"bug_clock_needle_light", "materialEmissiveScaling":{"on_max":0.49}},

        // dashboard lights
        "bug_dash_light_signal":    {"simpleFunction":"power__signal_dash",               "off":"bug_dash_light_signal",   "on":"bug_dash_light_signal_on",  "on_intense":"bug_dash_light_signal_on", "materialEmissiveScaling":{"on_max":0.49}},
        "bug_dash_light_highbeam":  {"simpleFunction":"power__highbeam",                                 "off":"bug_dash_light_highbeam", "on":"bug_dash_light_on",         "on_intense":"bug_dash_light_on", "materialEmissiveScaling":{"on_max":0.49}},
        // use the "oil" LED to indicate regeneration beeing active (blinking).
        "bug_dash_light_oil":       {"simpleFunction":{"power__oilpressure_low": 0.3, "power__oil":0.3, "power__regeneration":0.3},            "off":"bug_dash_light_oil",      "on":"bug_dash_light_on",         "on_intense":"bug_dash_light_on", "materialEmissiveScaling":{"on_max":0.3}},
        "bug_dash_light_engine":    {"simpleFunction":{"power__generatorPower_low": 0.3, "power__checkengine":0.3},             "off":"bug_dash_light_engine",   "on":"bug_dash_light_on",         "on_intense":"bug_dash_light_on", "materialEmissiveScaling":{"on_max":0.3}},
    },
    "props": [
        ["func",         "mesh",      "idRef:", "idX:", "idY:", 		"baseRotation",           "rotation",                 "translation",        		"min", "max", "offset", "multiplier"],

        ["ashtray_anim", "bug_dashboard_ashtray_prop",  "dsh","dshl","bd1",   {"x":0, "y":0, "z":0},   {"x":0, "y":0, "z":0},    {"x":0, "y":0, "z":0.075},        0,     1,        0,  1],

        ["lights_state", "bug_controls_dashboard_light_knob",  "dsh","dshl","bd1",   {"x":0, "y":0, "z":0},   {"x":0, "y":0, "z":0},    {"x":0, "y":0, "z":0.005},        0,    2,        0,  1],
        ["wipersstate", "bug_controls_dashboard_wiper_knob",  "dsh","dshl","bd1",   {"x":0, "y":0, "z":0},   {"x":0, "y":0, "z":0},    {"x":0, "y":0, "z":0.005},        0,     3,        0,  1],

        ["turnsignal",   "bug_indicatorlever",    "steer2","steer3","steer1",   {"x":0, "y":0, "z":180},   {"x":0, "y":0, "z":7},    {"x":0, "y":0, "z":0},          -1,       1,      0, -1],
        ["parkingbrake_anim", "bug_controls_handbreak",  "f4mr","f4ml","refup",   {"x":0, "y":0, "z":0},   {"x":10, "y":0, "z":0},    {"x":0, "y":0, "z":0},          -1,       1,      0, -1],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        //dash anti-deform nodes
        {"collision":false},
        {"selfCollision":false},
        
        {"group": "bug_dashboard"},

        //dash nodes
        {"nodeWeight": 1.1},
        ["dshl", 0.50000, -0.57000, 0.83000],
        ["dshr", -0.50000, -0.57000, 0.83000],
        ["dsh", 0.00000, -0.57000, 0.83000, {"nodeWeight": 2.0}],
        ["dsh2", 0.00000, -0.57000, 0.40000],

        // speaker node
        {"group": ""},
        ["speaker", 0.395000, -0.59000, 0.93800],

        {"collision":true},
        {"selfCollision":false},
    ],
    "beams": [
        ["id1:", "id2:"],

        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1.0},
        {"beamSpring":1001000,"beamDamp":50},
        {"beamDeform":8000,"beamStrength":"FLT_MAX"},

        //dashboard
        {"deformGroup":"dashboard_break","deformationTriggerRatio":0.025},
        ["dsh", "dsh2"],
        ["dsh", "dshl"],
        ["dsh2", "dshl"],
        ["dsh", "dshr"],
        ["dsh2", "dshr"],


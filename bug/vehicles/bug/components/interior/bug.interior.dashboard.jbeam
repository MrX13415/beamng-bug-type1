// --- Speedo

"bug_speedo_mph_90": {
    "information":{
        "authors":"MrX13415",
        "name":"Imperial Speedometer",
        "value":300,
    },
    "slotType" : "skin_speedometer",
    "skinName" : "mph90",
    "slots": [
        ["type", "default", "description"],

        ["bug_odometer", "bug_odometer_imperial", "Odometer", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
	
        ["dashboard_gauge_speedo", ["bug_dashboard"]],
    ],
    "props": [
        ["func",   "mesh",   "idRef:", "idX:", "idY:",   "baseRotation",   "rotation",   "translation",   "min", "max", "offset", "multiplier"],

        // a = angle range of the needle. (all angles in deg)
        // m = speed in km/h or mph on the max angle of the needle.
        // d = angle between target zero pos. and the "default" pos of the mesh.
        // x = 3.6 for km/h and 2.23694 for mph
        //
        // rotation-y = a / (m / x)
        //     offset = d / rotation-y
        //        max = a / rotation-y
        //
        //    270 / (140 / 2.23694) = 6.71082
        //    135 / 6.94286 = 20.11677
        //    270 / 6.94286 = 40.23353
        //
        ["wheelspeed",   "needle_speedo",   "dsh","dshl","bd1",   {"x":5, "y":-0, "z":-4},   {"x":0, "y":-6.71082, "z":0},   {"x":0, "y":0, "z":0},   0, 40.23353, -20.11677, 1],
    ],
},
"bug_speedo_km_140": {
    "information":{
        "authors":"MrX13415",
        "name":"Metric Speedometer (140 km/h)",
        "value":300,
    },
    "slotType" : "skin_speedometer",
    "skinName" : "km140",
    "slots": [
        ["type", "default", "description"],

        ["bug_odometer", "bug_odometer_metric", "Odometer", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
	
        ["dashboard_gauge_speedo", ["bug_dashboard"]],
    ],
    "props": [
        ["func",         "mesh",      "idRef:", "idX:", "idY:", 		"baseRotation",           "rotation",                 "translation",        		"min", "max", "offset", "multiplier"]

        // a = angle range of the needle. (all angles in deg)
        // m = speed in km/h or mph on the max angle of the needle.
        // d = angle between target zero pos. and the "default" pos of the mesh.
        // x = 3.6 for km/h and 2.23694 for mph
        //
        // rotation-y = a / (m / x)
        //     offset = d / rotation-y
        //        max = a / rotation-y
        //
        //    270 / (140 / 3.6) = 6.94286
        //    135 / 6.94286 = 19.44444
        //    270 / 6.94286 = 38.88887
        //
        ["wheelspeed",   "needle_speedo",   "dsh","dshl","bd1",   {"x":5, "y":-0, "z":-4},   {"x":0, "y":-6.94286, "z":0},   {"x":0, "y":0, "z":0},   0, 38.88887, -19.44444, 1],
    ],
},
"bug_speedo_km_200": {
    "information":{
        "authors":"MrX13415",
        "name":"Metric Speedometer (200 km/h)",
        "value":300,
    },
    "slotType" : "skin_speedometer",
    "skinName" : "km200",
    "slots": [
        ["type", "default", "description"],

        ["bug_odometer", "bug_odometer_metric", "Odometer", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
	
        ["dashboard_gauge_speedo", ["bug_dashboard"]],
    ],
    "props": [
        ["func",         "mesh",      "idRef:", "idX:", "idY:", 		"baseRotation",           "rotation",                 "translation",        		"min", "max", "offset", "multiplier"]

        // a = angle range of the needle. (all angles in deg)
        // m = speed in km/h or mph on the max angle of the needle.
        // d = angle between target zero pos. and the "default" pos of the mesh.
        // x = 3.6 for km/h and 2.23694 for mph
        //
        // rotation-y = a / (m / x)
        //     offset = d / rotation-y
        //        max = a / rotation-y
        //
        //    270 / (200 / 3.6) = 4.86
        //    135 / 4.86 = 27.77778
        //    270 / 4.86 = 55.55556
        //
        ["wheelspeed",   "needle_speedo",   "dsh","dshl","bd1",   {"x":5, "y":-0, "z":-4},   {"x":0, "y":-4.86, "z":0},   {"x":0, "y":0, "z":0},   0, 55.55556, -27.77778, 1],
    ],
},



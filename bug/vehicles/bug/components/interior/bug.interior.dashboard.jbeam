        ["bug_dashboard_handle", "", "Grab Handle"],
        ["bug_dashboard_backcover", "bug_dashboard_backcover", "Back Cover"],
        ["bug_ignition", "bug_ignition_stage3", "Ignition", {"coreSlot":true}],

        ["bug_gps", "", "Navigation Unit", {"nodeMove": {"x":0.0,"y":-0.475,"z":1.09}}],
    ],
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["hood_int",     "dshl","dsh","dsh2", "sphere", 0.014, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.099, "y":0.158, "z":-0.12},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
        ["ashtray",      "dsh","dshl","dsh2", "sphere", 0.01, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":0.0, "y":-0.029, "z":-0.044},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
        
        ["headlights",   "dsh","dshl","dsh2", "sphere", 0.01, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":0.069, "y":-0.1745, "z":-0.048},{"color":[1,0.3,0,0], "alphaOnUsed":0}],
        ["wipers",       "dsh","dshl","dsh2", "sphere", 0.01, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.069, "y":-0.1745, "z":-0.048},{"color":[1,0.3,0,0], "alphaOnUsed":0}],

        ["parkingbreak", "f4mr","f4ml","refup", "box", {"x":0.02, "y":0.09, "z":0.07}, {"x":-11, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":0.074, "y":0.202, "z":-0.16},{"color":[1,0.3,0,0], "alphaOnUsed":0}]
    ],
    "actionsEnabled": [
        ["id"],
        ["ashtraytoggle"],

        ["wiperstoggle"],
        ["wipersdown"],
        ["wipersup"],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],        
        
        ["ashtray", "action0", "ashtraytoggle"],

        ["headlights", "action0", "common:toggle_headlights"],
        ["headlights", "action1", "common:toggle_headlights"],
        ["headlights", "action2", "common:toggle_headlights"],

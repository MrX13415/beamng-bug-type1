        ["dsh2", "bf8r"],

        // dashboard <> frame
        {"beamStrength":50000, "breakGroup": "body"},
        ["dsh", "f2tm"],
        ["dsh", "f3tm"],
        ["dsh", "f4tm"],
        ["dshl", "f2l"],
        ["dshl", "f3l"],
        ["dshl", "f3r"],

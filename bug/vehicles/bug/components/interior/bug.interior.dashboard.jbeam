"bug_speedo_mph_90": {
    "information":{
        "authors":"MrX13415",
        "name":"Imperial Speedometer (90 mph)",
        "value":30,
    },
    "electricPower":[
        ["power"],
        [4, {"trigger": "electrics.values.lowhighbeam"}],
    ],
    "slotType" : "skin_speedometer",
    "skinName" : "mph90",
    "slots": [
        ["type", "default", "description"],

        ["bug_odometer", "bug_odometer_imperial", "Odometer", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
	
        ["bug_dashboard_gauge_speedo", ["bug_dashboard"]],
        {"deformGroup":"dashboard_break", "deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound1", "deformVolume":0.8, "deformMaterialBase":"bug_interior_glass", "deformMaterialDamaged":"bug_interior_glass_dmg"},
        ["bug_dashboard_gauge_speedo_glass", ["bug_dashboard"]],
        {"deformGroup":""},
    ],
    "props": [
        ["func",   "mesh",   "idRef:", "idX:", "idY:",   "baseRotation",   "rotation",   "translation",   "min", "max", "offset", "multiplier"],

        // a = angle range of the needle. (all angles in deg)
        // m = speed in km/h or mph on the max angle of the needle.
        // d = angle between target zero pos. and the "default" pos of the mesh.
        // x = 3.6 for km/h and 2.23694 for mph
        //
        // rotation-y = a / (m / x)
        //     offset = d / rotation-y
        //        max = a / rotation-y
        //
        //    270 / (140 / 2.23694) = 6.71082
        //    135 / 6.94286 = 20.11677
        //    270 / 6.94286 = 40.23353
        //
        ["wheelspeed",   "bug_needle_speedo",   "dsh","dshl","bd1",   {"x":5, "y":-0, "z":-4},   {"x":0, "y":-6.71082, "z":0},   {"x":0, "y":0, "z":0},   0, 40.23353, -20.11677, 1],
    ],
},

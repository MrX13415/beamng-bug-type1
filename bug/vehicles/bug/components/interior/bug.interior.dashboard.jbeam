// --- Shifter

"bug_shifter_M": {
    "information":{
        "authors":"MrX13415",
        "name":"Manual Shifter",
        "value":280,
    },
    "slotType" : "bug_shifter",
    "controller": [
        ["fileName"],
        ["propAnimation/hPattern", {"name":"hPattern"}],
    ],
    "hPattern": {
        "gearCoordinates": [
            ["gearIndex",  "x",  "y"],

            [-1,            1,   -1],
            [ 0,            0,    0],
            [ 1,           -1,    1],
            [ 2,           -1,   -1],
            [ 3,            0,    1],
            [ 4,            0,   -1],
            [ 5,            1,    1]
        ],
        "shiftSoundNode:":["sh_b5"],
        "shiftSoundEventHPatternGearIn": "event:>Vehicle>Interior>Gearshift>manual_modern_06_in",
        "shiftSoundEventHPatternGearOut": "event:>Vehicle>Interior>Gearshift>manual_modern_06_out",
        "shiftSoundVolumeHPatternGearIn": 1,
        "shiftSoundVolumeHPatternGearOut": 1,
    },

        ["skin_tachometer", "bug_tacho_6000", "Max RPM", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
	
        ["bug_dashboard_frame_left_tacho",  ["bug_dashboard"]],
    ]
},
"bug_tacho_6000": {
    "information":{
        "authors":"MrX13415",
        "name":"6000 RPM",
        "value":200,
    },    
    "slotType" : "skin_tachometer",
    "skinName" : "6000",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
	
        ["bug_dashboard_gauges_tacho",       ["bug_dashboard"]],
        {"deformGroup":"dashboard_break", "deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound1", "deformVolume":0.8, "deformMaterialBase":"bug_interior_glass", "deformMaterialDamaged":"bug_interior_glass_dmg"},
        ["bug_dashboard_gauges_tacho_glass", ["bug_dashboard"]],
        {"deformGroup":""},
    ],
    "props": [
        ["func",   "mesh",   "idRef:", "idX:", "idY:",   "baseRotation",   "rotation",   "translation",   "min", "max", "offset", "multiplier"],

        // a = angle range of the needle. (all angles in deg)
        // m = rpm on the max angle of the needle.
        // d = angle between target zero pos. and the "default" pos of the mesh.
        //
        // rotation-y = a / m
        //     offset = d / rotation-y
        //        max = a / rotation-y
        //
        //    270 / 6000 = 0.045
        //    135 / 0.045 = 3000
        //    270 / 0.045 = 6000
        //

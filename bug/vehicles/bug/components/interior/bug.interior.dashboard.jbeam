"bug_tacho_6000": {
    "information":{
        "authors":"MrX13415",
        "name":"6000 RPM",
        "value":200,
    },    
    "slotType" : "skin_tachometer",
    "skinName" : "6000",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
	
        ["dashboard_gauges_tacho",      ["bug_dashboard"]],
    ],
    "props": [
        ["func",   "mesh",   "idRef:", "idX:", "idY:",   "baseRotation",   "rotation",   "translation",   "min", "max", "offset", "multiplier"],

        // a = angle range of the needle. (all angles in deg)
        // m = rpm on the max angle of the needle.
        // d = angle between target zero pos. and the "default" pos of the mesh.
        //
        // rotation-y = a / m
        //     offset = d / rotation-y
        //        max = a / rotation-y
        //
        //    270 / 6000 = 0.045
        //    135 / 0.045 = 3000
        //    270 / 0.045 = 6000
        //
        ["rpm",   "needle_tacho",   "dsh","dshl","bd1",   {"x":4, "y":-0, "z":-4},   {"x":0, "y":-0.045, "z":0},   {"x":0, "y":0, "z":0},   0, 6000, -3000, 1],
    ]
},

         ["sh_l1",  0.000, -0.483821, 0.673],
         {"selfCollision":false},
         {"nodeWeight":0.30},
         {"group":["bug_shifter_M"]},
         ["sh_l2",  0.030, -0.539, 0.530],
         ["sh_l3", -0.030, -0.539, 0.530],
         ["sh_l4",  0.030, -0.487, 0.530],
         ["sh_l5", -0.030, -0.487, 0.530],
         {"selfCollision":true},
         {"group":""},

{

"bug_dashboard": {
    "information":{
        "authors": "MrX13415",
        "name": "Dashboard",
        "value": 300,
    },
    "slotType" : "bug_dashboard",
    "slots": [
        ["type", "default", "description"],

        ["bug_shifter", "bug_shifter_M", "Shifter"],
        ["skin_speedometer", "bug_speedo_km_140", "Speedometer", {"coreSlot":true}],
        ["bug_tachometer", "bug_tacho_empty", "Tachometer", {"coreSlot":true}],
        ["skin_interior_theme", "bug_inputs_white", "Controls"],
        
        ["bug_gauges_console", "", "Oil Pressure & Ammeter"],
        ["bug_console_cage", "bug_console_cover", "Console"],
        ["bug_console_clock", "", "Clock"],
        ["bug_glovebox", "bug_glovebox", "Glovebox", {"coreSlot":true}],
        ["bug_shelf", "", "Shelf"],
        ["bug_dashboard_handle", "", "Grab Handle"],
        ["bug_ignition_key", "bug_ignition_key", "Ignition Key", {"coreSlot":true}],

        ["bug_gps", "", "Navigation Unit", {"nodeMove": {"x":0.0,"y":-0.475,"z":1.09}}],
    ],
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["hood_int", "Hood Release", "dshl","dsh","dsh2", "box", {"x":0.04, "y":0.04, "z":0.04}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.095, "y":0.127, "z":-0.14}],
        ["ashtray",  "",             "dsh","dshl","dsh2", "box", {"x":0.02, "y":0.02, "z":0.02}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.01, "y":-0.04, "z":-0.035}],
        ["ignition",  "",            "dsh","dshl","dsh2", "box", {"x":0.02, "y":0.02, "z":0.02}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":0.061, "y":-0.04, "z":-0.03}],
        
        ["headlights", "",           "dsh","dshl","dsh2", "box", {"x":0.02, "y":0.03, "z":0.02}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":0.059, "y":-0.1845, "z":-0.05}],
        ["wipers",  "",              "dsh","dshl","dsh2", "box", {"x":0.02, "y":0.03, "z":0.02}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0},{"x":-0.079, "y":-0.1845, "z":-0.05}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],        
        
        ["ashtray", "action0", "ashtray"],

        ["ignition", "action0", "ignition"],
        ["ignition", "action1", "ignition"],
        ["ignition", "action2", "ignition"],

        ["headlights", "action0", "headlights"],
        ["headlights", "action1", "headlights"],
        ["headlights", "action2", "headlights"],
        ["wipers", "action0", "wipersToggle"],
        ["wipers", "action1", "wipersDown"],
        ["wipers", "action2", "wipersDown"],
    ],
    "events":[
        ["id", "title", "desc"],
        // TODO: texts
        ["ashtray",  "ui.inputActions.bug.ashtray.title", "ui.inputActions.bug.ashtray.description", {"onUp":"vehicle.toggleAshTray()"}],
        ["ignition",  "ui.inputActions.bug.ignition.title", "ui.inputActions.bug.ignition.description", {"onDown":"electrics.toggleIgnitionLevelOnDown()", "onUp":"electrics.toggleIgnitionLevelOnUp()"}],
        
        ["headlights",  "ui.inputActions.bug.headlights.title", "ui.inputActions.bug.headlights.description", {"onUp":"electrics.toggle_lights()"}],
        
        ["wipersToggle",  "ui.inputActions.bug.wipers.title", "ui.inputActions.bug.wipers.description", {"onUp":"vehicle.toggleWipers()"}],
        ["wipersUp",  "ui.inputActions.bug.wipers.title", "ui.inputActions.bug.wipers.description", {"onUp":"vehicle.wipersUp()"}],
        ["wipersDown",  "ui.inputActions.bug.wipers.title", "ui.inputActions.bug.wipers.description", {"onUp":"vehicle.wipersDown()"}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
	
        ["hood_dashboard_cover",     ["bug_body", "bug_dashboard"]],

        ["dashboard_gauge_fuelgauge",       ["bug_dashboard"]],
        ["dashboard_frame_right_fuelgauge", ["bug_dashboard"]],

        // old: ["dashboard_ashtray",     ["bug_body", "bug_dashboard"]],  // Converted to prop
        ["dashboard_ashtray_box",     ["bug_body", "bug_dashboard"]],        

        ["controls_dashboard_knobs",  ["bug_body", "bug_dashboard"]],
        ["controls_hood_release",     ["bug_body", "bug_dashboard"]],

        ["controls_heating_valve",    ["bug_frame", "bug_body"]],
        ["controls_shifter_M_mount",  ["bug_frame", "bug_body"]],
        ["controls_handbreak_case",   ["bug_frame", "bug_body"]],

        ["body_door_parts",           ["bug_body"]],
        ["door_FL_handles",           ["bug_door_FL"]],
        ["door_FR_handles",           ["bug_door_FR"]],
    ],
    "glowMap":{
        // dashboard gauges
        "bug_gauges":               {"simpleFunction":"lowhighbeam",  "off":"bug_gauges",         "on":"bug_gauges_light",         "on_intense":"bug_gauges_light"},
        "bug_speedometer":          {"simpleFunction":"lowhighbeam",  "off":"bug_speedometer",    "on":"bug_speedometer_light",    "on_intense":"bug_speedometer_light"},
        "bug_tachometer":           {"simpleFunction":"lowhighbeam",  "off":"bug_tachometer",     "on":"bug_tachometer_light",     "on_intense":"bug_tachometer_light"},
        "bug_oil_ammeter":          {"simpleFunction":"lowhighbeam",  "off":"bug_oil_ammeter",    "on":"bug_oil_ammeter_light",    "on_intense":"bug_oil_ammeter_light"},
        "bug_speedo_needle":        {"simpleFunction":"lowhighbeam",  "off":"bug_speedo_needle",  "on":"bug_speedo_needle_light",  "on_intense":"bug_speedo_needle_light"},
        "bug_tacho_needle":         {"simpleFunction":"lowhighbeam",  "off":"bug_tacho_needle",   "on":"bug_speedo_needle_light",  "on_intense":"bug_speedo_needle_light"},
        "bug_clock_back":           {"simpleFunction":"lowhighbeam",  "off":"bug_clock_back",     "on":"bug_clock_light",          "on_intense":"bug_clock_light"},
        "bug_clock_needle":         {"simpleFunction":"lowhighbeam",  "off":"bug_clock_needle",   "on":"bug_clock_needle_light",   "on_intense":"bug_clock_needle_light"},

        // dashboard lights
        "bug_dash_light_signal":    {"simpleFunction":["(signal_L or 0)", "(signal_R or 0)"],     "off":"bug_dash_light_signal",   "on":"bug_dash_light_signal_on",  "on_intense":"bug_dash_light_signal_on"},
        "bug_dash_light_highbeam":  {"simpleFunction":"highbeam",                                 "off":"bug_dash_light_highbeam", "on":"bug_dash_light_on",         "on_intense":"bug_dash_light_on"},
        // use the "oil" LED to indicate regeneration beeing active (blinking)
        "bug_dash_light_oil":       {"simpleFunction":{"oil":0.3, "regeneration":0.6},            "off":"bug_dash_light_oil",      "on":"bug_dash_light_on",         "on_intense":"bug_dash_light_on"},
        "bug_dash_light_engine":    {"simpleFunction":"checkengine",                              "off":"bug_dash_light_engine",   "on":"bug_dash_light_on",         "on_intense":"bug_dash_light_on"},

        // misc
        "bug_radio_scale":          {"simpleFunction":"radio_state",  "off":"bug_radio_scale",    "on":"bug_radio_scale_on",       "on_intense":"bug_radio_scale_on"},
        "bug_radio_needle":         {"simpleFunction":"radio_state",  "off":"bug_radio_needle",   "on":"bug_radio_needle_light",   "on_intense":"bug_radio_needle_light"},
    },
    "props": [
        ["func",         "mesh",      "idRef:", "idX:", "idY:", 		"baseRotation",           "rotation",                 "translation",        		"min", "max", "offset", "multiplier"],

        ["ashtray", "dashboard_ashtray_prop",  "dsh","dshl","bd1",   {"x":0, "y":0, "z":0},   {"x":0, "y":0, "z":0},    {"x":0, "y":0, "z":0.075},        0,     1,        0,  1],

        ["lights_state", "controls_dashboard_light_knob",  "dsh","dshl","bd1",   {"x":0, "y":0, "z":0},   {"x":0, "y":0, "z":0},    {"x":0, "y":0, "z":0.005},        0,    2,        0,  1],
        ["wipersstate", "controls_dashboard_wiper_knob",  "dsh","dshl","bd1",   {"x":0, "y":0, "z":0},   {"x":0, "y":0, "z":0},    {"x":0, "y":0, "z":0.005},        0,     3,        0,  1],

        ["turnsignal",   "indicatorlever",    "f4m","f4l","f4tm",   {"x":-63, "y":0, "z":0},   {"x":0, "y":0, "z":7},    {"x":0, "y":0, "z":0},          -1,       1,      0, -1],
        ["parkingbrake", "controls_handbreak",  "f4m","f4l","f4tm",   {"x":0, "y":0, "z":0},   {"x":10, "y":0, "z":0},    {"x":0, "y":0, "z":0},          -1,       1,      0, -1],

        // base translation would be {"x":0, "y":0, "z":-6} but some adjustment due to the node positons is required.
        ["windowFL_state",    "door_FL_window_handle",  "d14l","d8l","d11l",   {"x":-3, "y":7, "z":9},     {"x":1800, "y":0, "z":0},    {"x":0, "y":0, "z":0},           0,       1,   0,  1],
        ["windowFR_state",    "door_FR_window_handle",  "d14r","d8r","d11r",   {"x":-3, "y":7, "z":168},   {"x":-1800, "y":0, "z":0},    {"x":0, "y":0, "z":0},           0,       1,   0,  1],

        ["fuel",      "needle_fuelgauge",   "dsh","dshl","bd1",  {"x":5, "y":0, "z":-3},  {"x":0, "y":-70, "z":0},  {"x":0, "y":0, "z":0},  0,  1,  -0.5,  1],
        ["ignitionLevel",  "ignition_key",  "dsh","dshl","bd1",  {"x":0, "y":-90, "z":0},  {"x":0, "y":-45, "z":0},  {"x":0, "y":0, "z":0},  0,  3,  0,  1],
    ],
    "nodes": [
        //dash anti-deform nodes
        {"selfCollision":true},
        {"group": "bug_dashboard"},

        //dash nodes
        {"nodeWeight": 1.0},
        ["dshl", 0.50000, -0.57000, 0.83000],
        ["dshr", -0.50000, -0.57000, 0.83000],
        ["dsh", 0.00000, -0.57000, 0.83000],
        ["dsh2", 0.00000, -0.57000, 0.40000],

        // speaker node
        {"group": ""},
        ["speaker", 0.395000, -0.59000, 0.93800],
    ],
    "beams": [

        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1.0},
        {"beamSpring":1001000,"beamDamp":50},
        {"beamDeform":15000,"beamStrength":"FLT_MAX"},
        //dashboard
        ["dsh", "dsh2"],
        ["dsh", "dshl"],
        ["dsh2", "dshl"],
        ["dsh", "dshr"],
        ["dsh2", "dshr"],

        // dashboard <> body
        ["dshl", "bq1l"],
        ["dshl", "bq3l"],
        ["dshr", "bq1r"],
        ["dshr", "bq3r"],
        ["dsh", "bq1l"],
        ["dsh", "bq1r"],
        ["dsh", "bq2l"],
        ["dsh", "bq2r"],
        ["dsh2", "bq2l"],
        ["dsh2", "bq2r"],
        ["dsh2", "bq3l"],
        ["dsh2", "bq3r"],

        ["dshl", "bd1ll"],
        ["dshl", "bd2l"],
        ["dshr", "bd1rr"],
        ["dshr", "bd2r"],
        ["dsh", "bd1l"],
        ["dsh", "bd2"],
        ["dsh", "bd1r"],

        ["dshl", "bc2ll"],
        ["dshl", "bf8l"],
        ["dshl", "bf4l"],
        ["dshl", "bf4r"],
        ["dshr", "bc2rr"],
        ["dshr", "bf8r"],
        ["dshr", "bf4l"],
        ["dshr", "bf4r"],

        ["dsh", "bf4l"],
        ["dsh", "bf4r"],
        ["dsh", "bf8l"],
        ["dsh", "bf8r"],

        ["dsh2", "bf4l"],
        ["dsh2", "bf4r"],
        ["dsh2", "bf8l"],
        ["dsh2", "bf8r"],

        // dashboard <> frame
        {"beamStrength":50000, "breakGroup": "body"},
        ["dsh", "f2tm"],
        ["dsh", "f3tm"],
        ["dsh", "f4tm"],
        ["dshl", "f2l"],
        ["dshl", "f3l"],
        ["dshl", "f3r"],
        ["dshl", "f4l"],
        ["dshr", "f2r"],
        ["dshr", "f3l"],
        ["dshr", "f3r"],
        ["dshr", "f4r"],
        ["dsh2", "f3l"],
        ["dsh2", "f3r"],
        ["dsh2", "f3tm"],
        {"beamStrength":"FLT_MAX", "breakGroup": ""},

        // speaker <> frame
        ["speaker", "f3tm", {"beamStrength":50000, "breakGroup": "body"}],
        ["speaker", "f2l", {"beamStrength":50000, "breakGroup": "body"}],
        ["speaker", "f4l", {"beamStrength":50000, "breakGroup": "body"}],

        // speaker <> body
        ["speaker", "dshl"],
        ["speaker", "dsh"],
        ["speaker", "dsh2"],
        ["speaker", "dshr"],

        //--BLEED DEFORM LIMIT TO OTHER PARTS--
        {"deformLimitExpansion":1.1},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1.0},
    ]
},


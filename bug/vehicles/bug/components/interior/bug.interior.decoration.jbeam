// -- Ignition key fob
"bug_ignition_keyfob": {
    "information":{
        "authors": "BeamNG",
        "name": "Keyfob",
        "value": 10,
    },
    "slotType" : "bug_ignition_keyfob",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["bug_dashboard_keyfob",   ["bug_ignition_keyfob"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        {"nodeMaterial":"|NM_CLOTH"},
        {"collision":true},
        {"selfCollision":true},
        {"nodeWeight":0.2},
        {"group":"bug_ignition_keyfob"},
        ["ikey_f1",  0.086661, -0.530385, 0.808019], 
        ["ikey_f2",  0.055157, -0.530385, 0.808019],
        ["ikey_f3",  0.070912, -0.538514, 0.842946],
        {"group":""},
        {"collision":true},
        {"selfCollision":false}
    ],
    "beams": [
        ["id1:", "id2:"],

        {"disableMeshBreaking":true},
        {"deformLimitExpansion":1.1},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":200000,"beamDamp":50},
        {"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},

        ["ikey_f1","ikey_f2"],
        ["ikey_f2","ikey_f3"],
        ["ikey_f3","ikey_f1"],

        // connection
        {"beamDeform":1500,"beamStrength":1500},
        {"breakGroup":"bug_ignition_keyfob"},
        ["ikey_f1","ikey"],
        ["ikey_f2","ikey"],
        ["ikey_f3","ikey"],

        // damp
        {"beamSpring":20,"beamDamp":5},
        {"breakGroup":"bug_ignition_keyfob"},
        ["ikey_f1","dsh"],
        ["ikey_f2","dsh"],
        ["ikey_f3","dsh"],
        {"breakGroup":""},

        {"disableMeshBreaking":false},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"breakGroup":""},
    ]
},

}

{

"bug_decoration1_tree": {
    "information":{
        "authors": "BeamNG",
        "name": "Air Freshener",
        "value": 8,
    },
    "slotType" : "bug_decoration1",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["bug_deco1_tree",   ["bug_deco1_tree"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        {"nodeMaterial":"|NM_CLOTH"},
        {"collision":true},
        {"selfCollision":true},
        {"nodeWeight":0.2},
        {"group":"bug_deco1_tree"},
        ["id1_tree1", 0.004, -0.375,  1.21, {"selfCollision":false}],
        ["id1_tree2", 0.004, -0.355,  1.17],
        ["id1_tree3", 0.004, -0.395,  1.17],
        {"group":""},
        {"collision":true},
        {"selfCollision":false}
    ],
    "beams": [
        ["id1:", "id2:"],

        {"deformLimitExpansion":1.1},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":200000,"beamDamp":50},
        {"beamDeform":5000,"beamStrength":"FLT_MAX"},

        ["id1_tree1","id1_tree2"],

        ["id1_tree1","id1_tree3"],
        ["id1_tree2","id1_tree3"],

        // dive <> body
        
        {"beamSpring":200000,"beamDamp":50},
        {"beamDeform":1500,"beamStrength":1500},
        {"breakGroup":"bug_deco1_tree"},
        ["id1_tree1","mi5m"],
        ["id1_tree2","mi5m"],
        ["id1_tree3","mi5m"],

        // damp
        {"beamSpring":10,"beamDamp":0.5},
        {"breakGroup":"bug_deco1_tree"},
        ["id1_tree2","mi2ml"],
        ["id1_tree2","mi2mr"],
        {"breakGroup":""},

        // support beams
        {"beamType":"|SUPPORT", "beamLongBound":4},
        {"beamPrecompression":0.988},
        {"beamSpring":10,"beamDamp":2},
        {"breakGroup":"bug_deco1_tree"},
        ["id1_tree2","brf3"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"breakGroup":""},
    ]
},

        ["id", "title", "desc"],
        // TODO: texts
        ["sunvisor_L_toggle", "ui.inputActions.bug.sunvisor_L_toggle.title", "ui.inputActions.bug.sunvisor_L_toggle.description", {"onUp":"vehicle.toggle('sunvisorL')"}],
        ["sunvisor_R_toggle", "ui.inputActions.bug.sunvisor_R_toggle.title", "ui.inputActions.bug.sunvisor_R_toggle.description", {"onUp":"vehicle.toggle('sunvisorR')"}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        {"selfCollision":true},
        {"collision" :true},
        {"nodeMaterial":"|NM_CLOTH"},
        {"frictionCoef":0.7},
        {"nodeWeight":0.5},
        {"group":"bug_sunvisor_L"},
        ["sv1l",  0.41898, -0.34713, 1.34840],
        ["sv2l",  0.08734, -0.34150, 1.36168],
        ["sv3l",  0.41901, -0.24670, 1.38364],
        ["sv4l",  0.08730, -0.24670, 1.39300],        
        {"group":"bug_sunvisor_R"},
        ["sv1r", -0.41898, -0.34713, 1.34840],
        ["sv2r", -0.08734, -0.34150, 1.36168],
        ["sv3r", -0.41901, -0.24670, 1.38364],
        ["sv4r", -0.08730, -0.24670, 1.39300],
        {"group":""},
        ["sv5l",  0.25520, -0.31560, 1.30605, {"selfCollision":false, "collision" :false}],
        ["sv5r", -0.25520, -0.31560, 1.30605, {"selfCollision":false, "collision" :false}],
    ],
    "beams": [
        ["id1:", "id2:"],

        // main
        {"disableMeshBreaking":true},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":100100,"beamDamp":50},
        {"beamDeform":1000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":0},
        // L
        ["sv1l","sv2l"],
        ["sv2l","sv3l"],
        ["sv3l","sv4l"],
        ["sv4l","sv1l"],
        // cross
        ["sv1l","sv3l"],
        ["sv2l","sv4l"],
        // rigdi
        ["sv1l","sv5l"],
        ["sv2l","sv5l"],
        ["sv3l","sv5l"],
        ["sv4l","sv5l"],

        //R
        ["sv1r","sv2r"],
        ["sv2r","sv3r"],
        ["sv3r","sv4r"],
        ["sv4r","sv1r"],
        // cross
        ["sv1r","sv3r"],
        ["sv2r","sv4r"],
        // rigdi
        ["sv1r","sv5r"],
        ["sv2r","sv5r"],
        ["sv3r","sv5r"],
        ["sv4r","sv5r"],

        // sunvisor <> roof
        {"beamDeform":1000,"beamStrength":4000},
        {"breakGroup":"sunvisor_L"},
        //L
        ["sv1l","brf1ll"],
        ["sv1l","brf1l"],
        ["sv1l","brf2ll"],
        ["sv1l","brf2l"],
        //-
        ["sv2l","brf1l"],
        ["sv2l","brf1"],
        ["sv2l","brf2l"],
        ["sv2l","brf2"],

        {"breakGroup":"sunvisor_R"},
        //R
        ["sv1r","brf1rr"],
        ["sv1r","brf1r"],
        ["sv1r","brf2rr"],
        ["sv1r","brf2r"],
        //-
        ["sv2r","brf1r"],
        ["sv2r","brf1"],
        ["sv2r","brf2r"],
        ["sv2r","brf2"],

        // Damp
        {"beamSpring":500,"beamDamp":120},
        {"breakGroup":"sunvisor_L"},
        ["sv3l","brf3ll"],
        ["sv4l","brf3"],
        //-
        {"breakGroup":"sunvisor_R"},
        ["sv3r","brf3rr"],
        ["sv4r","brf3"],

        // support beams
        {"beamType":"|SUPPORT", "beamLongBound":2},
        {"beamSpring":6000,"beamDamp":30},
        {"beamDeform":14000,"beamStrength":4000},
        {"breakGroupType":1},
        {"breakGroup":"sunvisor_L"},
        // Open limit
        {"beamPrecompression":0.516103},
        ["sv3l", "brf1ll"],
        ["sv3r", "brf1rr"],
        // Close limit
        {"beamPrecompression":1.1},
        ["sv3l", "brf2l", {"beamLongBound":10}],
        ["sv3r", "brf2r", {"beamLongBound":10}],
        {"breakGroup":"sunvisor_R"},
        // Open limit
        {"beamPrecompression":0.735926},
        ["sv4l", "brf1"],
        ["sv4r", "brf1"],
        // Close limit
        {"beamPrecompression":1.04},
        ["sv4l", "brf2"],
        ["sv4r", "brf2"],
        {"beamPrecompression":1.0},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"breakGroup":""},
        {"breakGroupType":0}
    ],
    "hydros": [
        ["id1:","id2:"],

        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":8000,"beamDamp":50,"beamDeform":"FLT_MAX","beamStrength":4000},
        {"breakGroup":"sunvisor_L"},
        ["sv3l","bd1l", {"inputSource":"sunvisorL", "inLimit":1.0, "outLimit":0.58, "inRate":0.8, "outRate":0.8, "inputFactor":1.0}],
        ["sv4l","bd1l", {"inputSource":"sunvisorL", "inLimit":1.0, "outLimit":0.62, "inRate":0.8, "outRate":0.8, "inputFactor":1.0}],
        {"breakGroup":"sunvisor_R"},
        ["sv3r","bd1r", {"inputSource":"sunvisorR", "inLimit":1.0, "outLimit":0.58, "inRate":0.8, "outRate":0.8, "inputFactor":1.0}],
        ["sv4r","bd1r", {"inputSource":"sunvisorR", "inLimit":1.0, "outLimit":0.62, "inRate":0.8, "outRate":0.8, "inputFactor":1.0}],
        {"breakGroup":""},
    ],
    "triangles": [
        ["id1:","id2:","id3:"],
        {"group":"doorwindow_FL"},
        {"groundModel":"metal"},
        {"dragCoef":7},
        ["sv4l", "sv3l", "sv1l"],
        ["sv4l", "sv1l", "sv2l"],
        ["sv4r", "sv3r", "sv1r"],
        ["sv4r", "sv1r", "sv2r"],
        {"group":""},
    ]

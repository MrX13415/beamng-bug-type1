        ["sunvisor_R", "", "brf1","brf1r","brf2", "box", {"x":0.05, "y":0.015, "z":0.015}, {"x": 20, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.11, "y":0.05, "z":-0.055}],
    ],

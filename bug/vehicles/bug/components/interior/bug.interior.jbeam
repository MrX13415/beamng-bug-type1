        ["triggerId:triggers", "action", "targetEventId:events"],
        ["sunvisor_L", "action0", "sunvisor_L_toggle"],   // default: left mouse btn
        ["sunvisor_R", "action0", "sunvisor_R_toggle"],   // default: left mouse btn
    ],

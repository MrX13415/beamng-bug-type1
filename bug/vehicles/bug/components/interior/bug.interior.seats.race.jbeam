// - Variant Race
"bug_seat_race_FL": {
    "information":{
        "authors":"BeamNG",
        "name":"Front Left Race Seat Base",
        "value":10,
    },
    "slotType" : "bug_seat_FL",
    "slots2": [
        ["name",         "allowTypes",     "denyTypes", "default",      "description"],
        ["race_seat_FL", ["racing_seat"],  [],          "seat_race_gray", "Front Left Race Seat", {"nodeMove":{"x":0.30, "y":-0.04, "z":0.3}, "variables":{"$seatID":"FL"}}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["racingseat_base", ["bug_frame"],[],{"pos":{"x":0.3,"y":-0.15,"z":0.29}, "scale":{"x":0.95, "y":0.95, "z":1.7}}],
    ],
    "beams": [
        ["id1:",  "id2:"],
        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //attach
        {"beamSpring":1201000,"beamDamp":150},
        {"beamDeform":12000,"beamStrength":200000},
        {"deformLimitExpansion":1.2},
        {"breakGroup":"bug_seat_FL"},

        //strong
        ["seatGeneric1l_FL", "f3ml"],  
        ["seatGeneric1l_FL", "f4ml"],  
        ["seatGeneric1r_FL", "f3l"],   
        ["seatGeneric1r_FL", "f4l"],   
        ["seatGeneric2l_FL", "f4ml"],  
        ["seatGeneric2l_FL", "f5ml"],  
        ["seatGeneric2r_FL", "f4l"],   
        ["seatGeneric2r_FL", "f5l"],   

        //weaker
        {"beamSpring":401000,"beamDamp":150},
        {"beamDeform":5000},
        {"deformLimitExpansion":""},
        ["seatGeneric1l_FL", "f3l"], 
        ["seatGeneric1r_FL", "f3ml"],
        ["seatGeneric2l_FL", "f5l"],
        ["seatGeneric2r_FL", "f5ml"],

        {"breakGroup":""},
        {"deformLimitExpansion":1.2},
        {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},

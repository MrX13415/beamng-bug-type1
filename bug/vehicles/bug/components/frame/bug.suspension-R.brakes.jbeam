"bug_brake_R_5lw_race": {
    "information":{
        "authors":"BeamNG",
        "name":"Rear Disc Brakes",
        "value":200,
    },
    "slotType" : "bug_brake_R_5lw",
    "slots": [
        ["type", "default", "description"]
        ["brakepad_R","brakepad_R", "Rear Brake Pads"{"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["brakedisc_5lw",  ["wheel_RL","wheelhub_RL"],                [], {"pos":{"x": 0.460, "y":0, "z":0}, "rot":{"x":   0, "y":0, "z":  0},   "scale":{"x": 1, "y":1, "z":1 }}],
        ["brakedisc_5lw",  ["wheel_RR","wheelhub_RR"],                [], {"pos":{"x":-0.460, "y":0, "z":0}, "rot":{"x":   0, "y":0, "z":180},   "scale":{"x": 1, "y":1, "z":1 }}],
        ["brake_caliper_standard_plain", ["hub_R","lowermounts_R"],   [], {"pos":{"x": 0.475, "y":0, "z":0}, "rot":{"x": 180, "y":0, "z":  0},   "scale":{"x": 0.88, "y":0.88, "z":0.88 }}],
        ["brake_caliper_standard_plain", ["hub_R","lowermounts_R"],   [], {"pos":{"x":-0.475, "y":0, "z":0}, "rot":{"x": 180, "y":0, "z":  0},   "scale":{"x": 0.88, "y":0.88, "z":0.88 }}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        //{"brakeTorque":"$=case($brakebias == nil, $brakestrength*700, $brakestrength*2100*(1-$brakebias))"},
        {"brakeTorque":"$=$brakebias == nil and $brakestrength*700 or $brakestrength*2100*(1-$brakebias)"},
        {"brakeInputSplit":1},
        {"brakeSplitCoef":1},
        {"parkingTorque":900},
        {"brakeSpring":80},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.24},
        {"brakeMass":3.1},
        {"brakeType":"vented-disc"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":0.8},
        //brake sounds
        {"squealCoefNatural": 0.0, "squealCoefLowSpeed": 0.0}
    ],
},


{

"bug_brake_R_5lw_drum": {
    "information":{
        "authors":"BeamNG",
        "name":"Rear 5-Lug Wide Drum Brakes",
        "value":200,
    },
    "slotType" : "bug_brake_R_5lw",
    "slots": [
        ["type", "default", "description"]
        ["brakepad_R","brakepad_R", "Rear Brake Pads"{"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["brakedrum_5lw",  ["wheel_RL","wheelhub_RL"],  [], {"pos":{"x": 0.460, "y":0, "z":0}, "rot":{"x":  0, "y":0, "z":  0 }, "scale":{"x": 1, "y":1, "z":1 }}],
        ["brakedrum_5lw",  ["wheel_RR","wheelhub_RR"],  [], {"pos":{"x":-0.460, "y":0, "z":0}, "rot":{"x":  0, "y":0, "z":180 }, "scale":{"x": 1, "y":1, "z":1 }}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        {"brakeTorque":"$=$brakestrength*750"}
        {"brakeInputSplit":1},
        {"brakeSplitCoef":1},
        {"parkingTorque":1000},
        {"brakeSpring":125},
        {"enableABS":false},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.24},
        {"brakeMass":2.75},
        {"brakeType":"drum"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":0.7},
    ],
},

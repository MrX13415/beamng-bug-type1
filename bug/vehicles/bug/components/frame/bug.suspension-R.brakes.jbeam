{

"bug_brake_R_5lw_drum": {
    "information":{
        "authors":"BeamNG",
        "name":"Rear Wide 5-Lug Drum Brakes",
        "value":200,
    },
    "slotType" : "bug_brake_R_5lw",
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],
        ["brakepad_R", ["brakepad_R"], [], "brakepad_R", "Rear Brake Pads", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["bug_brakedrum_5lw",  ["wheel_RL","wheelhub_RL"],  [], {"pos":{"x": 0.460, "y":0, "z":0}, "rot":{"x":  0, "y":0, "z":  0 }, "scale":{"x": 1, "y":1, "z":1 }}],
        ["bug_brakedrum_5lw",  ["wheel_RR","wheelhub_RR"],  [], {"pos":{"x":-0.460, "y":0, "z":0}, "rot":{"x":  0, "y":0, "z":180 }, "scale":{"x": 1, "y":1, "z":1 }}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
       // {"enableABS":false}, (Now controlled by the part "bug_ABS" in the frame)
        {"brakeTorque":"$=$brakestrength*650"},
        {"brakeInputSplit":1},
        {"brakeSplitCoef":1},
        {"parkingTorque":750},
        {"brakeSpring":80},

        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.24},
        {"brakeMass":2.75},
        {"brakeType":"drum"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":0.7},
        //brake sounds
        {"squealCoefNatural": 0.0, "squealCoefLowSpeed": 0.0}
    ],
},

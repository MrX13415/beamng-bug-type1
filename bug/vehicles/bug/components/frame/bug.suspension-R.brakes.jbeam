      // ["bug_brakedrum_RL", ["wheel_RL","wheelhub_RL"], ["bug"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"]
        ["$braketorque_R", "range", "", "Brakes", 900, 0, 1500, "Rear Brake Torque", "Strength of the rear brakes"{"minDis":0}]

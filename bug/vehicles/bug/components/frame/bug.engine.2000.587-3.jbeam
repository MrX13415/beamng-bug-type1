	],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
    ],
    "mainEngine": {
        // 165PS / 188Nm
        "torque":[
            ["rpm", "torque"],
            [    0,  0              ],
            [ 1500, "$=$torque*106" ],
            [ 2000, "$=$torque*125" ],
            [ 2500, "$=$torque*145" ],
            [ 3000, "$=$torque*165" ],
            [ 3500, "$=$torque*185" ],
            [ 4000, "$=$torque*203" ],
            [ 4500, "$=$torque*215" ],
            [ 5000, "$=$torque*222" ],
            [ 5500, "$=$torque*225" ],
            [ 6000, "$=$torque*222" ],
            [ 6500, "$=$torque*217" ],
            [ 7000, "$=$torque*211" ],
            [ 7500, "$=$torque*198" ],
            [ 8000, "$=$torque*185" ],
            [ 8500, "$=$torque*164" ],
            [ 9000, "$=$torque*145" ],
            [ 9500, "$=$torque*127" ],
            [10000, "$=$torque*110" ],
        ],
		"idleRPM":850,
        "idleRPMRoughness":150,
        "maxRPM": 7800,
        "maxPhysicalRPM": 8000,
        "hasRevLimiter":false,
        "inertia":0.08, 
        "friction":8,
        "dynamicFriction":0.029,
        "engineBrakeTorque":22,
        
        "burnEfficiency":[
            [0, 0.10],
            [0.05, 0.21],
            [0.4, 0.34],
            [0.7, 0.45],
            [1, 0.32],
        ],

        "energyStorage": "mainTank",
        "requiredEnergyType":"gasoline",

        //cooling and oil system
        "thermalsEnabled":true,
        "isAirCooledOnly":true,
        "airRegulatorTemperature":85,
        "airRegulatorClosedCoef":0.1,
        "engineBlockAirCoolingEfficiency":12,
        "blockFanMaxAirSpeed":22,
        "engineBlockAirflowCoef":1.25,
        "engineBlockMaterial":"aluminium",
        "oilVolume":4,
        "radiatorFanType":"mechanical",

        //engine durability
        "cylinderWallTemperatureDamageThreshold":200,
        "headGasketDamageThreshold":1500000,
        "pistonRingDamageThreshold":1500000,
        "connectingRodDamageThreshold":2000000,
        "maxTorqueRating": 450,
        "maxOverTorqueDamage": 300,
        "maxOverRevDamage": 3000,
       
        //exhaust
        // Using defaults for now, as they seems to sound weird?
        //"instantAfterFireSound": "event:>Vehicle>Afterfire>box4_01>single",

			[	7000	,	32.66	],
			[	7500	,	23.71	],
        ],
        "idleRPM":950,
        "maxRPM":5000,
        "hasRevLimiter":true,
        "inertia":0.0525, //for 200mm 14lbs flywheel + other rotational mass of engine

    "mainEngine": {
        "torque":[
            ["rpm", "torque"],
            [	0	,	0.00	],
			[	500	,	25.05	],
			[	1000	,	36.39	],
			[	1500	,	63.54	],
			[	2000	,	83.29	],
			[	2500	,	95.54	],
			[	3000	,	100.28	],
			[	3500	,	98.93	],
			[	4000	,	92.78	],

{

"bug_fueltank": {
    "information":{
        "authors":"BeamNG",
        "name":"Fuel Tank",
        "value":300,
    },
    "slotType" : "bug_fueltank",
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["fueltank",        ["fueltank"]],
    ],
    "props": [
        ["func",         "mesh",      "idRef:", "idX:", "idY:", "baseRotation", "rotation", "translation", "min", "max", "offset", "multiplier"],

        ["fuelcap", "fueltank_cap",  "ft1l","ft1r","ft3r",   {"x":0, "y":180, "z":0},   {"x":-5, "y":-8, "z":0},    {"x":-0.39, "y":0.48, "z":0.1},        0,     1,        0,  1],
    ],
    "triggers":[
        ["id", "label", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["fuelcap",  "", "ft1l","ft1r","ft3r", "box", {"x":0.04, "y":0.04, "z":0.01}, {"x":0, "y":0, "z":0}, {"x":-5, "y":8, "z":0}, {"x":0, "y":0, "z":0},{"x":0.255, "y":-0.28, "z":-0.012}],
    ],
    "triggerEventLinks":[
        ["triggerId:triggers", "action", "targetEventId:events"],        
        
        ["fuelcap", "action0", "togglefuelcap"],
    ],
    "events":[
        ["id", "title", "desc"],

        ["togglefuelcap",  "ui.inputActions.bug.togglefuelcap.title", "ui.inputActions.bug.togglefuelcap.description", {"onDown":"vehicle.toggle('fuelcap')"}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$fuel", "range", "L", "Engine", 40, 0, 40, "Fuel Volume", "Initial Fuel Volume", {"stepDis":0.5}]
    ],
    "energyStorage": [
        ["type", "name"],
        ["fuelTank", "mainTank"],
    ],
    "mainTank": {
        "energyType":"gasoline",
        "fuelCapacity": 40,
        "startingFuelCapacity": "$fuel",
        "fuel": {"[engineGroup]:":["fuel"]},
        "breakTriggerBeam": "fuelTank",
    },
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //fuel tank particles
         {"nodeMaterial":"|NM_PLASTIC"},
         {"frictionCoef":1},
         {"collision":true},
         {"selfCollision":true},
         {"nodeWeight":0.8},
         {"engineGroup":["fuel"]},
         {"chemEnergy":50,"burnRate":1.2,"flashPoint":220,"vaporPoint":97,"specHeat":0.03,"selfIgnitionCoef":0.4,"smokePoint":220,"containerBeam":"fuelTank"},
         {"group":"fueltank"},
         ["ft1l",  0.33, -1.42, 0.7],
         ["ft1r", -0.33, -1.42, 0.7],
         {"selfIgnitionCoef":false,"selfCollision":false},
         ["ft2l",  0.33, -1.07, 0.7],
         ["ft2r", -0.33, -1.07, 0.7],
         ["ft3l",  0.24, -1.42, 0.5],
         ["ft3r", -0.24, -1.42, 0.5],
         ["ft4l",  0.24, -1.07, 0.5],
         ["ft4r", -0.24, -1.07, 0.5],
         {"group":""},
         {"chemEnergy":false,"burnRate":false,"flashPoint":false,"vaporPoint":false,"specHeat":false,"selfIgnitionCoef":false,"smokePoint":false,"containerBeam":false},
         {"engineGroup":""}
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":535000,"beamDamp":200},
          {"beamDeform":5000,"beamStrength":"FLT_MAX"},
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"deformLimitExpansion":1.1},

          // Main shape
          ["ft2l","ft2r"],
          ["ft3l","ft3r"],
          ["ft4l","ft4r"],
          ["ft1l","ft2l"],
          ["ft1r","ft2r"],
          ["ft3l","ft4l"],
          ["ft3r","ft4r"],
          ["ft1l","ft3l"],
          ["ft1r","ft3r"],
          ["ft2l","ft4l"],
          ["ft2r","ft4r"],
          // X
          ["ft1l","ft2r"],
          ["ft1r","ft2l"],
          ["ft3l","ft4r"],
          ["ft3r","ft4l"],
          ["ft1r","ft4r"],
          ["ft2r","ft3r"],
          ["ft1l","ft4l"],
          ["ft2l","ft3l"],
          ["ft1l","ft3r"],
          ["ft1r","ft3l"],
          ["ft2l","ft4r"],
          ["ft2r","ft4l"],
          // rigidify
          ["ft1l","ft4r"],
          ["ft1r","ft4l"],
          ["ft2l","ft3r"],
          ["ft2r","ft3l"],

          // Connection to frame:
          {"beamSpring":810000,"beamDamp":50},
          {"beamDeform":5000,"beamStrength":20000},
          {"breakGroup":"fueltank_mount"},
          {"breakGroupType":0},
          ["ft1l","f1ml"],
          ["ft1r","f1mr"],
          ["ft1l","f1mr"],
          ["ft1r","f1ml"],
          ["ft1l","f2l"],
          ["ft1l","f2r"],
          ["ft1r","f2l"],
          ["ft1r","f2r"],

          ["ft2l","f1mr"],
          ["ft2r","f1ml"],
          ["ft2l","f1ml"],
          ["ft2r","f1mr"],
          ["ft2l","f3l"],
          ["ft2l","f3r"],
          ["ft2r","f3l"],
          ["ft2r","f3r"],
          ["ft4l","f2tm"],
          ["ft4r","f2tm"],

          {"breakGroup":""},
          {"breakGroupType":1},

          {"breakGroup":["fueltank","fueltank_mount"]},
          {"beamDeform":5000,"beamStrength":20000},
          ["ft1l","ft1r", {"name":"fuelTank","containerBeam": "fuelTank"}],
          {"breakGroup":""},
    ],
    "triangles": [
        ["id1:","id2:","id3:"],
        {"groundModel":"metal"},
        {"dragCoef":0},
        {"group":"fueltank"},
        ["ft1r", "ft1l", "ft2r"],
        ["ft2r", "ft1l", "ft2l"],
        ["ft3r", "ft3l", "ft1r"],
        ["ft1r", "ft3l", "ft1l"],
        ["ft4r", "ft3r", "ft2r"],
        ["ft2r", "ft3r", "ft1r"],
        ["ft3l", "ft4l", "ft2l"],
        ["ft3l", "ft2l", "ft1l"],
        ["ft4l", "ft4r", "ft2l"],
        ["ft2l", "ft4r", "ft2r"],
        ["ft4r", "ft4l", "ft3r"],
        ["ft3r", "ft4l", "ft3l"],
        {"group":""},
    ]
},

// -- ECU
"bug_engine_ecu_sport": {
    "information":{
        "authors":"BeamNG",
        "name":"Rev Limiter",
        "value":650,
    },
    "slotType" : "bug_engine_ecu",
    "mainEngine":{
        "hasRevLimiter":true,
        "revLimiterType":"rpmDrop",
        "revLimiterRPM":5000,
        "revLimiterRPMDrop":150,
    },
},
"bug_engine_ecu_race": {
    "information":{
        "authors":"BeamNG",
        "name":"Adjustable Rev Limiter",
        "value":3450,
    },

    "slotType" : "bug_engine_ecu",

    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$revLimiterRPM", "range", "rpm", "Engine", 5000, 3000, 7000, "RPM Limit", "RPM where the rev limiter prevents further revving", {"stepDis":50}],
        ["$revLimiterCutTime", "range", "s", "Engine", 0.12, 0.01, 0.5, "RPM Limit Cut Time", "How fast the rev limiter cycles", {"stepDis":0.01}],
    ],
    "controller": [
        ["fileName"],
        ["twoStepLaunch", {"rpmLimit":4000}],
    ],
    "mainEngine":{
        "hasRevLimiter":true,
        "revLimiterType":"timeBased",
        "revLimiterRPM":"$revLimiterRPM",
        "revLimiterCutTime":"$revLimiterCutTime",
        "revLimiterMaxRPMDrop":250,
    },
    "vehicleController": {
        "highShiftUpRPM":"$=$revLimiterRPM - 200",
    },
},
"bug_engine_ecu_old": {
    "information":{
        "authors":"BeamNG",
        "name":"Damaged",
        "value":3450,
    },
    "slotType" : "bug_engine_ecu",
    "mainEngine":{

        "idleRPMRoughness":2000,
        "friction":8,
        "burnEfficiency":[
            [0, 0.05],
            [0.05, 0.105],
            [0.4, 0.17],
            [0.7, 0.225],
            [1, 0.16],
        ],

        "engineBlockAirCoolingEfficiency":16,

        "headGasketBlownOverride": true,
        "pistonRingsDamagedOverride": true,
        "connectingRodBearingsDamagedOverride": true,
        "hasOilStarvingDamage": true,

        //exhaust
        "particulates":0.2,
        "idleParticulates":0.1,
        "instantAfterFireCoef": 0.5,

        //starter motor
        "starterThrottleKillTime":3.0,
        "idleRPMStartCoef":1.0,
    },
},



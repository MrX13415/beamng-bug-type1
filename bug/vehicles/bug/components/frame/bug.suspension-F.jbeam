        ["fh6l", "fh3l", "fh5l"],
        ["fh5l", "fh1l", "fh6l"],
        ["fh5r", "fh2r", "fh6r"],
        ["fh3r", "fh6r", "fh5r"],
        ["fh1r", "fh5r", "fh6r"],
        {"triangleType":"NORMALTYPE"},
    ],
},

"bug_steering": {
    "information":{
        "authors":"BeamNG",
        "name":"Gemmer Steering",
        "value":200,
    },
    "slotType" : "bug_steering",
    "slots": [
        ["type", "default", "description"],
        ["bug_steeringbox","bug_steeringbox", "Steering Box"],
    ],
    "flexbodies":[
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["bug_steering_box", ["uppermounts_F","lowermounts_F"]],
        ["bug_steering_cylinder_mount", ["uppermounts_F","lowermounts_F"]],
        ["bug_steering_cylinder_body", ["uppermounts_F","lowermounts_F"]],
        ["bug_steering_cylinder_rod", ["pitman_F", "uppermounts_F","lowermounts_F"]],

        ["bug_steering_rod_joint", ["pitman_F"]],
        ["bug_steering_rod_L", ["tierod_F"]],
        ["bug_steering_rod_R", ["tierod_F"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_F", "range", "", "Wheel Alignment", 0.9995, 0.99, 1.01, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Front"}],
        ["$steer_center_F", "range", "", "Wheel Alignment", 0, -0.002, 0.002, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Front"}],
    ],
    "nodes":[
        ["id", "posX", "posY", "posZ"],

        //--steering rod--
        {"selfCollision":false},
        {"collision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.7},
        {"group":["tierod_F","pitman_F"]},
        {"nodeWeight":4.0},
        ["st1ll",  0.216, -1.262, 0.41],
        ["st1rr", -0.216, -1.262, 0.41],
        {"nodeWeight":4.0},
        {"group":["tierod_F","idler_F","pitman_F"]},
        ["st1r", -0.111, -1.262, 0.41],
        {"nodeWeight":3.0},
        ["st2r", -0.216, -1.310, 0.24],
        ["st3r", -0.216, -1.430, 0.395],
        {"group":["tierod_F","steeringbox_F","pitman_F"]},
        {"nodeWeight":4.0},
        ["st1l",  0.111, -1.262, 0.41],
        {"nodeWeight":3.0},
        ["st2l",  0.216, -1.310, 0.24],
        ["st3l",  0.216, -1.430, 0.395],
        {"collision":false},
        //steering box rigidifier slidenode
        {"group":""},
        {"nodeWeight":3.0},
        ["st4r", -0.216, -1.362, 0.243],
        ["st4l",  0.216, -1.362, 0.243],
        ["st5r", -0.216, -1.364, 0.381],
        ["st5l",  0.216, -1.364, 0.381],
    ],
    "rails": {
       "tierod_M":{"links:":["st1rr", "st1ll"], "broken:":[], "looped":false, "capped":true},
       "beam_upper":{"links:":["fx2r", "fx2l"], "broken:":[], "looped":false, "capped":true},
       "beam_lower":{"links:":["fx1r", "fx1l"], "broken:":[], "looped":false, "capped":true},
    },
    "slidenodes": [
       ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
       ["st1r", "tierod_M", true, true, 0.0, 12001000, "FLT_MAX", "FLT_MAX"],
       ["st1l", "tierod_M", true, true, 0.0, 12001000, "FLT_MAX", "FLT_MAX"],

       ["st5r", "beam_upper", true, true, 0.0, 10001000, 250000, 250000],

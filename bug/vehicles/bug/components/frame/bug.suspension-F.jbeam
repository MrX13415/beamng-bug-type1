        {"beamDeform":25000,"beamStrength":"FLT_MAX"},
        //widthwise
        ["st3r", "fx2r"],
        ["st2r", "fx1r"],

        ["st3l", "fx2l"],
        ["st2l", "fx1l"],

        //crossing

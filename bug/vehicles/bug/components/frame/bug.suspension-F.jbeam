{
"bug_suspension_F": {
    "information":{
        "authors":"BeamNG",
        "name":"Trailing Link Front Suspension",
        "value":400,
    },
    "slotType":"bug_suspension_F",
    "slots":[
        ["type", "default", "description"],

        ["bug_hub_F", "bug_hub_F_5", "Front Wheel Hubs"],
        //["bug_brake_F","bug_brake_F", "Front Brakes"],
        //["wheel_F_4","steelwheel_11b_13x5_F", "Front Wheels", {"nodeOffset":{"x":"$=$trackoffset_F+0.125", "y":-1.20452, "z":0.334592}}],
        //["bug_wheeldata_F","bug_wheeldata_F", "Front Spindles", {"coreSlot":true}],

        ["bug_spring_F","bug_spring_F", "Front Springs"],
        ["bug_steering","bug_steering", "Steering"],
        ["bug_swaybar_F","bug_swaybar_F", "Front Sway Bar"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_F", "range", "", "Wheel Alignment", 1, 0.99, 1.01, "Camber Adjust", "Adjusts the wheel camber angle", {"subCategory":"Front"}],
        ["$caster_F", "range", "", "Wheel Alignment", 0, -0.003, 0.003, "Caster Adjust", "Adjust forward rake of the steering axis", {"subCategory":"Front"}],
        ["$trackoffset_F", "range", "+m", "Wheels", 0, -0.02, 0.05, "Track Offset", "Spacing of the wheel from the hub", {"stepDis":0.001, "subCategory":"Front"}],
    ],
    "flexbodies":[
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["bug_front_axle_frame", ["uppermounts_F","lowermounts_F","shocktop_F"]],
        ["bug_front_axle_arms", ["hub_F", "uppermounts_F","lowermounts_F","shocktop_F"]],
        ["bug_front_axle_joint_L", ["hub_F", "uppermounts_F","lowermounts_F","shocktop_F"]],
        ["bug_front_axle_joint_R", ["hub_F", "uppermounts_F","lowermounts_F","shocktop_F"]],
        ["bug_front_axle_L", ["hub_F","lowerarm_F","upperarm_F", "brakearm_F"]],
        ["bug_front_axle_R", ["hub_F","lowerarm_F","upperarm_F", "brakearm_F"]],
    ],
    "nodes":[
        ["id", "posX", "posY", "posZ"],

        {"selfCollision":true},
        {"collision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.6},
        {"nodeWeight":5.0},

        //front subframe
        //overwritten by wide or offroad suspension
        {"group":"lowermounts_F"},
        ["fx1r", -0.460, -1.362, 0.243],
        ["fx1",   0.000, -1.362, 0.243, {"nodeWeight":2.0, "selfCollision":false}],
        ["fx1l",  0.460, -1.362, 0.243],

        {"group":["bonnetsupport","uppermounts_F"]},
        ["fx2r", -0.460, -1.364, 0.381],
        ["fx2",   0.000, -1.364, 0.381, {"nodeWeight":2.0, "selfCollision":false}],
        ["fx2l",  0.460, -1.364, 0.381],

        ["fx0",   0.000, -1.220, 0.300, {"nodeWeight":2.0,"group":"","collision":false,"selfCollision":false}],

        {"group":"shocktop_F"},
        {"nodeWeight":4.0},
        {"selfCollision":false},
        ["fs1r", -0.460, -1.304, 0.519],
        ["fs1l",  0.460, -1.304, 0.519],
        {"selfCollision":true},

        //--FRONT INDEPENDENT SUSPENSION--
        {"collision":true},
        {"selfCollision":false},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.4},
        //front hub
        //this is the steering axis
        {"nodeWeight":3.2},
        {"group":["hub_F", "lowerarm_F","tierod_F"]},
        ["fh1r", -0.59, "$=-1.225-$caster_F", 0.248],
        ["fh1l",  0.59, "$=-1.225-$caster_F", 0.248],
        {"nodeWeight":3.2},
        {"group":["hub_F", "upperarm_F","tierod_F"]},
        ["fh2r", -0.565, "$=-1.211+$caster_F", 0.405],
        ["fh2l",  0.565, "$=-1.211+$caster_F", 0.405],
        {"selfCollision":false},
        //tie rod goes here
        {"nodeWeight":3.6},
        {"group":["hub_F","tierod_F"]},
        ["fh3r", -0.55, -1.103, 0.41],
        ["fh3l",  0.55, -1.103, 0.41],

        {"nodeWeight":2.5},
        {"group":["hub_F", "brakearm_F"]},
        ["fh5r", -0.61, -1.338, 0.435],
        ["fh5l",  0.61, -1.338, 0.435],
        //flexbody help only
        {"group":["hub_F"]},
        {"nodeWeight":2.3},
        ["fh6r", -0.61, -1.078, 0.435],
        ["fh6l",  0.61, -1.078, 0.435],
        {"group":""},
    ],
    "rails": {
        "frontframeU":{"links:":["f1tml", "f1tmr"], "broken:":[], "looped":false, "capped":true},
        "frontframeL":{"links:":["f1ml", "f1mr"], "broken:":[], "looped":false, "capped":true},
     },
     "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        ["fx2", "frontframeU", true, true, 0.0, 8001000, "FLT_MAX", "FLT_MAX"],
        ["fx1", "frontframeL", true, true, 0.0, 8001000, "FLT_MAX", "FLT_MAX"],
     ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        //rigidify subframe in torsion
        {"spring":200000, "damp":0, "deform":15000, "strength":"FLT_MAX"},
        ["fx1l", "fx2l", "fx2r", "fx1r"],
        {"spring":100000, "damp":1, "deform":25000, "strength":100000},
        //further resist suspension arms from twisting
        ["fx2r", "fh2r", "fh1r", "fx1r"],
        ["fx2l", "fh2l", "fh1l", "fx1l"],
        {"spring":100000, "damp":0, "deform":25000, "strength":100000},
        //rigidify steering arm
        ["fw1rr", "fw1r", "fh1r", "fh3r"],
        ["fw1ll", "fw1l", "fh1l", "fh3l"],
    ],
    "beams":[
        ["id1:", "id2:"],

        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

        //FRONT TORSION BAR TUBES
        {"beamSpring":2801000,"beamDamp":250},
        {"beamDeform":25000,"beamStrength":"FLT_MAX"},
        //main shape
        ["fx1r", "fx1l"],
        ["fx2r", "fx2l"],
        ["fx1r", "fx2l"],
        ["fx1l", "fx2r"],
        ["fx1l", "fx2l"],
        ["fx1r", "fx2r"],
        ["fx2r", "fs1r"],
        ["fx2l", "fs1l"],
        ["fs1r", "fx2l"],
        ["fs1l", "fx2r"],
        ["fs1r", "fx1r"],
        ["fs1l", "fx1l"],
        ["fs1r", "fx1l"],
        ["fs1l", "fx1r"],
        ["fs1l", "fs1r"],

        //rigidifier node
        {"beamSpring":2001000,"beamDamp":50},
        ["fx2r", "fx0"],
        ["fx1r", "fx0"],
        ["fx2l", "fx0"],
        ["fx1l", "fx0"],
        ["fs1l", "fx0"],
        ["fs1r", "fx0"],

        //shock tower rigififiers
        {"beamSpring":2501000,"beamDamp":100},
        {"beamDeform":10000, "beamStrength":350000},
        ["fs1l", "f2l", {"breakGroup": "suspension_F"}],
        ["fs1r", "f2r", {"breakGroup": "suspension_F"}],

        //front torsion tubes middle nodes
        {"beamSpring":2001000,"beamDamp":50},
        {"beamDeform":9000, "beamStrength":"FLT_MAX"},
        ["fx1", "fx2"],
        ["fx1", "fx0"],
        ["fx2", "fx0"],
        ["fx2", "fs1l"],
        ["fx2", "fs1r"],
        ["fx2", "fx1l"],
        ["fx1", "fx2l"],
        ["fx2", "fx1r"],
        ["fx1", "fx2r"],
        ["fx2", "fx2l"],
        ["fx2", "fx2r"],
        ["fx1", "fx1l"],
        ["fx1", "fx1r"],

        //front torsion tubes to frame
        {"beamSpring":3501000,"beamDamp":80},
        {"beamDeform":8000, "beamStrength":350000},
        {"breakGroup": "suspension_F"},
        ["fx1", "f1mr"],
        ["fx1", "f1ml"],
        ["fx1", "f1tmr"],
        ["fx1", "f1tml"],
        ["fx2", "f1mr"],
        ["fx2", "f1ml"],
        ["fx2", "f1tmr"],
        ["fx2", "f1tml"],
        //-
        //["fx1l", "f2tm"],
        //["fx1r", "f2tm"],
        //["fx2l", "f2tm"],
        //["fx2r", "f2tm"],
//
        //["fx1l", "f2ml"],
        //["fx1r", "f2mr"],
        //["fx2r", "f2mr"],
        //["fx2l", "f2ml"],


        ["fx1l", "f2l"],
        ["fx1l", "f2r"],
        ["fx2l", "f2l"],
        ["fx2l", "f2r"],
        ["fx1r", "f2l"],
        ["fx1r", "f2r"],
        ["fx2r", "f2l"],
        ["fx2r", "f2r"],
        // ["fx1l", "f4l"],
        // ["fx1l", "f4r"],
        // ["fx2l", "f4l"],
        // ["fx2l", "f4r"],
        {"optional":true},
        ["fx1l", "bf7ll"],
        ["fx1l", "bf7rr"],
        ["fx2l", "bf7ll"],
        ["fx2l", "bf7rr"],
        ["fx1r", "bf7ll"],
        ["fx1r", "bf7rr"],
        ["fx2r", "bf7ll"],
        ["fx2r", "bf7rr"],
        ["fx1l", "bc2l"],
        ["fx1l", "bc2r"],
        ["fx2l", "bc2l"],
        ["fx2l", "bc2r"],
        ["fx1r", "bc2l"],
        ["fx1r", "bc2r"],
        ["fx2r", "bc2l"],
        ["fx2r", "bc2r"],
        {"optional":false},

        //extra
        {"beamSpring":2001000,"beamDamp":80},
        {"beamDeform":5500},
        // ["fx1l", "f3r"],
        // ["fx1r", "f3l"],
        // ["fx2r", "f3l"],
        // ["fx2l", "f3r"],

        {"breakGroup": ""},

        //--FRONT RUNNING GEAR--
        //double wishbone suspension
        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1.0,"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamDeform":79000,"beamStrength":350000},
        {"beamSpring":7501000,"beamDamp":80},
        //front hub
        ["fh1r","fh2r"],
        ["fh1l","fh2l"],
        ["fh1r","fh3r"],
        ["fh1l","fh3l"],
        ["fh2r","fh3r"],
        ["fh2l","fh3l"],

        {"beamSpring":5501000,"beamDamp":80},
        ["fh2r","fh5r"],
        ["fh2l","fh5l"],
        ["fh5r","fh3r"],
        ["fh5l","fh3l"],
        ["fh1r","fh5r"],
        ["fh1l","fh5l"],

        ["fh6r", "fh3r"],
        ["fh6r", "fh2r"],
        ["fh6r", "fh5r"],
        ["fh6r", "fh1r"],

        ["fh6l", "fh3l"],
        ["fh6l", "fh2l"],
        ["fh6l", "fh5l"],
        ["fh6l", "fh1l"],

        {"optional":true},
        {"beamDeform":108000,"beamStrength":155000},
        {"beamSpring":7501000,"beamDamp":80},
        //attach to wheel
        {"breakGroup":"wheel_FR"},
        ["fh1r","fw1r", {"name":"axle_FR"}],
        ["fh2r","fw1r"],
        ["fh3r","fw1r", {"beamSpring":10501000,"beamDamp":15}],
        ["fh5r","fw1r", {"beamSpring":5501000,"beamDamp":15}],
        ["fh1r","fw1rr"],
        ["fh2r","fw1rr"],
        ["fh3r","fw1rr", {"beamSpring":10501000,"beamDamp":15}],
        ["fh5r","fw1rr", {"beamSpring":5501000,"beamDamp":15}],
        {"breakGroup":"wheel_FL"},
        ["fh1l","fw1l", {"name":"axle_FL"}],
        ["fh2l","fw1l"],
        ["fh3l","fw1l", {"beamSpring":10501000,"beamDamp":15}],
        ["fh5l","fw1l", {"beamSpring":5501000,"beamDamp":15}],
        ["fh1l","fw1ll"],
        ["fh2l","fw1ll"],
        ["fh3l","fw1ll", {"beamSpring":10501000,"beamDamp":15}],
        ["fh5l","fw1ll", {"beamSpring":5501000,"beamDamp":15}],
        {"breakGroup":""},
        {"optional":false},

        //suspension arms
        {"beamSpring":6001000,"beamDamp":500},
        {"beamDeform":45000,"beamStrength":375000},
        ["fx1r","fh1r", {"dampCutoffHz":500}],
        ["fx1l","fh1l", {"dampCutoffHz":500}],
        ["fx2r","fh2r", {"dampCutoffHz":500}],
        ["fx2l","fh2l", {"dampCutoffHz":500}],

        {"beamSpring":9001000,"beamDamp":500},
        ["fx1l","fh1r", {"dampCutoffHz":500}],
        ["fx1r","fh1l", {"dampCutoffHz":500}],
        ["fx2r","fh2l", {"beamPrecompression":"$camber_F","beamPrecompressionTime":0.5,"dampCutoffHz":500}],
        ["fx2l","fh2r", {"beamPrecompression":"$camber_F","beamPrecompressionTime":0.5,"dampCutoffHz":500}],

        //shock tower brace
        {"beamSpring":1501000,"beamDamp":250},
        {"beamDeform":35000,"beamStrength":375000},
        {"breakGroup": "suspension_F"},
        {"optional":true},
        ["fs1l", "bf7l"],
        ["fs1r", "bf7r"],
        ["fs1l", "bf7r"],
        ["fs1r", "bf7l"],
        {"optional":false},

        //longitudinal damp help
        {"beamSpring":0,"beamDamp":500},
        ["fh2l", "bc4l", {"dampCutoffHz":500, "optional":true}],
        ["fh1l", "f3l", {"dampCutoffHz":500}],
        ["fh2r", "bc4r", {"dampCutoffHz":500, "optional":true}],
        ["fh1r", "f3r", {"dampCutoffHz":500}],
        {"breakGroup": ""},

        //front limiters
        {"beamPrecompression":1, "beamType":"|SUPPORT","beamLongBound":2.0},
        {"beamDeform":100000,"beamStrength":250000},
        {"beamSpring":4501000,"beamDamp":100},
        {"beamPrecompression":0.85},
        //steering anti invert
        ["fx1r", "fh3r"],
        ["fx1l", "fh3l"],
        ["fx2r", "fh3r"],
        ["fx2l", "fh3l"],
        {"beamPrecompression":0.91},
        ["fx0", "fh5r"],
        ["fx0", "fh5l"],

        //wishbone anti invert
        {"beamPrecompression":0.8},
        ["fh1r", "fx2r"],
        ["fh2r", "fx1r"],
        ["fh1l", "fx2l"],
        ["fh2l", "fx1l"],

        //suspension travel hard upward limiter
        {"beamDeform":85000,"beamStrength":250000},
        {"beamPrecompression":0.7},
        ["fh1r", "fs1r"],
        ["fh1l", "fs1l"],

        //firewall crash limiter
        {"beamSpring":2001000,"beamDamp":10},
        {"beamDeform":10000,"beamStrength":250000},
        {"beamPrecompression":0.7},
        {"breakGroup": "suspension_F"},
        ["fh2l", "f2l", {"beamPrecompression":0.8}],
        ["fh2l", "f3l"],
        ["fh2l", "bc4l", {"optional":true}],
        ["fh2r", "f2r", {"beamPrecompression":0.8}],
        ["fh2r", "f3r"],
        ["fh2r", "bc4r", {"optional":true}],
        {"breakGroup": ""},
        {"beamPrecompression":1},
        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1.0,"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
        ["id1:","id2:","id3:"],
        
        {"groundModel":"metal"},
        {"dragCoef":0},
        {"triangleType":"NONCOLLIDABLE"},

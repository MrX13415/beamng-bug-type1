{

"bug_brake_F_5lw_drum": {
    "information":{
        "authors":"BeamNG",
        "name":"Front 5-Lug Wide Drum Brakes",
        "value":250,
    },
    "slotType" : "bug_brake_F_5lw",
    "slots": [
        ["type", "default", "description"]
        ["brakepad_F","brakepad_F", "Front Brake Pads"{"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        
        ["brakedrum_5lw",  ["wheel_FL","wheelhub_FL"],  [], {"pos":{"x": 0.460, "y":0, "z":0}, "rot":{"x": 0, "y":0, "z":0 }, "scale":{"x": 1, "y":1, "z":1 }}],
        ["brakedrum_5lw",  ["wheel_FR","wheelhub_FR"],  [], {"pos":{"x":-0.460, "y":0, "z":0}, "rot":{"x": 0, "y":0, "z":180 }, "scale":{"x": 1, "y":1, "z":1 }}],
    ],
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //brakes
        {"enableABS":false},
        {"brakeTorque":"$=$brakestrength*1000"},
        {"brakeInputSplit":1},
        {"brakeSplitCoef":1},
        {"parkingTorque":0},
        {"brakeSpring":125},
        
        //brake thermals
        {"enableBrakeThermals":true},
        {"brakeDiameter":0.24},
        {"brakeMass":3.75},
        {"brakeType":"drum"},
        {"rotorMaterial":"steel"},
        {"brakeVentingCoef":1.0},
    ],
},

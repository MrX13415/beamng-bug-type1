{

// --- Engines

"bug_engine_1.6": {
    "information":{
        "authors":"Fufsgfen",
        "name":"1.6L Air-Cooled F4 Engine",
        "value":10000,
    },
    "slotType" : "bug_engine",
    "slots2": [
        ["name", "allowTypes", "denyTypes", "default", "description"],

        ["bug_battery",          ["bug_battery"], [],          "bug_battery",          "Battery",              {"coreSlot": true}],
        ["bug_intake",           ["bug_intake"], [],           "bug_intake",           "Intake",               {"coreSlot":true}],
        ["bug_oilpan",           ["bug_oilpan"], [],           "bug_oilpan",           "Oil Pan",              {"coreSlot":true}],
        ["bug_exhaust",          ["bug_exhaust"], [],          "bug_exhaust",          "Exhaust"],
        
        ["bug_oilcooler",        ["bug_oilcooler"], [],        "",                     "Oil Cooler"],
        ["bug_engine_ecu",       ["bug_engine_ecu"], [],       "",                     "Engine Management"],
        ["bug_engine_internals", ["bug_engine_internals"], [], "bug_engine_internals", "Engine Long Block",    {"coreSlot":true}],

        ["bug_transaxle",        ["bug_transaxle"], [],        "bug_transaxle_4M",     "Transaxle"],
        ["n2o_system",           ["n2o_system"], [],           "",                     "Nitrous Oxide System"],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        // Default torque is 110% to compensate for the increased weight of the car in BeamNG compared to the real world.
        ["$torque", "range", "", "Engine", 1.1, 0.8, 1.5, "Torque", "Engine Torque multiplier", {"minDis":80, "maxDis":150}],
	],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
    ],
    "mainEngine": {
        "torque":[
            ["rpm", "torque"],
            [    0,   0             ],
            [  500,  "$=$torque*76" ],
            [ 1000,  "$=$torque*106" ],
            [ 1500,  "$=$torque*120" ],
            [ 2000,  "$=$torque*132" ],
            [ 2500,  "$=$torque*138" ],
            [ 3000,  "$=$torque*141" ],
            [ 3500,  "$=$torque*135" ],
            [ 4000,  "$=$torque*124" ],
            [ 4500,  "$=$torque*113" ],
            [ 4800,  "$=$torque*105" ],
            [ 5000,  "$=$torque*96" ],
            [ 5500,  "$=$torque*86" ],
        ],
        "idleRPM":850,
        "idleRPMRoughness":150,
        "maxRPM":4800,
        "maxPhysicalRPM":5400,
        "hasRevLimiter":false,
        "inertia":0.095, //for 200mm 13.5lbs flywheel + other rotational mass of engine
        "friction":9.5,
        "dynamicFriction":0.026,
        "engineBrakeTorque":26,

        //"burnEfficiency":0.29
        "burnEfficiency":[
            [0, 0.10],
            [0.05, 0.21],
            [0.4, 0.34],
            [0.7, 0.45],
            [1, 0.32],
        ],

        //fuel system
        "energyStorage": "mainTank",
        "requiredEnergyType":"gasoline",

        //cooling and oil system
        "thermalsEnabled":true,
        "isAirCooledOnly":true,
        "airRegulatorTemperature":85,
        "airRegulatorClosedCoef":0.1,
        "engineBlockAirCoolingEfficiency":12,
        "blockFanMaxAirSpeed":22,
        "engineBlockAirflowCoef":1.25,
        "engineBlockMaterial":"aluminium",
        "oilVolume":4,
        "radiatorFanType":"mechanical",

        //engine durability
        "cylinderWallTemperatureDamageThreshold":150,
        "headGasketDamageThreshold":1500000,
        "pistonRingDamageThreshold":1500000,
        "connectingRodDamageThreshold":2000000,
        "maxTorqueRating": 300,
        "maxOverTorqueDamage": 350,
        "maxOverRevDamage": 1400,

        //exhaust
        // Using defaults for now, as they seems to sound weird?
        //"instantAfterFireSound": "event:>Vehicle>Afterfire>box4_01>single",
        //"sustainedAfterFireSound": "event:>Vehicle>Afterfire>box4_01>multi",
        //"shiftAfterFireSound": "event:>Vehicle>Afterfire>box4_01>shift",
        "particulates":0.055,
        "instantAfterFireCoef": 0.25,
        "sustainedAfterFireCoef": 1,
        "instantAfterFireVolumeCoef": 0.6,
        "sustainedAfterFireVolumeCoef": 0.3,
        "shiftAfterFireVolumeCoef": 0.5,

        //node beam interface
        "torqueReactionNodes:":["e1l","e2l","e4r"],
        "waterDamage": {"[engineGroup]:":["engine_intake"]},
        "radiator": {"[engineGroup]:":["radiator"]},
        "engineBlock": {"[engineGroup]:":["engine_block"]},
        "breakTriggerBeam":"engine",
        "uiName":"Engine",
        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",

        //starter motor
        "starterSample":"event:>Engine>Starter>box4_1960_eng",
        "starterSampleExhaust":"event:>Engine>Starter>box4_1960_exh",
        "shutOffSampleEngine":"event:>Engine>Shutoff>box4_1960_eng",
        "shutOffSampleExhaust":"event:>Engine>Shutoff>box4_1960_exh",
        "starterVolume":0.76,
        "starterVolumeExhaust":0.76,
        "shutOffVolumeEngine":0.76,
        "shutOffVolumeExhaust":0.76,
        "starterThrottleKillTime":1.0,
        "idleRPMStartRate":1.5,
        "idleRPMStartCoef":1.25,
        "maxIdleThrottle":0.1,

        // electric power
        "generatorPower": 700,   // Watt
        "enginePower": 40,       // Watt
        "starterPower": 800,     // Watt

        //engine deform groups
        "deformGroups":["mainEngine", "mainEngine_intake"]
    },
    "soundConfig": {
        "sampleName": "B4_2_engine_rear",
        "intakeMuffling": 0.6,

        "mainGain": -11,
        "onLoadGain":1.0,
        "offLoadGain":0.67,

        "maxLoadMix": 0.8,
        "minLoadMix": 0,

        "lowShelfGain":0,
        "lowShelfFreq":100,

        "highShelfGain":8,
        "highShelfFreq":5500,

        "eqLowGain": 0,
        "eqLowFreq": 450,
        "eqLowWidth": 0.2,

        "eqHighGain": 0,
        "eqHighFreq": 2200,
        "eqHighWidth": 0.3,

        "fundamentalFrequencyCylinderCount": 4,
        "eqFundamentalGain": -1,
    },
    "soundConfigExhaust": {
        "sampleName": "B4_2_exhaust",

        "mainGain":1,
        "onLoadGain":1.0,
        "offLoadGain":0.7,

        "maxLoadMix": 0.7,
        "minLoadMix": 0.0,

        "lowShelfGain":-1,
        "lowShelfFreq":140,

        "highShelfGain":-5,
        "highShelfFreq":8500,

        "eqLowGain": 2,
        "eqLowFreq": 350,
        "eqLowWidth": 0.1,

        "eqHighGain": 5,
        "eqHighFreq": 8000,
        "eqHighWidth": 0.05,

        "fundamentalFrequencyCylinderCount":4,
        "eqFundamentalGain": 0,
    },
    "vehicleController": {
        "clutchLaunchStartRPM":1900,
        "clutchLaunchTargetRPM":2600,
        //**highShiftDown can be overwritten by automatic transmissions**
        "highShiftDownRPM":[0,0,0,2500,2900,3200,3300],
        //**highShiftUp can be overwritten by intake modifications**
        "highShiftUpRPM":5500
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["bug_engine_cover",                ["bug_engine"]],
        ["bug_engine_cover_front",          ["bug_engine"]],
        ["bug_engine_fan_housing",          ["bug_engine"]],

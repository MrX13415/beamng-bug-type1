{

"bug_transaxle_2A": {
    "information":{
        "authors":"BeamNG",
        "name":"2-Speed bug-Matic Transmission",
        "value":500,
    },
    "slotType" : "bug_transaxle",
    "slots": [
        ["type", "default", "description"]
        ["bug_converter","bug_torque_converter","Torque Converter", {"coreSlot":true}],
        ["bug_differential_R","bug_differential_R", "Rear Differential"{"coreSlot":true}],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["torqueConverter", "torqueConverter", "mainEngine", 1],
        ["automaticGearbox", "gearbox", "torqueConverter", 1],
    ],
    "gearbox": {
        "uiName":"Gearbox",
        "gearRatios":[-1.82, 0, 1.82, 1.0],
        "parkLockTorque":1500,
        "oneWayViscousCoef":2,
        "friction": 5,
        "gearboxNode:":"tra1",
    },
    "vehicleController": {
        "automaticModes":"PRND1",
        "useSmartAggressionCalculation":false,
        "calculateOptimalLoadShiftPoints": true,
        "shiftDownRPMOffsetCoef":1.5,
        "transmissionGearChangeDelay":3,
        "gearboxDecisionSmoothingDown":0.25,
        "gearboxDecisionSmoothingUp":0.25,
        "lowShiftDownRPM":1600,
        "lowShiftUpRPM":3000,
        //"highShiftDownRPM":3200,
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        ["transaxle", ["transaxle"]],
        ["transaxle_starter_motor", ["transaxle"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        //-- 2 Speed Auto --
        {"selfCollision":true},
        {"collision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.7},
        {"group":"transaxle"},
        {"nodeWeight":2.2},
        ["tra1", 0.0, 0.83, 0.343606],
        {"selfCollision":false},
        {"nodeWeight":1.5},
        ["tra2l",  0.123996, 1.18048, 0.317161],
        ["tra2r", -0.123996, 1.18048, 0.317161],
    ],
    "beams": [
        ["id1:", "id2:"],

        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":1001000,"beamDamp":250},
        {"beamDeform":150000,"beamStrength":"FLT_MAX"},

        // shape
        ["tra1","tra2l"],
        ["tra1","tra2r"],
        ["tra2l","tra2r"],

        {"breakGroup":"transmission_engine"},
        {"beamStrength":800000},

        // to engine
        ["tra1","e1l"],
        ["tra1","e1r"],
        ["tra1","e3l"],
        ["tra1","e3r"],

        ["tra2l","e1l"],
        ["tra2l","e1r"],
        ["tra2l","e3l"],
        ["tra2l","e3r"],

        ["tra2r","e1l"],
        ["tra2r","e1r"],
        ["tra2r","e3l"],
        ["tra2r","e3r"],

        //transmission mounts
        {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":401000,"beamDamp":2500},
        {"beamDeform":15000,"beamStrength":165000},
        {"dampCutoffHz":500},
        {"breakGroup":"transmission_frame"},
        ["tra1","f6tml"],
        ["tra1","f6tmr"],
        ["tra1","f6ml"],
        ["tra1","f6mr"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"breakGroup":""},
    ],
},
"bug_transaxle_4M": {

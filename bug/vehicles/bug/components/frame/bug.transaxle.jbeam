"bug_differential_R_race": {
    "information":{
        "authors":"BeamNG",
        "name":"bug Race Limited Slip Rear Differential",
        "value":950,
    },
    "slotType" : "bug_differential_R",
   // "slots": [
   //     ["type", "default", "description"]
    //    ["bug_driveshaft_R","bug_driveshaft_R", "Rear Driveshaft"],
   // ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"]
        ["$lsdpreload_R", "range", "N/m", "Differentials", 150, 0, 500, "Rear LSD Preload", "Initial cross torque between left and right wheels"]
        ["$lsdlockcoef_R", "range", "", "Differentials", 0.15, 0, 0.5, "Rear LSD Forward Locking", "Locking effect proportional to engine torque", {"minDis":0, "maxDis":100}]
        ["$lsdlockcoefrev_R", "range", "", "Differentials", 0.075, 0, 0.5, "Rear LSD Reverse Locking", "Locking effect proportional to engine braking", {"minDis":0, "maxDis":100}]
        ["$finaldrive", "range", ":1", "Differentials", 4.11, 2.0, 6.0, "Final Drive Ratio", "Torque multiplication ratio"]
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"]
        ["differential", "differential_R", "gearbox", 1, {"diffType":"lsd", "gearRatio":"$finaldrive", "lsdPreload":"$lsdpreload_R", "lsdLockCoef":"$lsdlockcoef_R", "lsdRevLockCoef":"$lsdlockcoefrev_R", "friction":6, "uiName":"Rear Differential","defaultVirtualInertia":0.25}]
    ],
},


"bug_torque_converter": {
    "information":{
        "authors":"BeamNG",
        "name":"bug TC",
        "value":150,
    },
	"variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$size_TC", "range", "", "Size(m)", 0.19, 0.14, 0.28, "Torque converter size", "Percentage of adjustment range"],
		],
    "slotType" : "bug_converter",
    "torqueConverter": {
        "uiName":"Torque Converter",
        "converterDiameter": "$size_TC",
        "converterStiffness":7.5,
        "couplingAVRatio":0.87,
        "stallTorqueRatio":2.0,
        "additionalEngineInertia":0.01,
    },
},


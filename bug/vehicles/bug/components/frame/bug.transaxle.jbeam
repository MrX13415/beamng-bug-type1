"bug_halfshafts_R": {
    "information":{
        "authors":"BeamNG",
        "name":"Rear Halfshafts",
        "value":200,
    },
    "slotType" : "bug_halfshafts_R",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["bug_axle_R_halfshaft_L", ["transaxle","wheelhub_RL"]],
         ["bug_axle_R_halfshaft_R", ["transaxle","wheelhub_RR"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        // Will be overwritten by wheels
        // ensures the halfshaft is still connected when removing the wheels.
        {"selfCollision":false},
        {"collision":false},
        {"nodeWeight":5.5},
        {"group": "wheelhub_RL"},
        ["rw1l", 0.47, 1.17, 0.297021],
        {"group": "wheelhub_RR"},
        ["rw1r", -0.47, 1.17, 0.297021],
    ],
    "beams": [
        ["id1:", "id2:"],
        {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //halfshafts
        {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.12, "beamShortBound":0.12},
        {"beamSpring":0,"beamDamp":0,"beamDeform":5000,"beamStrength":8000},
        {"beamLimitSpring":5001000,"beamLimitDamp":100},
        ["rw1l","tra2l", {"name":"halfshaft_RL", "breakGroup":"wheel_RL", "breakGroupType":1, "deformGroup":"wheelaxleRL", "deformationTriggerRatio":0.001, "optional":true}],
        ["rw1r","tra2r", {"name":"halfshaft_RR", "breakGroup":"wheel_RR", "breakGroupType":1, "deformGroup":"wheelaxleRR", "deformationTriggerRatio":0.001, "optional":true}],
        {"beamLimitSpring":1,"beamLimitDamp":1},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["shaft", "wheelaxleRL", "differential_R", 1, {"deformGroups":["wheelaxleRL"], "breakTriggerBeam":"halfshaft_RL", "uiName":"Rear Left Halfshaft", "friction":0.77, "dynamicFriction": 0.0019}],
        ["shaft", "wheelaxleRR", "differential_R", 2, {"deformGroups":["wheelaxleRR"], "breakTriggerBeam":"halfshaft_RR", "uiName":"Rear Right Halfshaft", "friction":0.77, "dynamicFriction": 0.0019}],
    ],
},


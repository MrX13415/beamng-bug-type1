"bug_water_thrusters": {
    "information":{
        "authors":"53_herbie_53 inspired by Kirahl", 
        "name":"Water Thrusters",
    },
    "slotType" : "bug_thrusters",
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$thrusterpower", "range", "Power", "Water Float", 8000, 2000, 30000, "Power", "Thruster Power"],
	],
    "nodes": [
        ["id", "posX", "posY", "posZ"],

        {"nodeWeight":2},
        {"frictionCoef":1.0},
        {"collision":false},
        {"selfCollision":false},
        {"group":""},
		
		["thrustL", 0.44891, 2.07059, 0.225609],
        ["thrustR", -0.44891, 2.07059, 0.225609],
		["thrustLStart", 0.42891, 1.85513, 0.223614],
		["thrustRStart", -0.42891, 1.85513, 0.223614],
	],
    "beams": [
		["id1:", "id2:"],
		{"beamSpring":800000,"beamDamp":250},
		{"beamDeform":"FLT_MAX","beamStrength":"FLT_MAX"},
		["thrustL", "thrustR"],

		// Starter Sector
		["thrustRStart", "thrustR"],
		["thrustLStart", "thrustL"],
		["thrustRStart", "thrustLStart"],
		["thrustLStart", "thrustR"],
		["thrustRStart", "thrustL"],

        // To Body
		["thrustL", "f7tml"],
		["thrustL", "f7tmr"],
		["thrustL", "f6tml"],
		["thrustL", "f6tmr"],
		["thrustR", "f7tml"],
		["thrustR", "f7tmr"],
		["thrustR", "f6tml"],
		["thrustR", "f6tmr"],

		["thrustLStart", "f6tml"],
		["thrustLStart", "f6tmr"],
		["thrustLStart", "f7tml"],
		["thrustLStart", "f7tmr"],
		["thrustRStart", "f6tml"],
		["thrustRStart", "f6tmr"],
		["thrustRStart", "f7tml"],
		["thrustRStart", "f7tmr"],

        // rigidify (to water float)
        ["thrustL", "br4l"],
        ["thrustL", "br4r"],
        ["thrustL", "wf4l"],
        ["thrustL", "wf4r"],
		["thrustR", "br4l"],
		["thrustR", "br4r"],
        ["thrustR", "wf4l"],
        ["thrustR", "wf4r"],
	],
	"thrusters": [
		["id1:", "id2:"],
		{"factor": "$thrusterpower"},
		{"thrustLimit": 15000},
		
		["thrustLStart","thrustL",{"control": "throttle"}],
		["thrustRStart","thrustR",{"control": "throttle"}],
		
		//reverse thrusters
		{"factor": "$=$thrusterpower*0.5"},
		{"thrustLimit": 10000},
		["thrustL","thrustLStart", {"control": "brake"}],
		["thrustR","thrustRStart", {"control": "brake"}],
	
		{"factor": "$=$thrusterpower*0.8"},
		{"thrustLimit": 5000},
		["thrustL","thrustR", {"control": "steering_input"}],
		["thrustLStart","thrustRStart", {"control": "steering_input"}],
	],

}

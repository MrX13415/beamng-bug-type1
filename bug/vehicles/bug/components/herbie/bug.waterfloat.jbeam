        // Unfortunatly in this case there is always a slight spin to the left. (Oct. 2023)

        {"triangleType":"NONCOLLIDABLE"},
        {"pressureGroup":"waterfloat"},
        {"dragCoef":30},
        {"pressurePSI":0.2},

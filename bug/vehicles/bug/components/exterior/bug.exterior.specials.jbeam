{

"bug_beaconlight_blue": {
    "information":{
        "authors":"BeamNG",
        "name":"Blue Beacon Light",
        "value":150,
    },
    "slotType" : "bug_roof_accessory",
    "slots": [
        ["type", "default", "description"],
        ["soundscape_siren","soundscape_siren_25", "Siren Audio"],
    ],
    "electricPower":[
        ["power"],
        [40, {"trigger": "electrics.values.lightbar > 0"}],
        [100, {"trigger": "electrics.values.lightbar > 1"}],
    ],
    "soundscape": [
        ["name", "src"],
        //affects siren location because siren soundscape part is loaded after
        {"node:":"fx2"},
    ],
    "glowMap":{
        "old_beacon_reflector":         {"simpleFunction":"power__lightbar", "off":"policeparts_lights_blue", "on":"policeparts_lights_blue_on", "materialEmissiveScaling":{"on_max":0.49}},
        "old_beacon_glass":             {"simpleFunction":"power__lightbar", "off":"policeparts_glass_blue", "on":"policeparts_glass_blue", "materialEmissiveScaling":{"on_max":0.49}},
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
       // ["old_beacon", ["old_beaconlight"], [], {"pos":{"x":0, "y":0.04, "z":1.44}, "rot":{"x":1, "y":0, "z":0}}],
        ["old_beacon", ["old_beaconlight"], [], {"pos":{"x":0, "y":0.1, "z":1.49}, "rot":{"x":3.3, "y":0, "z":0}}],
        {"deformGroup":"old_beaconlight_break", "deformMaterialBase":"policeparts_glass_blue","deformMaterialDamaged":"policeparts_glass_blue_dmg"},
        ["old_beacon_glass", ["old_beaconlight"], [], {"pos":{"x":0, "y":0.1, "z":1.49}, "rot":{"x":3.3, "y":0, "z":0}}],
        {"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamaged":""},
    ],
    "controller": [
        ["fileName"],
        ["beaconSpin"],
        ["lightbar", {
            "defaultModeIndex": 1,
            "modes": [
                ["name", "config"],
                ["Chase", [
                    ["electric", "value", "duration"],
                        ["blue_1", 1, 0.15],
                        ["blue_1", 0, 0.10],
                        ["blue_1", 1, 0.15],
                        ["blue_1", 0, 0.60],
                        ["blue_2", 0, 0.50],
                        ["blue_2", 1, 0.15],
                        ["blue_2", 0, 0.10],
                        ["blue_2", 1, 0.15],
                        ["blue_2", 0, 0.10],
                    ],
                ],
            ],
        }],
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        ["beaconSpin","old_beacon_reflector", "bl1r","bl1l","bl2r",  {"x":90, "y":0, "z":0} , {"x":0, "y":0, "z":1}    , {"x":0.0, "y":0, "z":0}, -360, 360, 0, 1,{"baseTranslation":{"x":0.0865, "y":0.08, "z":-0.042},"deformGroup":"old_beaconlight_break"}],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":70,
            "lightBrightness":0.6,
            "lightRange":15,
            "lightColor":{"r":10, "g":10, "b":255, "a":555},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
            "texSize":512,
            "shadowSoftness":1,
            "flareName":"vehicleHeadLightFlare",
            "flareScale":0.1,
        },
        ["beaconSpin" ,      "POINTLIGHT"        , "bl1r","bl1l","bl2r", {"x":85, "y":0, "z":0} , {"x":0, "y":0, "z":1}    , {"x":0, "y":0, "z":0}, -360, 360, 0, 1, {"baseTranslation":{"x":0.5, "y":0.5, "z":-0.068},"lightRange":0, "flareScale":0.05,"deformGroup":"old_beaconlight_break", "lightScaling":{}}],
        ["beaconSpin" ,      "SPOTLIGHT"        , "bl1r","bl1l","bl2r", {"x":265, "y":0, "z":0} , {"x":0, "y":0, "z":-1}    , {"x":0, "y":0, "z":0}, -360, 360, 0, 1, {"baseTranslation":{"x":0.5, "y":0.5, "z":-0.068},"deformGroup":"old_beaconlight_break", "lightScaling":{}}],
    ],
     "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":true},
        {"collision":true},
        {"nodeWeight":0.76},
        {"frictionCoef":0.7},
        {"group":"old_beaconlight"},
        {"nodeMaterial":"|NM_METAL"},
        ["bl1l",  0.070,  0.030, 1.510],
        ["bl2l",  0.070,  0.165, 1.518],
        ["bl3",   0.000,  0.095, 1.630],
        ["bl1r", -0.070,  0.030, 1.510],
        ["bl2r", -0.070,  0.165, 1.518],
    ],
    "beams": [
        ["id1:", "id2:"],
        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":450000,"beamDamp":30},
        {"beamDeform":10000,"beamStrength":"FLT_MAX"},
        //Main shape
        {"deformGroup":"old_beaconlight_break"},
        {"deformationTriggerRatio":0.01},
        ["bl1r","bl1l"],
        ["bl2r","bl2l"],
        ["bl1r","bl2r"],
        ["bl1l","bl2l"],

        ["bl1r","bl2l"],
        ["bl1l","bl2r"],

        ["bl1r","bl3"],
        ["bl2r","bl3"],
        ["bl1l","bl3"],
        ["bl2l","bl3"],

        //attach
        {"beamSpring":350000,"beamDamp":30},
        {"beamDeform":2500,"beamStrength":4000},
        {"breakGroup":"old_beaconlight_attach"},
        ["bl1l", "brf2l"],
        ["bl1l", "brf3l"],
        ["bl2l", "brf3l"],
        ["bl2l", "brf4l"],
        ["bl1r", "brf2r"],
        ["bl1r", "brf3r"],
        ["bl2r", "brf3r"],
        ["bl2r", "brf4r"],
        ["bl1l", "bi0"],
        ["bl2l", "bi0"],
        ["bl1r", "bi0"],
        ["bl2r", "bi0"],
        {"deformGroup":""},
        {"breakGroup":""},
        {"deformLimitExpansion":1.2},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
    "triangles": [
        ["id1:","id2:","id3:"],
        {"group":"old_beaconlight"},
        {"dragCoef":3},
        ["bl3","bl2r","bl1r"],
        ["bl3","bl2l","bl2r"],
        ["bl3","bl1l","bl2l"],
        ["bl3","bl1r","bl1l"],

        ["bl1r","bl2r","bl2l"],
        ["bl1r","bl2l","bl1l"],
    ],
},

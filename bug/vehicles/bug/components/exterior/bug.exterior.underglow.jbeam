{
"bug_underglow_white": {
    "information":{
        "authors":"BeamNG",
        "name":"White Neon Lights",
        "value":1000,
    },
    "slotType" : "bug_underglow",
    "electricPower":[
        ["power"],
        [30, {"trigger": "electrics.values.underglow"}]
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["bug_neon_cap_front", ["bug_body"], []],
        ["bug_neon_cap_rear", ["bug_body"], []],
        ["bug_neon_cap_right", ["bug_body"], []],
        ["bug_neon_cap_left", ["bug_body"], []],

        {"deformGroup":"underglow_F_break", "deformMaterialBase":"neon_tube_glow", "deformMaterialDamaged":"neon_tube_glow"},
        ["bug_neon_front", ["bug_body"], []],
        {"deformGroup":"underglow_R_break", "deformMaterialBase":"neon_tube_glow", "deformMaterialDamaged":"neon_tube_glow"},
        ["bug_neon_rear", ["bug_body"], []],
        {"deformGroup":"underglow_MR_break", "deformMaterialBase":"neon_tube_glow", "deformMaterialDamaged":"neon_tube_glow"},
        ["bug_neon_right", ["bug_body"], []],
        {"deformGroup":"underglow_ML_break", "deformMaterialBase":"neon_tube_glow", "deformMaterialDamaged":"neon_tube_glow"},
        ["bug_neon_left", ["bug_body"], []],
        {"deformGroup":""},
    ],
    "glowMap":{
            "neon_tube_glow":{"simpleFunction":{"power__underglow":1}, "off":"neon_tube_glow", "on":"neon_tube_glow_white", "on_intense":"neon_tube_glow_white", "materialEmissiveScaling":{"on_max":0.49}},
    },
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":179,
            "lightRange":2.0,
            "lightColor":{"r":255, "g":255, "b":255, "a":255},
            "lightAttenuation":{"x":0, "y":1, "z":1},
            "lightCastShadows":false,
            "flareName":"vehicleHeadLightFlare",
            "cookieName":"/art/special/BNG_light_cookie_underglow.dds",
            "texSize":512,
            "shadowSoftness":0.4,
        },
        //front
        ["power__underglow" ,         "SPOTLIGHT"        , "bf1", "bf1r", "bf2", {"x": 85, "y":177, "z":180}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x": 0.00, "y": 0.8, "z":-0.160},"lightRange":1.5,"flareScale":0.0,"lightBrightness":1.5,"deformGroup":"underglow_F_break", "lightScaling":{}}],
        //rear
        ["power__underglow" ,         "SPOTLIGHT"        , "br6", "br7r", "br7", {"x":116, "y": -7, "z":  6}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x": 0.50, "y":-0.6, "z":-0.160},"lightRange":1.5,"flareScale":0.0,"lightBrightness":0.8,"deformGroup":"underglow_R_break", "lightScaling":{}}],
        ["power__underglow" ,         "SPOTLIGHT"        , "br6", "br7r", "br7", {"x":116, "y":-17, "z": 10}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.50, "y": 0.1, "z":-0.238},"lightRange":1.5,"flareScale":0.0,"lightBrightness":0.8,"deformGroup":"underglow_R_break", "lightScaling":{}}],
        //middle
        ["power__underglow" ,         "SPOTLIGHT"        , "f4l", "f4ml", "f3l", {"x":  0, "y":-90, "z":-15}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.06, "y": 0.5, "z":-0.075},"lightRange":1.5,"flareScale":0.0,"lightBrightness":0.6,"deformGroup":"underglow_MR_break", "lightScaling":{}}],
        ["power__underglow" ,         "SPOTLIGHT"        , "f4l", "f4ml", "f3l", {"x":  0, "y":-90, "z":  0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.03, "y":-0.5, "z":-0.075},"lightRange":1.5,"flareScale":0.0,"lightBrightness":0.6,"deformGroup":"underglow_MR_break", "lightScaling":{}}],
        ["power__underglow" ,         "SPOTLIGHT"        , "f4l", "f4ml", "f3l", {"x":  0, "y":-90, "z": 15}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.00, "y":-1.5, "z":-0.075},"lightRange":1.5,"flareScale":0.0,"lightBrightness":0.6,"deformGroup":"underglow_MR_break", "lightScaling":{}}],
        ["power__underglow" ,         "SPOTLIGHT"        , "f4r", "f4mr", "f3r", {"x":180, "y": 90, "z":-15}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.06, "y": 0.5, "z": 0.075},"lightRange":1.5,"flareScale":0.0,"lightBrightness":0.6,"deformGroup":"underglow_ML_break", "lightScaling":{}}],
        ["power__underglow" ,         "SPOTLIGHT"        , "f4r", "f4mr", "f3r", {"x":180, "y": 90, "z":  0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.03, "y":-0.5, "z": 0.075},"lightRange":1.5,"flareScale":0.0,"lightBrightness":0.6,"deformGroup":"underglow_ML_break", "lightScaling":{}}],
        ["power__underglow" ,         "SPOTLIGHT"        , "f4r", "f4mr", "f3r", {"x":180, "y": 90, "z": 15}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.00, "y":-1.5, "z": 0.075},"lightRange":1.5,"flareScale":0.0,"lightBrightness":0.6,"deformGroup":"underglow_ML_break", "lightScaling":{}}],
     ],
    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        //brittle beams
        {"disableMeshBreaking":true,"disableTriangleBreaking":true},
        {"beamSpring":701000,"beamDamp":10},
        {"beamDeform":4500,"beamStrength":8500},
        {"deformLimitExpansion":""},
        {"deformGroup":"underglow_F_break", "deformationTriggerRatio":0.03},
        {"breakGroup":"underglow_F"},
        ["bf1ll", "bf1rr"],
        {"deformGroup":"underglow_R_break", "deformationTriggerRatio":0.03},
        {"breakGroup":"underglow_R"},
        ["br6l", "br6r"],
        {"deformGroup":"underglow_MR_break", "deformationTriggerRatio":0.03},
        {"breakGroup":"underglow_MR"},
        ["f3r", "f6r"],
        {"deformGroup":"underglow_ML_break", "deformationTriggerRatio":0.03},
        {"breakGroup":"underglow_ML"},
        ["f3l", "f6l"],
        {"breakGroup":""},
        {"disableMeshBreaking":false,"disableTriangleBreaking":false},
        {"deformGroup":""},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"deformLimitExpansion":1.1},
    ],
},

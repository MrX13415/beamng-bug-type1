        ["lightbarlights_filament"    , "SPOTLIGHT"        , "rbl_l1r", "rbl_l2r", "rbl_l4r", {"x":0, "y":0, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.05, "y":0.5, "z":0.033},"deformGroup":"rollbar_light_R_break", "lightScaling":{}}],

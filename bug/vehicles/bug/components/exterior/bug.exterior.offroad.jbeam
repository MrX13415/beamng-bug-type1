"bug_lightbar_quadround_halogen": {
    "information":{
        "authors":"BeamNG",
        "name":"Halogen Bulbs",
        "value":60,
    },
    "slotType" : "bug_lightbar_quadround_accessory",
    "electricPower":[
        ["power"],
        [180, {"trigger": "electrics.values.lightbarlights"}]
    ],
    "components": {
        "electrics": {
            "customValues": [
                ["electricsName", "electricsFunction","electricsDefault"],
                ["lightbarlights_filament","electrics.power__lightbarlights * electrics.electricalLoadCoef",0],
            ],
            "smoothers": [
                ["electricsName", "smootherType", "params"],
                ["lightbarlights_filament","temporalNonLinear", [10,10]],
            ],
        },
    },
    "glowMap":{
            "rollbarlights":      {"simpleFunction":"lightbarlights_filament", "off":"generic_halogen",       "on":"generic_halogen_on_intense",       "materialEmissiveScaling":{"on_max":1}},
            "rollbarlights_glass":{"simpleFunction":"lightbarlights_filament", "off":"generic_halogen_glass", "on":"generic_halogen_glass_on_intense", "materialEmissiveScaling":{"on_max":1}},
    },

{

"bug": {
    "information":{
        "authors":"BeamNG",
        "name":"Volkswagen Käfer (1963)",
    },
    "slotType" : "main",
    "slots": [
        ["type", "default", "description"],

        ["licenseplate_design_2_1", "CA Old Black Plate (no tags)", "License Plate Design"],
        ["paint_design", "", "Paint Design"],

        ["bug_behavior", "bug_behavior", "Behavior"],
        ["soundscape", "soundscape_herbie_horn", "Soundscape"],

        ["bug_frame", "bug_frame", "Frame", {"coreSlot":true}],
        ["bug_mod", "", "Additional Modification"],
    ],
    "scaledragCoef":1.1,
    "controller": [
        ["fileName"],
        ["vehicleController", {}],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$brakestrength", "range", "", "Brakes", 1, 0.6, 1.0, "Brake Force Multiplier", "Scales the overall brake torque for this setup", {"minDis":60, "maxDis":100}],
        ["$ffbstrength", "range", "", "Chassis", 1, 0.5, 1.5, "Setup-Specific Force Feedback Multiplier", "Scales the force feedback strength for THIS SETUP ONLY", {"minDis":50, "maxDis":150}]
    ],
    "sounds": {
        "cabinFilterCoef": 0
    },
    "soundscape": [
        ["name", "src"],

        //indicator
        {"node:":"dsh"},
        ["indicatorStart", "event:>Vehicle>Interior>Indicator>FIPA_On"],
        ["indicatorStop", "event:>Vehicle>Interior>Indicator>FIPA_Off"],
        ["indLoop1", "event:>Vehicle>Interior>Indicator>FIPA_Click"],
        ["indLoop2", "event:>Vehicle>Interior>Indicator>FIPA_Clack"],

        //lights3
        ["LightOn", "event:>Vehicle>Interior>Light>FIPA_On"],
        ["LightOff", "event:>Vehicle>Interior>Light>FIPA_Off"],

        //handbrake
        {"node:":"f4tm"},
        ["handbrakeEngaging","event:>Vehicle>Interior>Handbrake_Ratchet>Ratchet_04_Ratchet"],
        ["handbrakeDisengaging","event:>Vehicle>Interior>Handbrake_Ratchet>Ratchet_04_Button"],
        ["handbrakeDisengaged","event:>Vehicle>Interior>Handbrake_Ratchet>Ratchet_04_Thump"],

        // gearshift
        {"node:":"dsh2"},
        ["gear","event:>Vehicle>Interior>Gearshift>AU3"],

        //affects horn location because horn soundscape is loaded after
        {"node:":"bf2l"}, // TODO?
    ],
    "components": {
        "electrics": {
            "customValues": [
                ["electricsName", "electricsFunction"],
                // Ext. Lights
                ["power__lowbeam"               , "electrics.lowbeam                   * electrics.electricalLoadCoef * electrics.powerOnRatio"],
                ["power__highbeam"              , "electrics.highbeam                  * electrics.electricalLoadCoef * electrics.powerOnRatio"],
                ["power__lowhighbeam"           , "electrics.lowhighbeam               * electrics.electricalLoadCoef * electrics.powerOnRatio"],
                ["power__brake"                 , "electrics.brake                     * electrics.powerOn"],

                ["power__signal_L"              , "electrics.signal_L                  * electrics.electricalLoadCoef * electrics.powerOnRatio"],
                ["power__signal_R"              , "electrics.signal_R                  * electrics.electricalLoadCoef * electrics.powerOnRatio"],
                // unused ["power__lowhighbeam_signal_L"  , "electrics.lowhighbeam_signal_L      * electrics.electricalLoadCoef * electrics.powerOnRatio"],
                // unused ["power__lowhighbeam_signal_R"  , "electrics.lowhighbeam_signal_R      * electrics.electricalLoadCoef * electrics.powerOnRatio"],
                ["power__usdm_signal_L"         , "min(electrics.power__signal_L+electrics.power__lowhighbeam*0.49,1)"],
                ["power__usdm_signal_R"         , "min(electrics.power__signal_R+electrics.power__lowhighbeam*0.49,1)"],

                ["power__underglow"             , "(electrics.underglow or 0)          * electrics.electricalLoadCoef * electrics.powerOnRatio"],
                ["power__lightbar"              , "electrics.lightbar                  * electrics.electricalLoadCoef * electrics.powerOn"],

                // Interior
                ["power__gauges"                , "electrics.lowhighbeam               * electrics.electricalLoadCoef * electrics.powerOn"],
                ["power__oilpressure_low"       , "electrics.oilpressure_low           * electrics.powerOn"],
                ["power__oil"                   , "electrics.oil                       * electrics.powerOn"],
                ["power__regeneration"          , "electrics.regeneration              * electrics.powerOn"],
                ["power__generatorPower_low"    , "electrics.generatorPower_low        * electrics.powerOn"],
                ["power__checkengine"           , "(electrics.checkengine and 1 or 0)  * electrics.powerOn"],
                ["power__radio_state"           , "electrics.radio_state               * electrics.powerOn"],
                ["power__hazard"                , "electrics.hazard                    * electrics.powerOn"],
                ["power__signal_dash"           , "(electrics.signal_R*0.49 + electrics.signal_L*0.49) * electrics.powerOn"],
                
                ["power__interiorlight"         , "electrics.interiorlight             * electrics.powerRatio"],

            ],
            "smoothers": [
                // smoothers: exponential, temporal, temporalNonLinear

                ["electricsName", "smootherType", "params"],
                
                ["power__lowbeam","temporalNonLinear", [10,10]],
                ["power__highbeam","temporalNonLinear", [10,10]],
                ["power__lowhighbeam","temporalNonLinear", [10,10]],
                ["power__brake","temporalNonLinear", [10,10]],

                ["power__signal_L","temporalNonLinear", [10,10]],
                ["power__signal_R","temporalNonLinear", [10,10]],
                ["power__lowhighbeam_signal_L","temporalNonLinear", [10,10]],
                ["power__lowhighbeam_signal_R","temporalNonLinear", [10,10]],

                ["power__underglow","temporalNonLinear", [15,15]],
                // Not working with props ["power__lightbar","temporalNonLinear", [5,5]],

                ["power__signal_dash","temporal", [15,15]],
                ["power__oilpressure_low","temporal", [5,5]],
                ["power__oilpressure_low","temporal", [5,5]],
                ["power__oil","temporal", [5,5]],
                ["power__regeneration","temporal", [5,5]],
                ["power__generatorPower_low","temporal", [5,5]],
                ["power__checkengine","temporal", [5,5]],
                ["power__radio_state","temporal", [5,5]],
                // Not working with props ["power__hazard","temporalNonLinear", [5,5]],

                ["power__interiorlight","temporalNonLinear", [15,15]],
            ]
        }
    }
}

}

// this file holds all the actions that only this specific vehicle can perform
// ===========================================================================
// the non self-descriptive fields are:
// "onChange":   code to run when the controller position changes     (applies to: buttons, keys, pov hat, axes)
// "onDown":     code to run when the controller becomes pressed down (applies to: buttons, keys, pov hat)
// "onDown":       code to run when the controller is lifted up         (applies to: buttons, keys, pov hat)
// "onRelative": code to run when the controller position changes     (applies to: mouse axis when holding right mouse button)
// "ctx" (defaults to 'vlua'): where the code above ^ must be run. it can be:
//    - vlua for vehicle lua async
//    - elua for engine  lua async
//    - tlua for engine  lua  sync
//    - ui for javascript    async
//    - ts for torquescript   sync
// "isBasic" (defaults to true): whether the binding must show always (true), or only when 'advanced bindings' checkbox is marked (false)
// "isCentered" (defaults to false): whether the axis values will be reported from -1 to +1 (true) or from 0 to +1 (false)
// "order":      helps set the display order in the Controls menu
{
    // interior
    "wiperstoggle":        {"order":21, "onDown":"vehicle.toggleWipers()", "title":"Toggle Windshield Wipers", "desc":"Toggles between the speed of the windshield wipers or switches them off."},
    "wipersdown":          {"order":22, "onDown":"vehicle.wipersDown()", "title":"Decrease Windshield Wipers", "desc":"Decreases the speed of the windshield wipers or turns them off."},
    "wipersup":            {"order":23, "onDown":"vehicle.wipersUp()", "title":"Increase Windshield Wipers", "desc":"Increase the speed of the windshield wipers or switches them on."},

    // sunvisor
    "sunvisorLtoggle":     {"order":24, "onDown":"vehicle.toggle('sunvisorL')", "title":"Left Sunvisor", "desc":"Lowers the left sunvisor."},
    "sunvisorRtoggle":     {"order":25, "onDown":"vehicle.toggle('sunvisorR')", "title":"Right Sunvisor", "desc":"Lowers the right sunvisor."},
    "interiorlighttoggle": {"order":26, "onDown":"vehicle.toggleInteriorLight()", "title":"Interior Light", "desc":"Toggles the interior light between always on and open door only."},   

    // windows
    "windowFLopen":        {"order":31, "onChange":"controller.getControllerSafe('windowFL').open(VALUE)", "title":"Window Left Open", "desc":"Opens the front left window."},
    "windowFLclose":       {"order":32, "onChange":"controller.getControllerSafe('windowFL').close(VALUE)", "title":"Window Left Close", "desc":"Closes the front left window."},
    "windowFRopen":        {"order":33, "onChange":"controller.getControllerSafe('windowFR').open(VALUE)", "title":"Window Right Open", "desc":"Opens the front right window."},
    "windowFRclose":       {"order":34, "onChange":"controller.getControllerSafe('windowFR').close(VALUE)", "title":"Window Right Close", "desc":"Closes the front right window."},
    "doorventFLopen":      {"order":35, "onChange":"controller.getControllerSafe('doorventFL').open(VALUE)", "title":"Vent Window Left Open", "desc":"Opens the front left vent window."},
    "doorventFLclose":     {"order":36, "onChange":"controller.getControllerSafe('doorventFL').close(VALUE)", "title":"Vent Window Left Close", "desc":"Closes the front left vent window."},
    "doorventFRopen":      {"order":37, "onChange":"controller.getControllerSafe('doorventFR').open(VALUE)", "title":"Vent Window Right Open", "desc":"Opens the front right vent window."},
    "doorventFRclose":     {"order":38, "onChange":"controller.getControllerSafe('doorventFR').close(VALUE)", "title":"Vent Window Right Close", "desc":"Closes the front right vent window."},

    // ragtop
    "ragtopopen":          {"order":41, "onChange":"controller.getControllerSafe('ragtop').open(VALUE)", "title":"Racktop Open", "desc":"Opens the racktop."},
    "ragtopclose":         {"order":42, "onChange":"controller.getControllerSafe('ragtop').close(VALUE)", "title":"Racktop Close", "desc":"Closes the racktop."},

    // Misc:
    "doorLtoggle":          {"order":71, "onDown":"controller.getControllerSafe('doorLCoupler').toggleGroup()", "title":"Left Door Open/Close ", "desc":"Opens the left door."},
    "doorRtoggle":          {"order":72, "onDown":"controller.getControllerSafe('doorRCoupler').toggleGroup()", "title":"Right Door Open/Close ", "desc":"Opens the right door."},
    "hoodtoggle":           {"order":73, "onDown":"controller.getControllerSafe('hoodCatchCoupler').toggleGroup(); controller.getControllerSafe('hoodLatchCoupler').toggleGroup()", "title":"Hood Open/Close", "desc":"Opens the hood."},
    "trunktoggle":          {"order":74, "onDown":"controller.getControllerSafe('trunkCoupler').toggleGroup()", "title":"Trunk Open/Close", "desc":"Opens the trunk."},

    "ashtraytoggle":        {"order":76, "onDown":"vehicle.toggleAshTray()", "title":"Ashtray Open/Close", "desc":"Opens the ashtray."},
    "gloveboxtoggle":       {"order":77, "onDown":"controller.getControllerSafe('gloveboxCoupler').toggleGroup()", "title":"Glovebox Open/Close", "desc":"Opens the glovebox."}
}
